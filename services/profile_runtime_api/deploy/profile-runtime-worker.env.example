# Dedicated queue-worker DB access. Keep mode 0600 on VPS.
LF_SUPABASE_DB_PASSWORD=
SUPABASE_PROJECT_ID=mhwmirqcgxxukpctffuv
SUPABASE_POOLER_HOST=aws-1-us-east-1.pooler.supabase.com
PROFILE_RUNTIME_WORKER_API_BASE=http://127.0.0.1:8090
PROFILE_RUNTIME_WORKER_HTTP_TIMEOUT=30
# Keep the worker ceiling aligned with the existing 900s inference ceiling; optimize context instead of extending waits.
PROFILE_RUNTIME_WORKER_JOB_TIMEOUT_SECONDS=900
PROFILE_RUNTIME_WORKER_POLL_SECONDS=2
# Automatic Profile -> Input Governance CONTEXT_PACK continuation.
# Defaults derive the caller URL from SUPABASE_PROJECT_ID; override only for governed environments.
LF_PROFILE_IG_CALLER_URL=
PROFILE_RUNTIME_IG_HTTP_TIMEOUT=150
PROFILE_RUNTIME_IG_MAX_CONTINUATIONS=10
