# Install as /etc/lf-profile-runtime-api.env with mode 0600.
PROFILE_RUNTIME_API_TOKEN=replace-with-at-least-32-random-bytes
PROFILE_RUNTIME_API_HOST=127.0.0.1
PROFILE_RUNTIME_API_PORT=8090
PROFILE_RUNTIME_LLAMA_BASE_URL=http://127.0.0.1:8080
PROFILE_RUNTIME_LLAMA_MODEL=Qwen2.5-VL-3B-Instruct-Q4_K_M.gguf
PROFILE_RUNTIME_REPO_ROOT=/opt/lf-profile-runtime-api/current
PROFILE_RUNTIME_STATE_DIR=/var/lib/lf-profile-runtime-api
PROFILE_RUNTIME_SOURCE_SHA=replace-with-deployed-git-sha
PROFILE_RUNTIME_VERSION=hetzner-profile-runtime-api/0.1.0-candidate
PROFILE_RUNTIME_RESOLVER_VERSION=structural-context-resolver/v3
PROFILE_RUNTIME_MAX_WORKERS=1
PROFILE_RUNTIME_MAX_BATCH_SIZE=8
PROFILE_RUNTIME_MAX_REQUEST_BYTES=20971520
PROFILE_RUNTIME_MAX_PROMPT_CHARS=120000
PROFILE_RUNTIME_MAX_OUTPUT_TOKENS=2048
PROFILE_RUNTIME_LLAMA_TIMEOUT_SECONDS=900
PROFILE_RUNTIME_LLAMA_HEALTH_TIMEOUT_SECONDS=3
PROFILE_RUNTIME_CACHE_MAX_ENTRIES=64
PROFILE_RUNTIME_ENABLE_TARGETED_REREAD=true
# Keep false on the 3.7 GiB CPU VPS: full-image Qwen previously OOMed at p=1.
PROFILE_RUNTIME_ALLOW_MODEL_IMAGE=false
PROFILE_RUNTIME_ALLOW_NO_AUTH=false
