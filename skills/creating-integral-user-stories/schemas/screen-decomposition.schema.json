{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "lf/creating-integral-user-stories/screen-decomposition.schema.json",
  "title": "Screen Decomposition",
  "type": "object",
  "additionalProperties": false,
  "required": ["screen_code","source_version","source_snapshot_sha","main_responsibility","context_inventory","permission_inventory","transition_inventory","functional_units","coverage_matrix"],
  "properties": {
    "screen_code": {"type": "string"},
    "module_code": {"type": "string"},
    "source_version": {"type": "string"},
    "source_snapshot_sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "main_responsibility": {"type": "string", "minLength": 15},
    "context_inventory": {"type": "array", "items": {"type": "string"}},
    "permission_inventory": {"type": "array", "items": {"type": "string"}},
    "transition_inventory": {"type": "array", "items": {"type": "string"}},
    "functional_units": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["functional_unit_code","actor","goal","observable_output","decision","justification","source_ref"],
        "properties": {
          "functional_unit_code": {"type": "string"},
          "actor": {"type": "string"},
          "goal": {"type": "string"},
          "observable_output": {"type": "string"},
          "decision": {"enum": ["CREATE_STORY","MERGE_WITH","CROSS_CUTTING","OUT_OF_SCOPE","PENDING_DECISION","DUPLICATE","RELATED_SCREEN"]},
          "merge_target": {"type": "string"},
          "justification": {"type": "string", "minLength": 10},
          "source_ref": {"type": "string"},
          "classification": {"enum": ["CONFIRMED","INFERRED","PROPOSED","BLOCKED"]}
        }
      }
    },
    "coverage_matrix": {
      "type": "object",
      "required": ["context_mapped_count","permission_mapped_count","transition_mapped_count","unmapped_count","unjustified_count","conflicting_count"],
      "properties": {
        "context_mapped_count": {"type": "integer"},
        "permission_mapped_count": {"type": "integer"},
        "transition_mapped_count": {"type": "integer"},
        "unmapped_count": {"type": "integer", "maximum": 0},
        "unjustified_count": {"type": "integer", "maximum": 0},
        "conflicting_count": {"type": "integer", "maximum": 0}
      }
    }
  }
}
