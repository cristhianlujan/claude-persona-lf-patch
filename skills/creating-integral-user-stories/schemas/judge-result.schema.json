{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "lf/creating-integral-user-stories/judge-result.schema.json",
  "title": "Judge Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["judge_code","result","compliance_bit","failed_assertions","evidence_refs","repair_instructions"],
  "properties": {
    "judge_code": {"type": "string", "pattern": "^J[0-9]{2}_[A-Z_]+$"},
    "result": {"enum": ["PASS_WITH_EVIDENCE","RETURN_TO_WORKER","BLOCKED","FAIL"]},
    "compliance_bit": {"type": "integer", "enum": [0,1]},
    "failed_assertions": {"type": "array", "items": {"type": "string"}},
    "evidence_refs": {"type": ["array","object"]},
    "repair_instructions": {"type": "array", "items": {"type": "string"}},
    "retry_count": {"type": "integer", "maximum": 2},
    "judged_at": {"type": "string"}
  },
  "allOf": [
    {"if": {"properties": {"result": {"const": "PASS_WITH_EVIDENCE"}}},
     "then": {"properties": {"compliance_bit": {"const": 1}, "failed_assertions": {"maxItems": 0}}}},
    {"if": {"properties": {"result": {"enum": ["RETURN_TO_WORKER","BLOCKED","FAIL"]}}},
     "then": {"properties": {"compliance_bit": {"const": 0}}}}
  ]
}
