{"$schema":"http://json-schema.org/draft-07/schema#","$id":"lf/creating-integral-user-stories/judge-result.schema.json","title":"Judge Result v0.4","type":"object","additionalProperties":false,"required":["judge_code","judge_version","executor_identity","command","started_at","completed_at","exit_code","result","compliance_bit","assertions_total","assertions_passed","failed_assertions","blocking_assertions","repairs","repair_instructions","evidence_refs","evidence","evidence_sha256","input_sha256","output_sha256","retry_count"],"properties":{"judge_code":{"type":"string","minLength":3,"pattern":"^J[0-9]{2}_[A-Z0-9_]+$"},"judge_version":{"type":"string","minLength":3},"executor_identity":{"type":"string","minLength":3},"command":{"type":"string","minLength":5},"started_at":{"type":"string","format":"date-time"},"completed_at":{"type":"string","format":"date-time"},"exit_code":{"type":"integer","enum":[0,1,2]},"result":{"type":"string","enum":["PASS_WITH_EVIDENCE","RETURN_TO_WORKER","BLOCKED","FAIL"]},"compliance_bit":{"type":"integer","enum":[0,1]},"assertions_total":{"type":"integer","minimum":1},"assertions_passed":{"type":"integer","minimum":0},"failed_assertions":{"type":"array","items":{"type":"string","minLength":3},"uniqueItems":true},"blocking_assertions":{"type":"array","items":{"type":"string","minLength":3},"uniqueItems":true},"repairs":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["assertion_id","target_path","instruction","prohibited_shortcuts"],"properties":{"assertion_id":{"type":"string","minLength":3},"target_path":{"type":"string","minLength":1},"instruction":{"type":"string","minLength":5},"prohibited_shortcuts":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":3}}}}},"repair_instructions":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["assertion_id","target_path","instruction","prohibited_shortcuts"],"properties":{"assertion_id":{"type":"strin