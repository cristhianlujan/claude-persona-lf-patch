{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "lf/creating-integral-user-stories/story-pack.schema.json",
  "title": "Story Pack",
  "type": "object",
  "required": ["identity","core","interaction","fields","validations","observations","errors","security_privacy","states","audit","tokens_messages","analytics","observability","responsive_accessibility","tests","dependencies_risks","judges_evidence"],
  "properties": {
    "identity": {
      "type": "object",
      "required": ["story_code","title","module_code","screen_code","functional_unit_code","source_decision_id","source_version","status","priority"],
      "properties": {
        "story_code": {"type": "string"},
        "title": {"type": "string", "minLength": 8},
        "epic_code": {"type": "string"},
        "module_code": {"type": "string"},
        "screen_code": {"type": "string"},
        "functional_unit_code": {"type": "string"},
        "source_decision_id": {"type": "string"},
        "source_version": {"type": "string"},
        "status": {"enum": ["CANDIDATO_READ_ONLY","PENDING_DECISION","BLOCKED"]},
        "priority": {"enum": ["P0","P1","P2","P3"]}
      }
    },
    "core": {
      "type": "object",
      "required": ["actor","need","benefit","preconditions","trigger","main_flow","alternative_flows","postconditions","acceptance_criteria","out_of_scope"],
      "properties": {
        "actor": {"type": "string"},
        "need": {"type": "string"},
        "benefit": {"type": "string"},
        "preconditions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "trigger": {"type": "string"},
        "main_flow": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "alternative_flows": {"type": "array", "items": {"type": "string"}},
        "postconditions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "out_of_scope": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "acceptance_criteria": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "required": ["criterion_code","given","when","then"],
            "properties": {
              "criterion_code": {"type": "string"},
              "given": {"type": "string"},
              "when": {"type": "string"},
              "then": {"type": "string"},
              "source_ref": {"type": "string"}
            }
          }
        }
      }
    },
    "screen_fields": {"type": "array", "items": {"type": "string"}},
    "interaction": {"type": "object"},
    "fields": {"type": "array", "items": {"$ref": "#/definitions/field_contract"}},
    "validations": {"type": "array", "items": {"type": "object"}},
    "observations": {"type": "array", "items": {"type": "object"}},
    "errors": {"type": "array", "items": {"type": "object"}},
    "security_privacy": {"type": "object"},
    "states": {"type": "object"},
    "audit": {"type": "object"},
    "tokens_messages": {"type": "object"},
    "analytics": {"type": "array", "items": {"type": "object"}},
    "observability": {"type": "object"},
    "responsive_accessibility": {"type": "object"},
    "tests": {"type": "array", "items": {"type": "object"}},
    "dependencies_risks": {"type": "object"},
    "judges_evidence": {"type": "array", "items": {"type": "object"}}
  },
  "definitions": {
    "field_contract": {
      "type": "object",
      "required": ["field_code","data_type","required","editable","visibility_mode","pii_classification","audit_required"],
      "properties": {
        "field_code": {"type": "string"},
        "context_code": {"type": "string"},
        "entity_code": {"type": "string"},
        "source_type": {"type": "string"},
        "data_type": {"type": "string"},
        "required": {"type": "boolean"},
        "editable": {"type": "boolean"},
        "editable_by": {"type": "array", "items": {"type": "string"}},
        "viewable_by": {"type": "array", "items": {"type": "string"}},
        "visibility_mode": {"enum": ["FULL","MASKED","HIDDEN","SUMMARY"]},
        "pii_classification": {"enum": ["NONE","PII_INDIRECT","PII_DIRECT","PII_SENSITIVE","PII_FINANCIAL"]},
        "masking_rule": {"type": "string"},
        "analytics_allowed": {"type": "boolean"},
        "logs_allowed": {"type": "boolean"},
        "export_allowed": {"type": "boolean"},
        "audit_required": {"type": "boolean"},
        "retention_class": {"type": "string"},
        "validation_codes": {"type": "array", "items": {"type": "string"}},
        "observation_codes": {"type": "array", "items": {"type": "string"}},
        "error_codes": {"type": "array", "items": {"type": "string"}},
        "message_codes": {"type": "array", "items": {"type": "string"}},
        "component_token": {"type": "string"},
        "format_token": {"type": "string"},
        "previous_value_strategy": {"enum": ["FULL","MASKED","HASH","OMITTED"]},
        "new_value_strategy": {"enum": ["FULL","MASKED","HASH","OMITTED"]},
        "hash_required": {"type": "boolean"},
        "change_reason_required": {"type": "boolean"}
      }
    }
  }
}
