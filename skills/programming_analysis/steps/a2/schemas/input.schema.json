{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A2 typed signal candidate, not an authority receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "business",
    "target_ref",
    "change_type",
    "target_granularity",
    "nested_parent_ref",
    "evidence_refs",
    "depth_signals"
  ],
  "properties": {
    "schema_version": {
      "const": "ANALYSIS_A2_TYPED_SIGNAL_CANDIDATE_V1"
    },
    "business": {
      "type": "string",
      "minLength": 2,
      "maxLength": 32,
      "description": "Business identity declared in A1, exact-match required; never inferred from target"
    },
    "target_ref": {
      "type": "string",
      "minLength": 1
    },
    "change_type": {
      "type": "string",
      "minLength": 1
    },
    "target_granularity": {
      "type": "string",
      "minLength": 1
    },
    "nested_parent_ref": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "depth_signals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "materiality_level",
        "scope_bounded",
        "authority_state",
        "reversibility_state",
        "currentness_decision",
        "material_contradiction",
        "known_cross_scope_impact",
        "unresolved_material_signal_count",
        "required_specialist_count"
      ],
      "properties": {
        "materiality_level": {
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH",
            "UNKNOWN"
          ]
        },
        "scope_bounded": {
          "enum": [
            "TRUE",
            "FALSE",
            "UNKNOWN"
          ]
        },
        "authority_state": {
          "enum": [
            "SUFFICIENT",
            "INSUFFICIENT",
            "UNKNOWN"
          ]
        },
        "reversibility_state": {
          "enum": [
            "DEMONSTRATED",
            "NOT_DEMONSTRATED",
            "UNKNOWN"
          ]
        },
        "currentness_decision": {
          "enum": [
            "CURRENT",
            "CURRENT_REBOUND",
            "STALE_AFFECTED",
            "UNKNOWN_FAIL_CLOSED",
            "UNRESOLVED"
          ]
        },
        "material_contradiction": {
          "type": "boolean"
        },
        "known_cross_scope_impact": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "const": "UNKNOWN"
            }
          ]
        },
        "unresolved_material_signal_count": {
          "type": "integer",
          "minimum": 0
        },
        "required_specialist_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
