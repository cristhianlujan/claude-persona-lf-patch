{
  "contract_version": "AUTONOMOUS_DISCOVERY_REPAIR_CONTRACT_V1",
  "status": "CANDIDATE_READ_ONLY",
  "authority": {
    "router": "ACT-0001",
    "operational_source": "SUPABASE",
    "subject_asset": "ACT-0046",
    "technical_pack": "skills/learning_engine",
    "automatic_impact": "BLOCKED"
  },
  "no_case_behavior": {
    "open_discovery_is_valid_input": true,
    "ask_human_only_if_material_blocker": true,
    "safe_reversible_selection_should_continue": true,
    "sequence": [
      "DISCOVERY_PLAN",
      "INVENTORY_QUICK_SCAN",
      "CANDIDATE_SHORTLIST",
      "PRIORITIZE",
      "RECOMMEND_AND_SELECT",
      "SELECTED_CASE_DETAIL_READ",
      "CASE_FREEZE"
    ],
    "selection_rule": "Prefer a justified, high-value case using observable metadata and causal relevance. Do not require the human to choose among safe read-only candidates when the Motor can rank and select one reversibly."
  },
  "data_access": {
    "progressive_disclosure_required": true,
    "inventory_before_full_detail": true,
    "shortlist_before_deep_hydration": true,
    "select_star_without_justification_forbidden": true,
    "unbounded_collection_read_without_justification_forbidden": true,
    "full_body_scan_before_shortlist_is_red_flag": true,
    "repeated_identical_query_is_red_flag": true,
    "large_json_when_paths_suffice_is_red_flag": true,
    "metrics_must_not_be_invented_when_unobservable": true,
    "required_tool_trace_fields": [
      "gate",
      "tool_name",
      "purpose",
      "source_object",
      "operation_kind",
      "query_or_request_digest",
      "exact_columns_or_fields",
      "filters",
      "limit_or_range",
      "rows_returned",
      "result_bytes_if_observed",
      "server_elapsed_ms_if_observed",
      "client_elapsed_ms_if_observed",
      "round_trip_index",
      "retry_count",
      "error_code_if_any",
      "cache_or_reuse",
      "read_scope",
      "output_digest"
    ],
    "read_scope_values": [
      "FOCAL",
      "BOUNDED",
      "BROAD",
      "SCHEMA_ONLY",
      "NON_DATA_TOOL"
    ]
  },
  "blind_evaluation": {
    "evaluator_must_not_construct_subject_search_signature": true,
    "search_signature_must_come_from_motor_output": true,
    "search_signature_must_be_frozen_before_retrieval": true,
    "oracle_terms_added_by_evaluator_invalidate_gate": true
  },
  "self_enrichment": {
    "required": true,
    "triggers": [
      "MOTOR_DETECTED_DEFICIENCY",
      "EVALUATOR_DETECTED_DEFICIENCY",
      "TOOL_ERROR",
      "FAIL",
      "BLOCKED",
      "ERROR",
      "PERFORMANCE_RED_FLAG"
    ],
    "sequence": [
      "DETECT",
      "NORMALIZE_SIGNATURE",
      "EKB_LOOKUP",
      "CLASSIFY_NEW_OR_RECURRENCE",
      "WRITE_WITH_GOVERNED_WRITER",
      "READBACK",
      "OWNER_ISOLATION"
    ],
    "writer_operation": "ESCRITURA_BASE_CONOCIMIENTO_LF",
    "writer": "public.lf_write_pipeline_ekb_v1",
    "no_repair_before_ekb_readback": true,
    "no_next_gate_before_ekb_readback": true,
    "deduplicate_existing_causal_error": true,
    "provenance_values": [
      "MOTOR_SELF",
      "EVALUATOR_FALLBACK",
      "TOOL_OBSERVED",
      "USER_OBSERVED"
    ],
    "false_self_enrichment_claim_forbidden": true
  },
  "repair_loop": {
    "mode": "FIX_BEFORE_NEXT_GATE",
    "required": true,
    "sequence": [
      "EKB_RECEIPT_CONFIRMED",
      "OWNER_ISOLATED",
      "TARGET_EVAL_BOUND",
      "CORRECT_UPDATE_OPERATION_ROUTED",
      "MINIMAL_CANDIDATE_FIX_IMPLEMENTED",
      "SOURCE_OR_HEAD_READBACK",
      "DETERMINISTIC_VALIDATION",
      "SAME_INPUT_GATE_REPLAY",
      "BEFORE_AFTER_VERIFIED",
      "CONTINUE"
    ],
    "skill_update_operation": "ACTUALIZACION_SKILL_LF",
    "gate_with_deficiency_cannot_complete_before_verified_fix": true,
    "same_input_replay_required": true,
    "merge_requires_separate_approval": true,
    "production_promotion_requires_separate_approval": true,
    "cross_asset_write_requires_explicit_scope_approval": true
  },
  "finish_guard": {
    "all_gates_evaluated": true,
    "all_discovered_deficiencies_persisted": true,
    "open_unimplemented_deficiencies_must_equal": 0,
    "open_unverified_fixes_must_equal": 0,
    "all_in_scope_fixes_require_same_input_replay": true,
    "tool_efficiency_scoreboard_required": true,
    "self_enrichment_scoreboard_required": true
  },
  "claim_ceiling": "This contract can be structurally validated in GitHub. Behavioral claims require the live governed pilot and actual tool/output receipts."
}
