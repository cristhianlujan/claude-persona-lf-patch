{
  "schema": "PROFILE_EXPERT_BEHAVIOR_BENCHMARK_V1",
  "benchmark_scope": "EXPERT_TASK_PERFORMANCE_E2E",
  "purpose": "Measure whether evolved profiles actually perform domain tasks better; structural/contract compliance is not a proxy for expertise.",
  "target_cases": 120,
  "sample_size_policy": {
    "planned_case_count_must_be_frozen_before_raw": true,
    "power_analysis_ref_required": true,
    "actual_cases_must_meet_or_exceed_planned": true,
    "holdout_plan_frozen_separately": true
  },
  "required_arms": {
    "A_ORIGINAL": "original profile exact source",
    "B_UPDATER_V01": "current updater output executed on task",
    "C_EVOLUTION_CURRENT": "current Profile Evolution candidate executed on task",
    "D_EVOLUTION_TARGET": "rearchitected Profile Evolution candidate executed on task"
  },
  "case_contract": {
    "required": [
      "case_id",
      "domain_family",
      "difficulty",
      "critical",
      "preservation_case",
      "adaptation_case",
      "transfer_case",
      "arms"
    ],
    "difficulty_range": [
      1,
      5
    ],
    "every_arm_requires": [
      "profile_revision",
      "execution_receipt_ref",
      "execution_receipt_sha256",
      "producer_execution_id",
      "evaluator_receipt_ref",
      "evaluator_verification_state",
      "evaluator_execution_id",
      "blind_arm",
      "score"
    ],
    "score_range": [
      0,
      1
    ],
    "evaluator_must_be_independent_from_producer": true,
    "output_execution_required": true,
    "contract_only_candidate_forbidden": true
  },
  "primary_metric": "DIFFICULTY_WEIGHTED_TASK_QUALITY",
  "admission_thresholds": {
    "relative_uplift_D_vs_A_min": 0.15,
    "paired_ci_lower_D_vs_A_gt": 0,
    "paired_ci_lower_D_vs_C_gt": 0,
    "holdout_ci_lower_D_vs_A_gt": 0,
    "holdout_ci_lower_D_vs_C_gt": 0,
    "critical_regressions_max": 0,
    "preservation_ratio_min": 0.98
  },
  "secondary_metrics": [
    "max_difficulty_solved",
    "robustness",
    "adaptation",
    "transfer",
    "preservation",
    "false_improvement_rate",
    "observed_cost",
    "observed_latency",
    "human_interventions",
    "conversational_context_acquisition",
    "clarification_utility",
    "unnecessary_clarifications",
    "premature_answer_rate"
  ],
  "resource_policy": {
    "cost_budget_pass_required": true,
    "observed_metrics_only": true,
    "token_status_may_be": "NOT_OBSERVED",
    "token_estimation_forbidden": true
  },
  "forbidden": [
    "SCORE_BASELINE_FROM_EXPECTED_CLASS",
    "SCORE_CANDIDATE_FROM_DOCUMENT_PRESENCE",
    "STRUCTURAL_COMPLIANCE_AS_EXPERTISE",
    "HOLDOUT_LABEL_AVAILABLE_TO_PRODUCER",
    "SAME_PRODUCER_AND_EVALUATOR",
    "POST_RAW_THRESHOLD_TUNING",
    "CONVERSATION_BENCHMARK_AS_STATIC_ANSWER_ONLY",
    "PRODUCER_JUDGES_OWN_CLARIFICATION_QUALITY"
  ],
  "independent_assurance_required_after_score": true,
  "cutover_eligible_only_after_independent_assurance": true,
  "conversational_subcampaign": {
    "mandatory_for_expertise_admission": true,
    "source": "skills/profile_creator/contracts/profile_conversational_context_policy_v1.json",
    "minimum_scenarios": 40,
    "included_in_target_cases_not_additive": true,
    "minimum_blind_holdout_scenarios": 20,
    "all_four_arms_required": true,
    "initial_user_request": "SHORT_NATURAL_LANGUAGE_UNPREPARED",
    "hidden_context": "LAZY_AUTHORIZED_SOURCES_AND_USER_REPLIES",
    "user_simulator": "RESPOND_ONLY_TO_QUESTIONS_OR_SCHEDULED_EVENTS",
    "staged_revelation": true,
    "source_acquisition_receipts_required": true,
    "sufficient_context_before_deep_claims": true,
    "forbidden": [
      "BIG_HANOFF_WITH_COMPLETE_ORACLE",
      "DISCLOSE_HIDDEN_FACTS_TO_PRODUCER",
      "REWARD_UNNECESSARY_QUESTIONS",
      "TREAT_UNVERIFIED_SOURCE_AS_PRIMARY_READBACK"
    ],
    "comparable_resources": "MATCHED_MODEL_TOOLS_EVIDENCE_ACCESS_AND_BUDGET",
    "mandatory_dialogue_measurements": [
      "task_outcome_independently_verified",
      "context_sufficiency_at_each_decision",
      "retrieval_before_avoidable_question",
      "decision_changing_question_utility",
      "unnecessary_or_repeated_questions",
      "premature_unsupported_conclusions",
      "adaptation_to_new_and_contradictory_information",
      "source_provenance_and_tool_correctness",
      "human_intervention_count",
      "observed_latency_and_cost"
    ],
    "acceptance": "MUST_PASS_SEPARATE_INTERACTIVE_TRANSCRIPT_VALIDATOR_AND_ORIGINAL_PE10E_C4_UPLIFT_GATES",
    "independent_semantic_review_required": true,
    "pre_execution_freeze_required": true
  }
}
