{
  "schema": "PROFILE_EVOLUTION_STATE_V1",
  "purpose": "Evidence-bound trajectory for governed profile evolution",
  "required": [
    "profile_code",
    "profile_slug",
    "baseline_revision",
    "from_maturity",
    "to_maturity",
    "evolution_mode",
    "gap_refs",
    "methods",
    "capabilities",
    "candidate_ref",
    "benchmark_ref",
    "assurance_ref",
    "admission_ref",
    "result",
    "remaining_gaps",
    "recorded_at"
  ],
  "maturity_states": [
    "UNDETERMINED",
    "GENERIC",
    "SPECIALIZED",
    "ADAPTIVE",
    "EXPERT",
    "EVIDENCE_OPTIMIZED"
  ],
  "result_states": [
    "ADMITTED",
    "REJECTED",
    "NO_CHANGE",
    "BLOCKED"
  ],
  "invariants": [
    "UNDETERMINED_IS_EVIDENCE_INSUFFICIENCY_NOT_LOW_MATURITY",
    "TO_MATURITY_MUST_BE_PROVEN_NOT_DECLARED",
    "NO_SELF_PROMOTION_FROM_REFLECTION",
    "BENCHMARK_AND_HOLDOUT_REQUIRED_FOR_UPWARD_MATURITY_TRANSITION",
    "FAILED_OR_REJECTED_ATTEMPTS_REMAIN_IN_TRAJECTORY",
    "RUNTIME_AND_PRODUCTION_STATE_ARE_SEPARATE"
  ],
  "append_only_trajectory": true
}
