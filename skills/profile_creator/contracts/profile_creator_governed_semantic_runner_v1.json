{
  "schema": "PROFILE_CREATOR_GOVERNED_SEMANTIC_RUNNER_CONTRACT_V1",
  "purpose": "Provide auditable Profile Creator semantic executions for Profile Evolution using a governed model execution surface; governance is evidence-bound and model/vendor agnostic.",
  "producer": "PROFILE_CREATOR",
  "execution_requirements": {
    "fresh_run_per_case": true,
    "exact_profile_snapshot_required": true,
    "exact_input_sha_required": true,
    "exact_producer_source_ref_required": true,
    "raw_output_freeze_required": true,
    "runtime_model_stamp_required": true,
    "no_cross_case_context_reuse": true,
    "no_profile_authority_write": true,
    "no_runtime_activation": true,
    "no_production_activation": true
  },
  "allowed_execution_surfaces": [
    "GOVERNED_GPT_EXECUTION",
    "GOVERNED_PROFILE_CREATOR_WORKER"
  ],
  "forbidden_execution_surfaces": [
    "DIRECT_LLAMA_SERVER",
    "SYNTHETIC_OUTPUT_GENERATOR",
    "REUSED_PRIOR_RAW",
    "UNBOUND_GENERIC_MODEL_CALL",
    "PROFILE_RUNTIME_AS_IMPLICIT_PROFILE_CREATOR"
  ],
  "required_receipt_fields": [
    "schema",
    "status",
    "execution_surface",
    "producer",
    "case_id",
    "run_id",
    "producer_source_ref",
    "producer_source_sha",
    "profile_snapshot_sha",
    "input_sha256",
    "raw_output_ref",
    "raw_output_sha256",
    "runtime_model_stamp",
    "fresh_context",
    "profile_source_write_executed",
    "runtime_activation",
    "production_activation",
    "executor_class",
    "governance_contract_ref"
  ],
  "ready_status": "READY",
  "fail_closed_status": "BLOCKED",
  "handoff": "RAW_OUTPUT -> PROFILE_CANDIDATE_MATERIALIZER -> FULL_BEHAVIOR_VALIDATION",
  "notes": [
    "Governed means bound to exact input, profile snapshot, producer source, runtime/model stamp and frozen raw output.",
    "A dedicated worker process is not required.",
    "The semantic executor may be GPT when the execution receipt satisfies this contract.",
    "Direct model-server invocation outside this contract remains forbidden.",
    "No profile source write, runtime activation, production promotion, admission or cutover is granted."
  ],
  "execution_model": {
    "semantic_executor_role": "PROFILE_CREATOR",
    "executor_implementation": "MODEL_AGNOSTIC",
    "current_supported_executor_class": "GPT",
    "dedicated_worker_process_required": false,
    "vendor_binding_required": false
  }
}
