{
  "contract_code": "PROFILE_OPERATION_BLOCKED_EVIDENCE_V1",
  "scope": ["CREACION_PERFIL_LF", "ACTUALIZACION_PERFIL_LF"],
  "architecture": {
    "new_table": false,
    "new_layer": false,
    "new_operation": false,
    "persistence": "lf_operation_execution_steps",
    "recorder": "lf_record_profile_operation_step_v1"
  },
  "identity_boundary": {
    "durable_only_after": ["execution_resolved", "canonical_step_resolved", "active_contract_resolved", "active_binding_resolved"],
    "pre_identity_failures_are_durable_step_evidence": false,
    "reason": "A row in lf_operation_execution_steps cannot truthfully identify a step before execution/step/binding identity is valid."
  },
  "durable_blocked_path": {
    "status": "binding.blocked_result_value",
    "required_payload_extensions": [
      "blocking_findings",
      "blocking_codes",
      "blocked_by_recorder",
      "blocked_reason_code",
      "attempt_history"
    ],
    "trigger_compatibility": "The existing trigger derives blocked_result_value when blocking_findings is non-empty. Required evidence keys must exist in the persisted payload; missing caller keys may be represented as null only in the blocked snapshot and may never satisfy a later clean retry.",
    "caller_status_is_authority": false
  },
  "retry_semantics": {
    "same_execution_step_row": true,
    "blocked_row_is_terminal": false,
    "retry_updates_existing_row": true,
    "previous_attempt_preserved_in_attempt_history": true,
    "clean_retry_requires_all_required_evidence_non_null": true,
    "clean_retry_rederives_status_through_trigger": true,
    "no_delete_of_blocked_history": true
  },
  "durable_block_codes": [
    "PRIOR_REQUIRED_STEP_NOT_CLEAN",
    "REQUIRED_EVIDENCE_MISSING",
    "BLOCKING_CODES_INVALID",
    "STEP_BLOCKED",
    "PROFILE_UPDATE_SERVER_TRUST_CONTEXT_NOT_MATERIALIZED"
  ],
  "non_durable_pre_identity_codes": [
    "STEP_IDENTITY_MISSING",
    "INIT_STEP_IMMUTABLE",
    "EVIDENCE_PAYLOAD_INVALID",
    "EXECUTION_IDENTITY_INVALID",
    "EXECUTION_NOT_IN_PROGRESS",
    "STEP_NOT_ACTIVE",
    "STEP_CONTRACT_MISSING",
    "STEP_JUDGE_BINDING_MISSING"
  ],
  "activation": {
    "source_contract_only": true,
    "recorder_source_implemented": true,
    "live_materialized": false,
    "update_write_enabled": false,
    "runtime_deployment_authorized": false,
    "merge_authorized": false
  },
  "required_tests": [
    "negative_missing_required_evidence_creates_blocked_snapshot_after_binding_resolution",
    "negative_server_trust_missing_creates_blocked_snapshot",
    "retry_preserves_first_blocked_attempt",
    "retry_with_same_invalid_evidence_remains_blocked",
    "retry_with_complete_clean_evidence_can_transition_only_if_trigger_derives_clean",
    "pre_identity_failure_does_not_fabricate_step_row",
    "no_new_table_or_parallel_recorder"
  ]
}
