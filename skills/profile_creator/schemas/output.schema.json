{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LF Profile Creator Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "profile_pack_id",
    "source_authority",
    "deliverable_created",
    "files_created",
    "evidence_map",
    "blocking_codes",
    "next_gate"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "PROFILE_PACK_CREATED",
        "RETURN_TO_ORCHESTRATOR",
        "RETURN_TO_WORKER_FOR_SELF_REPAIR",
        "BLOCK_PIPELINE"
      ]
    },
    "profile_pack_id": {"type": "string", "minLength": 1},
    "source_authority": {"type": "string", "minLength": 1},
    "deliverable_created": {"type": "boolean"},
    "deliverable_artifact_ref": {"type": "string", "minLength": 1},
    "files_created": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "evidence_map": {"type": "object"},
    "blocking_codes": {
      "type": "array",
      "items": {"type": "string"}
    },
    "next_gate": {"type": "string", "minLength": 1},
    "depth_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "validator_ref",
        "candidate_ref",
        "validation_scope",
        "semantic_quality_review",
        "behavioral_eval_status",
        "component_gates",
        "blocking_codes"
      ],
      "properties": {
        "status": {"const": "DEPTH_READY_FOR_SEMANTIC_REVIEW"},
        "validator_ref": {"const": "skills/profile_creator/validators/validate_candidate_readiness.py"},
        "candidate_ref": {"type": "string", "minLength": 1},
        "validation_scope": {"const": "DETERMINISTIC_READINESS_DEPTH_AND_CONSISTENCY"},
        "semantic_quality_review": {"const": "NOT_EXECUTED"},
        "behavioral_eval_status": {"const": "NOT_EXECUTED"},
        "component_gates": {
          "type": "object",
          "additionalProperties": false,
          "required": ["producer_depth", "cross_artifact_consistency"],
          "properties": {
            "producer_depth": {"const": "PASS"},
            "cross_artifact_consistency": {"const": "PASS"}
          }
        },
        "blocking_codes": {"type": "array", "maxItems": 0}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"status": {"const": "PROFILE_PACK_CREATED"}},
        "required": ["status"]
      },
      "then": {
        "required": ["deliverable_artifact_ref", "depth_gate"],
        "properties": {"deliverable_created": {"const": true}}
      }
    }
  ]
}
