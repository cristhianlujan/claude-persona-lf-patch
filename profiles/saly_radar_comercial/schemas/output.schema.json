{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "status",
    "project_code",
    "profile_code",
    "identity_verified",
    "production_authorized",
    "pack_type",
    "deliverable_created",
    "evidence_map",
    "blocking_codes",
    "next_gate"
  ],
  "properties": {
    "status": {
      "enum": [
        "VALID_OUTPUT",
        "RETURN_TO_WORKER_FOR_SELF_REPAIR",
        "BLOCK_PIPELINE"
      ]
    },
    "project_code": {
      "const": "SALY"
    },
    "profile_code": {
      "const": "PERFIL-RADAR-COMERCIAL-SALY"
    },
    "identity_verified": {
      "const": false
    },
    "production_authorized": {
      "const": false
    },
    "pack_type": {
      "const": "profile"
    },
    "deliverable_created": {
      "type": "object",
      "required": [
        "source_id",
        "scope_key",
        "source_version",
        "capture_sha256",
        "observed_count",
        "existing_count",
        "unmatched_count",
        "effect"
      ],
      "properties": {
        "source_id": {
          "const": "PE-PTE"
        },
        "scope_key": {
          "const": "LIMA_ICA"
        },
        "source_version": {
          "type": "string",
          "minLength": 1
        },
        "capture_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "observed_count": {
          "type": "integer",
          "minimum": 0
        },
        "existing_count": {
          "type": "integer",
          "minimum": 0
        },
        "unmatched_count": {
          "type": "integer",
          "minimum": 0
        },
        "effect": {
          "const": "READ_ONLY"
        }
      },
      "additionalProperties": false
    },
    "evidence_map": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "blocking_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "next_gate": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
