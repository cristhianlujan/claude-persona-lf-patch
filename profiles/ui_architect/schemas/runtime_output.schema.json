{
  "title": "UI Architect Runtime Output Boundary",
  "type": "object",
  "required": ["self_verdict"],
  "additionalProperties": false,
  "properties": {
    "self_verdict": {
      "type": "string",
      "enum": [
        "NEEDS_INPUT",
        "BLOCKED",
        "PASS_WITH_ASSUMPTIONS",
        "PASS_TO_QUALITY_PACK_CANDIDATE",
        "PASS_TO_QUALITY_PACK",
        "PASS",
        "NEEDS_ADJUSTMENT",
        "RETURN_TO_WORKER_FOR_SELF_REPAIR",
        "RETURN_TO_ORCHESTRATOR",
        "BLOCK_PIPELINE"
      ]
    },
    "blocked": {"type": "boolean"},
    "missing_inputs": {"type": "array", "maxItems": 12, "items": {"type": "string"}},
    "safe_assumptions_available": {"type": "boolean"},
    "assumptions": {"type": "array", "maxItems": 12, "items": {"type": "string"}},
    "question_to_orchestrator": {"type": "string"},
    "pipeline_action": {
      "type": "string",
      "enum": ["RETURN_TO_ORCHESTRATOR", "BLOCK_PIPELINE", "CONTINUE_WITH_ASSUMPTIONS"]
    },
    "worker": {"type": "string"},
    "output_type": {"type": "string", "enum": ["PRODUCTION_UI_SPEC"]},
    "deliverable_created": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "screen_definition": {
          "type": "object",
          "maxProperties": 24,
          "additionalProperties": {"type": "string"}
        },
        "component_tree": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "items": {
            "type": "object",
            "required": [
              "zone_id", "component_id", "component_type", "role", "content",
              "visual_priority", "color_tokens", "typography", "spacing", "state",
              "allowed_variants", "blocked_variants"
            ],
            "additionalProperties": false,
            "properties": {
              "zone_id": {"type": "string"},
              "component_id": {"type": "string"},
              "component_type": {"type": "string"},
              "role": {"type": "string"},
              "content": {"type": "string"},
              "visual_priority": {"type": "integer", "minimum": 0, "maximum": 99},
              "color_tokens": {"type": "array", "maxItems": 12, "items": {"type": "string"}},
              "typography": {"type": "string"},
              "spacing": {"type": "string"},
              "state": {"type": "string"},
              "allowed_variants": {"type": "array", "maxItems": 12, "items": {"type": "string"}},
              "blocked_variants": {"type": "array", "maxItems": 12, "items": {"type": "string"}}
            }
          }
        },
        "layout_grid": {
          "type": "object",
          "maxProperties": 24,
          "additionalProperties": {"type": "string"}
        },
        "visual_hierarchy": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "required": ["parent_id", "child_ids"],
            "additionalProperties": false,
            "properties": {
              "parent_id": {"type": "string"},
              "child_ids": {"type": "array", "maxItems": 24, "items": {"type": "string"}}
            }
          }
        },
        "state_map": {
          "type": "object",
          "maxProperties": 32,
          "additionalProperties": {"type": "string"}
        },
        "token_map": {
          "type": "object",
          "maxProperties": 32,
          "additionalProperties": {"type": "string"}
        },
        "spacing_typography": {
          "type": "object",
          "maxProperties": 32,
          "additionalProperties": {"type": "string"}
        },
        "density_rules": {"type": "array", "maxItems": 24, "items": {"type": "string"}},
        "risk_controls": {"type": "array", "maxItems": 24, "items": {"type": "string"}},
        "prompt_constraints": {"type": "array", "maxItems": 24, "items": {"type": "string"}},
        "remediation_actions": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "required": [
              "issue_id", "priority", "category", "evidence_component_ids", "evidence_anchor",
              "decision", "implementation_change", "acceptance_criteria", "execution", "acceptance_check"
            ],
            "additionalProperties": false,
            "properties": {
              "issue_id": {"type": "string"},
              "priority": {"type": "string", "enum": ["P0", "P1", "P2", "P3"]},
              "category": {"type": "string", "enum": ["LAYOUT", "HIERARCHY", "INTERACTION", "COPY", "RISK"]},
              "evidence_component_ids": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"type": "string"}},
              "evidence_anchor": {"type": "string"},
              "decision": {"type": "string"},
              "implementation_change": {"type": "string"},
              "acceptance_criteria": {"type": "string"},
              "execution": {
                "type": "object",
                "required": ["operation", "target_component_id", "property", "desired_value"],
                "additionalProperties": false,
                "properties": {
                  "operation": {
                    "type": "string",
                    "enum": ["REMOVE", "MOVE", "ALIGN", "REPLACE_COPY", "RESIZE", "REORDER", "SET_STATE", "SET_SPACING", "MERGE", "SPLIT", "HIDE", "SHOW", "CHANGE_TOKEN"]
                  },
                  "target_component_id": {"type": "string"},
                  "property": {"type": "string"},
                  "desired_value": {"type": "string"}
                }
              },
              "acceptance_check": {
                "type": "object",
                "required": ["check_type", "target_component_id", "expected"],
                "additionalProperties": false,
                "properties": {
                  "check_type": {
                    "type": "string",
                    "enum": ["ABSENT", "PRESENT", "ALIGNED", "STATE", "COPY_EQUALS", "COUNT_EQUALS", "SPACING", "ORDER", "TOKEN", "RELATIONSHIP"]
                  },
                  "target_component_id": {"type": "string"},
                  "expected": {"type": "string"}
                }
              },
              "semantic_authority": {
                "type": "object",
                "required": ["source_refs", "claim_scope"],
                "additionalProperties": false,
                "properties": {
                  "source_refs": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"type": "string"}},
                  "claim_scope": {"type": "string", "enum": ["INPUT_SUPPORTED", "CONSERVATIVE_REDUCTION", "PRESENTATION_ONLY"]}
                }
              }
            }
          }
        },
        "visual_output_requirements": {
          "type": "object",
          "maxProperties": 24,
          "additionalProperties": {"type": "string"}
        }
      }
    },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "layout_precision": {"type": "integer", "minimum": 0, "maximum": 5},
        "visual_hierarchy": {"type": "integer", "minimum": 0, "maximum": 5},
        "lf_system_fidelity": {"type": "integer", "minimum": 0, "maximum": 5},
        "state_mapping": {"type": "integer", "minimum": 0, "maximum": 5},
        "handoff_quality": {"type": "integer", "minimum": 0, "maximum": 5},
        "total": {"type": "integer", "minimum": 0, "maximum": 25},
        "evidence_by_criterion": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "layout_precision": {"type": "string"},
            "visual_hierarchy": {"type": "string"},
            "lf_system_fidelity": {"type": "string"},
            "state_mapping": {"type": "string"},
            "handoff_quality": {"type": "string"}
          }
        }
      }
    },
    "handoff_to_next": {
      "type": "object",
      "maxProperties": 24,
      "additionalProperties": {"type": "string"}
    }
  }
}
