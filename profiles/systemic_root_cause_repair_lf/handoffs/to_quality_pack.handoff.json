{
  "handoff_version": "v2",
  "from_profile": "PERFIL-SYSTEMIC-ROOT-CAUSE-REPAIR-LF",
  "to": "QUALITY_OR_ASSURANCE",
  "include": [
    "closure_proof",
    "authority_contradictions",
    "should_exist_assessment",
    "selected_alternative",
    "rejected_alternatives",
    "falsification_results",
    "origin_asset",
    "origin_operation",
    "owner",
    "invariant",
    "hard_guard",
    "acceptance_criteria",
    "historical_regressions",
    "residual_risks",
    "evidence_map",
    "blocking_codes",
    "next_gate",
    "case_mode",
    "live_authority_packet",
    "material_process_graph",
    "current_uncertainties"
  ],
  "required_quality_boundary": {
    "canonical_semantic_gate_required": true,
    "exact_revision_evidence_required": true,
    "structural_validation_is_behavioral_proof": false,
    "external_audit_required": false,
    "external_audit_missing_is_blocker": false,
    "material_external_finding_routes_through_governance": true,
    "v03_quality_receipt_required": true,
    "v03_quality_receipt_schema": "schemas/quality_receipt.schema.json",
    "v03_quality_receipt_validator": "validators/validate_quality_receipt.py",
    "v03_external_evidence_manifest_required": true,
    "v03_receipt_exact_bindings": [
      "candidate_revision",
      "candidate_digest",
      "evidence_bundle_id",
      "evidence_bundle_digest",
      "semantic_result_digest",
      "required_closed_open_proof_sets"
    ],
    "deterministic_floor_can_issue_quality_pass": false
  },
  "exclude": [
    "internal_chain_of_thought",
    "unbound_authority",
    "implementation_permission"
  ],
  "claim_ceiling": "ADVISORY_READ_ONLY"
}
