{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lf.local/contracts/srcr/evidence-manifest/v1",
  "title": "SRCR Evidence Manifest V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "bundle_id",
    "bundle_digest",
    "candidate_revision",
    "candidate_digest",
    "observed_at",
    "producer",
    "evidence"
  ],
  "properties": {
    "manifest_version": {
      "const": "SRCR_EVIDENCE_MANIFEST_V1"
    },
    "bundle_id": {
      "type": "string",
      "minLength": 3
    },
    "bundle_digest": {
      "type": "string",
      "minLength": 8
    },
    "candidate_revision": {
      "type": "string",
      "minLength": 3
    },
    "candidate_digest": {
      "type": "string",
      "minLength": 8
    },
    "observed_at": {
      "type": "string",
      "minLength": 8
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "resolver_ref"
      ],
      "properties": {
        "kind": {
          "enum": [
            "GOVERNED_RUNTIME",
            "SOURCE_FIRST_RESOLVER",
            "QUALITY_BOUNDARY",
            "TEST_FIXTURE"
          ]
        },
        "resolver_ref": {
          "type": "string",
          "minLength": 5
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "subject",
          "evidence_class",
          "source_locator",
          "revision_or_observed_at",
          "digest",
          "state"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 3
          },
          "subject": {
            "type": "string",
            "minLength": 2
          },
          "evidence_class": {
            "enum": [
              "OBSERVED_LIVE",
              "OBSERVED_HISTORY",
              "OBSERVED_TEST",
              "OBSERVED_READBACK",
              "GOVERNED_RECEIPT",
              "SOURCE_PROVENANCE"
            ]
          },
          "source_locator": {
            "type": "string",
            "minLength": 5
          },
          "revision_or_observed_at": {
            "type": "string",
            "minLength": 3
          },
          "digest": {
            "type": "string",
            "minLength": 8
          },
          "state": {
            "enum": [
              "CURRENT",
              "SUPERSEDED"
            ]
          }
        }
      }
    }
  }
}
