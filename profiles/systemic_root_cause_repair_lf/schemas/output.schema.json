{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement",
        "status",
        "evidence_refs",
        "missing_evidence"
      ],
      "properties": {
        "statement": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 8
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "OBSERVED",
            "ESTABLISHED",
            "HYPOTHESIS",
            "UNRESOLVED"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 5
          }
        },
        "missing_evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "OBSERVED",
                  "ESTABLISHED"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "statement": {
                "type": "string",
                "minLength": 8
              },
              "evidence_refs": {
                "minItems": 1
              },
              "missing_evidence": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "HYPOTHESIS"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "statement": {
                "type": "string",
                "minLength": 8
              },
              "missing_evidence": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "UNRESOLVED"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "missing_evidence": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "authority_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "code",
        "evidence_ref",
        "missing_evidence"
      ],
      "properties": {
        "status": {
          "enum": [
            "RESOLVED",
            "UNRESOLVED"
          ]
        },
        "code": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 2
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 5
            },
            {
              "type": "null"
            }
          ]
        },
        "missing_evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "RESOLVED"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "code": {
                "type": "string",
                "minLength": 2
              },
              "evidence_ref": {
                "type": "string",
                "minLength": 5
              },
              "missing_evidence": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "UNRESOLVED"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "missing_evidence": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  },
  "required": [
    "status",
    "profile_pack_id",
    "symptom",
    "immediate_cause",
    "systemic_root_cause",
    "causal_chain",
    "first_bad_control",
    "escape_control",
    "recurrence_evidence",
    "live_authority_packet",
    "execution_effect_reconciliation",
    "authority_contradictions",
    "repair_level",
    "should_exist_assessment",
    "alternatives",
    "preferred_alternative",
    "selected_alternative",
    "rejected_alternatives",
    "falsification_results",
    "origin_asset",
    "origin_operation",
    "owner",
    "invariant",
    "hard_guard",
    "acceptance_criteria",
    "historical_regressions",
    "planned_regressions",
    "current_uncertainties",
    "residual_risks",
    "evidence_map",
    "blocking_codes",
    "next_gate"
  ],
  "properties": {
    "status": {
      "enum": [
        "SYSTEMIC_REPAIR_SPEC",
        "NEEDS_MORE_EVIDENCE",
        "RETURN_TO_WORKER_FOR_SELF_REPAIR",
        "BLOCK_PIPELINE"
      ]
    },
    "profile_pack_id": {
      "const": "SYSTEMIC_ROOT_CAUSE_REPAIR_LF_V0_2"
    },
    "symptom": {
      "allOf": [
        {
          "$ref": "#/$defs/claim"
        },
        {
          "properties": {
            "status": {
              "const": "OBSERVED"
            }
          }
        }
      ]
    },
    "immediate_cause": {
      "$ref": "#/$defs/claim"
    },
    "systemic_root_cause": {
      "$ref": "#/$defs/claim"
    },
    "causal_chain": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "first_bad_control": {
      "$ref": "#/$defs/claim"
    },
    "escape_control": {
      "$ref": "#/$defs/claim"
    },
    "recurrence_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "fact",
          "evidence_class",
          "scope"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 5
          },
          "fact": {
            "type": "string",
            "minLength": 5
          },
          "evidence_class": {
            "enum": [
              "DECLARED_INPUT",
              "OBSERVED_HISTORY",
              "OBSERVED_LIVE"
            ]
          },
          "scope": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    },
    "live_authority_packet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "observed_at",
        "applicable_surfaces",
        "inspected_surfaces",
        "evidence_refs",
        "material_effects_observed",
        "unavailable_sources"
      ],
      "properties": {
        "status": {
          "enum": [
            "COMPLETE",
            "PARTIAL",
            "MISSING"
          ]
        },
        "observed_at": {
          "type": "string",
          "minLength": 3
        },
        "applicable_surfaces": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "inspected_surfaces": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 5
          }
        },
        "material_effects_observed": {
          "type": "boolean"
        },
        "unavailable_sources": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    },
    "execution_effect_reconciliation": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "effect",
          "observed_ref",
          "declared_producer",
          "declared_producer_ref",
          "observed_producer_refs",
          "reconciliation_status",
          "blocking"
        ],
        "properties": {
          "effect": {
            "type": "string",
            "minLength": 3
          },
          "observed_ref": {
            "type": "string",
            "minLength": 5
          },
          "declared_producer": {
            "type": "string",
            "minLength": 1
          },
          "declared_producer_ref": {
            "type": "string",
            "minLength": 5
          },
          "observed_producer_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 5
            }
          },
          "reconciliation_status": {
            "enum": [
              "MATCH",
              "UNRESOLVED_PRODUCER",
              "UNDECLARED_EXECUTION",
              "SILENT_DROP",
              "SOURCE_LIVE_DIVERGENCE",
              "OTHER_CONTRADICTION"
            ]
          },
          "blocking": {
            "type": "boolean"
          }
        }
      }
    },
    "authority_contradictions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "classification",
          "declared",
          "observed",
          "blocking",
          "evidence_ref"
        ],
        "properties": {
          "classification": {
            "enum": [
              "SILENT_DROP",
              "UNDECLARED_EXECUTION",
              "SOURCE_LIVE_DIVERGENCE",
              "DECLARED_VS_OBSERVED_CONTRADICTION",
              "OTHER"
            ]
          },
          "declared": {
            "type": "string",
            "minLength": 3
          },
          "observed": {
            "type": "string",
            "minLength": 3
          },
          "blocking": {
            "const": true
          },
          "evidence_ref": {
            "type": "string",
            "minLength": 5
          }
        }
      }
    },
    "repair_level": {
      "enum": [
        "UNDETERMINED",
        "LOCAL",
        "SYSTEMIC_ORIGIN",
        "ARCHITECTURAL"
      ]
    },
    "should_exist_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verdict",
        "subject",
        "real_consumers",
        "elimination_impact",
        "native_or_existing_alternative",
        "evidence_refs",
        "missing_evidence"
      ],
      "properties": {
        "verdict": {
          "enum": [
            "SHOULD_EXIST",
            "SHOULD_NOT_EXIST",
            "CONDITIONAL",
            "INSUFFICIENT_EVIDENCE"
          ]
        },
        "subject": {
          "type": "string",
          "minLength": 3
        },
        "real_consumers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "consumer",
              "evidence_ref"
            ],
            "properties": {
              "consumer": {
                "type": "string",
                "minLength": 3
              },
              "evidence_ref": {
                "type": "string",
                "minLength": 5
              }
            }
          }
        },
        "elimination_impact": {
          "type": "string",
          "minLength": 5
        },
        "native_or_existing_alternative": {
          "type": "string",
          "minLength": 3
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 5
          }
        },
        "missing_evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "prevention",
          "complexity",
          "blast_radius",
          "reuse",
          "fail_closed",
          "idempotency",
          "recoverability",
          "operational_cost",
          "basis_refs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "prevention": {
            "type": "string",
            "minLength": 1
          },
          "complexity": {
            "type": "string",
            "minLength": 1
          },
          "blast_radius": {
            "type": "string",
            "minLength": 1
          },
          "reuse": {
            "type": "string",
            "minLength": 1
          },
          "fail_closed": {
            "type": "string",
            "minLength": 1
          },
          "idempotency": {
            "type": "string",
            "minLength": 1
          },
          "recoverability": {
            "type": "string",
            "minLength": 1
          },
          "operational_cost": {
            "type": "string",
            "minLength": 1
          },
          "basis_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 5
            }
          }
        }
      }
    },
    "preferred_alternative": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "selected_alternative": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "rejected_alternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "reason",
          "evidence_refs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 5
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 5
            }
          }
        }
      }
    },
    "falsification_results": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case",
          "result",
          "evidence_ref",
          "evidence_class"
        ],
        "properties": {
          "case": {
            "enum": [
              "bypass",
              "retry",
              "concurrency",
              "partial_failure",
              "stale_state",
              "interrupted_execution",
              "replay_or_duplicate",
              "undeclared_or_unversioned_caller"
            ]
          },
          "result": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_COVERED",
              "BLOCKED"
            ]
          },
          "evidence_ref": {
            "type": "string"
          },
          "evidence_class": {
            "enum": [
              "OBSERVED_TEST",
              "OBSERVED_RUNTIME",
              "OBSERVED_READBACK",
              "DESIGN_ONLY",
              "MISSING"
            ]
          }
        }
      }
    },
    "origin_asset": {
      "$ref": "#/$defs/authority_ref"
    },
    "origin_operation": {
      "$ref": "#/$defs/authority_ref"
    },
    "owner": {
      "$ref": "#/$defs/authority_ref"
    },
    "invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement",
        "status",
        "evidence_refs",
        "missing_evidence"
      ],
      "properties": {
        "statement": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 8
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "VALIDATED",
            "PROPOSED",
            "UNRESOLVED"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 5
          }
        },
        "missing_evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    },
    "hard_guard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "control",
        "enforcement_point_ref",
        "fail_closed_condition",
        "blocking_code",
        "observable_result",
        "evidence_refs",
        "missing_evidence"
      ],
      "properties": {
        "status": {
          "enum": [
            "VALIDATED",
            "PROPOSED",
            "UNRESOLVED"
          ]
        },
        "control": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 5
            },
            {
              "type": "null"
            }
          ]
        },
        "enforcement_point_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 5
            },
            {
              "type": "null"
            }
          ]
        },
        "fail_closed_condition": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 5
            },
            {
              "type": "null"
            }
          ]
        },
        "blocking_code": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 3
            },
            {
              "type": "null"
            }
          ]
        },
        "observable_result": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 5
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 5
          }
        },
        "missing_evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion",
          "verification_method",
          "expected_result"
        ],
        "properties": {
          "criterion": {
            "type": "string",
            "minLength": 5
          },
          "verification_method": {
            "type": "string",
            "minLength": 5
          },
          "expected_result": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    },
    "historical_regressions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "occurrence_ref",
          "observed_failure",
          "evidence_refs"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 2
          },
          "occurrence_ref": {
            "type": "string",
            "minLength": 5
          },
          "observed_failure": {
            "type": "string",
            "minLength": 5
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 5
            }
          }
        }
      }
    },
    "planned_regressions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "scenario",
          "verification_method",
          "expected_result"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 2
          },
          "scenario": {
            "type": "string",
            "minLength": 5
          },
          "verification_method": {
            "type": "string",
            "minLength": 5
          },
          "expected_result": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    },
    "current_uncertainties": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "uncertainty",
          "blocking",
          "evidence_needed"
        ],
        "properties": {
          "uncertainty": {
            "type": "string",
            "minLength": 5
          },
          "blocking": {
            "type": "boolean"
          },
          "evidence_needed": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 3
            }
          }
        }
      }
    },
    "residual_risks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "risk",
          "evidence_refs"
        ],
        "properties": {
          "risk": {
            "type": "string",
            "minLength": 5
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 5
            }
          }
        }
      }
    },
    "evidence_map": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_path",
          "evidence_refs"
        ],
        "properties": {
          "claim_path": {
            "type": "string",
            "pattern": "^\\$\\."
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 5
            }
          }
        }
      }
    },
    "blocking_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "next_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate",
        "entry_condition",
        "exit_condition"
      ],
      "properties": {
        "gate": {
          "type": "string",
          "minLength": 2
        },
        "entry_condition": {
          "type": "string",
          "minLength": 3
        },
        "exit_condition": {
          "type": "string",
          "minLength": 3
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "SYSTEMIC_REPAIR_SPEC"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "live_authority_packet": {
            "properties": {
              "status": {
                "const": "COMPLETE"
              },
              "unavailable_sources": {
                "maxItems": 0
              }
            }
          },
          "immediate_cause": {
            "properties": {
              "status": {
                "const": "ESTABLISHED"
              }
            }
          },
          "systemic_root_cause": {
            "properties": {
