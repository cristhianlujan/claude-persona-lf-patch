{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SRCR bounded runtime output constraint",
  "description": "Compact provider-side structural constraint. Canonical output.schema.json and deterministic validators remain authoritative.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "status": {
      "enum": [
        "SYSTEMIC_REPAIR_SPEC",
        "NEEDS_MORE_EVIDENCE",
        "RETURN_TO_WORKER_FOR_SELF_REPAIR",
        "BLOCK_PIPELINE"
      ]
    },
    "profile_pack_id": {
      "enum": [
        "SYSTEMIC_ROOT_CAUSE_REPAIR_LF_V0_2",
        "SYSTEMIC_ROOT_CAUSE_REPAIR_LF_V0_3"
      ]
    },
    "solution_depth": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "complexity_signals": {
          "type": "array",
          "items": {
            "enum": [
              "CROSS_OPERATION",
              "AUTHORITY_CHANGE",
              "POLICY_CONTRACT_CHANGE",
              "CONTEXT_TRANSPORT",
              "STATE_RECOVERY",
              "CONCURRENCY",
              "MIGRATION_TRANSITION",
              "SECURITY_BOUNDARY",
              "MULTI_RUNTIME",
              "COST_SCALE",
              "NONE"
            ]
          },
          "uniqueItems": true
        },
        "mode": {
          "enum": [
            "LIGHTWEIGHT",
            "BOUNDED",
            "DEEP_ARCHITECTURE_RESEARCH"
          ]
        }
      }
    },
    "recurrence_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "evidence_class": {
            "enum": [
              "DECLARED_INPUT",
              "OBSERVED_HISTORY",
              "OBSERVED_SOURCE",
              "OBSERVED_LIVE"
            ]
          }
        }
      }
    },
    "closure_proof": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "contract_version": {
          "enum": [
            "SRCR_CLOSURE_PROOF_V1",
            "SRCR_CLOSURE_PROOF_V2"
          ]
        },
        "materiality": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "signal": {
                "enum": [
                  "CROSS_OPERATION",
                  "AUTHORITY_CHANGE",
                  "POLICY_CONTRACT_CHANGE",
                  "CONTEXT_TRANSPORT",
                  "STATE_RECOVERY",
                  "CONCURRENCY",
                  "MIGRATION_TRANSITION",
                  "SECURITY_BOUNDARY",
                  "MULTI_RUNTIME",
                  "COST_SCALE",
                  "ARCHITECTURE",
                  "CONTROLS",
                  "POLICIES_CONTRACTS",
                  "WIRING",
                  "COMPATIBILITY_TRANSITION",
                  "RECOVERY_TERMINALITY",
                  "OBSERVABILITY",
                  "SECURITY_AUTHORITY",
                  "COST_PERFORMANCE",
                  "TESTING_ASSURANCE",
                  "OPERABILITY_MAINTENANCE",
                  "EVIDENCE_PROVENANCE",
                  "DECISION_CLOSURE"
                ]
              }
            }
          }
        },
        "proof_obligations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "obligation_type": {
                "enum": [
                  "AUTHORITY_EXISTENCE",
                  "WIRING_PHYSICALITY",
                  "STATE_RECOVERY_SEMANTICS",
                  "MIGRATION_TRANSITION",
                  "CONTEXT_TRANSPORT",
                  "SECURITY_BOUNDARY",
                  "CONCURRENCY",
                  "POLICY_CONTRACT",
                  "COMPATIBILITY",
                  "OBSERVABILITY",
                  "TEST_ASSURANCE",
                  "DECISION_CLOSURE",
                  "EVIDENCE_PROVENANCE",
                  "OTHER_MATERIAL"
                ]
              },
              "proof_phase": {
                "enum": [
                  "CURRENT_STATE",
                  "REPAIR_DESIGN",
                  "POST_IMPLEMENTATION"
                ]
              },
              "status": {
                "enum": [
                  "CLOSED",
                  "OPEN",
                  "NOT_APPLICABLE"
                ]
              }
            }
          }
        },
        "wiring_proofs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "binding_state": {
                "enum": [
                  "OBSERVED_WIRED",
                  "OBSERVED_NOT_WIRED",
                  "PROPOSED_WIRING"
                ]
              },
              "binding_kind": {
                "enum": [
                  "EXISTING_AUTHORITY",
                  "EXISTING_REUSABLE_CAPABILITY",
                  "PROPOSED_DELIVERABLE",
                  "NO_BINDING"
                ]
              }
            }
          }
        },
        "behavioral_proofs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "materiality_signal": {
                "enum": [
                  "STATE_RECOVERY",
                  "MIGRATION_TRANSITION"
                ]
              }
            }
          }
        },
        "authority_bindings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "authority_kind": {
                "enum": [
                  "EXISTING_AUTHORITY",
                  "EXISTING_REUSABLE_CAPABILITY",
                  "PROPOSED_DELIVERABLE",
                  "UNKNOWN"
                ]
              },
              "used_as_existing_authority": {
                "type": "boolean"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "used_as_existing_authority": {
                      "const": true
                    }
                  },
                  "required": [
                    "used_as_existing_authority"
                  ]
                },
                "then": {
                  "properties": {
                    "authority_kind": {
                      "const": "EXISTING_AUTHORITY"
                    }
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
