        ]
      }
    },
    {
      "$comment": "SRCR_DEPTH_SIGNAL_CLOSURE_PARITY:CONCURRENCY",
      "if": {
        "properties": {
          "solution_depth": {
            "properties": {
              "complexity_signals": {
                "contains": {
                  "const": "CONCURRENCY"
                }
              }
            },
            "required": [
              "complexity_signals"
            ]
          }
        },
        "required": [
          "solution_depth"
        ]
      },
      "then": {
        "properties": {
          "closure_proof": {
            "properties": {
              "materiality": {
                "contains": {
                  "type": "object",
                  "properties": {
                    "signal": {
                      "const": "CONCURRENCY"
                    },
                    "material": {
                      "const": true
                    }
                  },
                  "required": [
                    "signal",
                    "material"
                  ]
                }
              },
              "proof_obligations": {
                "allOf": [
                  {
                    "contains": {
                      "type": "object",
                      "properties": {
                        "obligation_type": {
                          "const": "CONCURRENCY"
                        },
                        "proof_phase": {
                          "enum": [
                            "CURRENT_STATE",
                            "REPAIR_DESIGN"
                          ]
                        }
                      },
                      "required": [
                        "obligation_type",
                        "proof_phase"
                      ]
                    }
                  }
                ]
              }
