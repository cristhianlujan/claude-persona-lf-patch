    },
    {
      "$comment": "SRCR_DEPTH_SIGNAL_CLOSURE_PARITY:STATE_RECOVERY",
      "if": {
        "properties": {
          "solution_depth": {
            "properties": {
              "complexity_signals": {
                "contains": {
                  "const": "STATE_RECOVERY"
                }
              }
            },
            "required": [
              "complexity_signals"
            ]
          }
        },
        "required": [
          "solution_depth"
        ]
      },
      "then": {
        "properties": {
          "closure_proof": {
            "properties": {
              "materiality": {
                "contains": {
                  "type": "object",
                  "properties": {
                    "signal": {
                      "const": "STATE_RECOVERY"
                    },
                    "material": {
                      "const": true
                    }
                  },
                  "required": [
                    "signal",
                    "material"
                  ]
                }
              },
              "proof_obligations": {
                "allOf": [
                  {
                    "contains": {
                      "type": "object",
                      "properties": {
                        "obligation_type": {
                          "const": "STATE_RECOVERY_SEMANTICS"
                        },
                        "proof_phase": {
                          "enum": [
                            "CURRENT_STATE",
                            "REPAIR_DESIGN"
                          ]
                        }
                      },
                      "required": [
                        "obligation_type",
                        "proof_phase"
