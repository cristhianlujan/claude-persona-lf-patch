{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Customer Identity Consent Privacy Output",
  "type": "object",
  "required": ["output_type", "self_verdict"],
  "properties": {
    "output_type": {"enum": ["CUSTOMER_IDENTITY_CONSENT_PRIVACY_SPEC", "MISSING_IDENTITY_OR_CONSENT_AUTHORITY", "BLOCKED_OVER_COLLECTION_OR_UNAUTHORIZED_USE", "BLOCKED_INVALID_CONSENT_PATTERN"]},
    "identity_assurance": {
      "type": "object",
      "properties": {
        "required": {"type": "boolean"},
        "purpose": {"type": "string"},
        "assurance_requirement": {"type": "string"},
        "authority_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "required": ["required", "purpose", "assurance_requirement", "authority_refs"],
      "additionalProperties": false
    },
    "data_requests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["data_id", "purpose", "required", "authority_refs"],
        "properties": {
          "data_id": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"},
          "authority_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1}
        },
        "additionalProperties": false
      }
    },
    "consent_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["consent_id", "purpose", "required", "affirmative_action", "decline_consequence", "authority_refs"],
        "properties": {
          "consent_id": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"},
          "affirmative_action": {"type": "string", "minLength": 1},
          "decline_consequence": {"type": "string"},
          "authority_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1}
        },
        "additionalProperties": false
      }
    },
    "data_minimization_checks": {"type": "array", "items": {"type": "string"}},
    "exposure_controls": {"type": "array", "items": {"type": "string"}},
    "prohibited_inferences": {"type": "array", "items": {"type": "string"}},
    "uncertainties": {"type": "array", "items": {"type": "string"}},
    "handoff_to_next": {"type": "object"},
    "blocked": {"type": "boolean"},
    "missing_inputs": {"type": "array", "items": {"type": "string"}},
    "blocking_reason": {"type": "string"},
    "self_verdict": {"enum": ["READY_FOR_REVIEW", "NEEDS_INPUT", "BLOCKED", "NEEDS_REPAIR"]}
  },
  "allOf": [
    {"if": {"properties": {"output_type": {"const": "CUSTOMER_IDENTITY_CONSENT_PRIVACY_SPEC"}}}, "then": {"required": ["identity_assurance", "data_requests", "consent_items", "data_minimization_checks", "exposure_controls", "prohibited_inferences", "uncertainties", "handoff_to_next"]}},
    {"if": {"properties": {"output_type": {"const": "MISSING_IDENTITY_OR_CONSENT_AUTHORITY"}}}, "then": {"required": ["blocked", "missing_inputs"]}},
    {"if": {"properties": {"output_type": {"enum": ["BLOCKED_OVER_COLLECTION_OR_UNAUTHORIZED_USE", "BLOCKED_INVALID_CONSENT_PATTERN"]}}}, "then": {"required": ["blocked", "blocking_reason"]}}
  ],
  "additionalProperties": false
}
