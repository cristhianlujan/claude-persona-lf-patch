{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpportunityExpanderOutput",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "user_payload", "internal_envelope", "evidence_map"],
  "properties": {
    "status": {"type": "string", "enum": ["READY_FOR_REVIEW", "RETURN_TO_WORKER_FOR_DIVERGENCE", "BLOCKED"]},
    "user_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline_preserved", "opportunities"],
      "properties": {
        "baseline_preserved": {"type": "boolean"},
        "opportunities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "lane", "idea", "mechanism", "potential_value", "experiment", "requires_scope_change"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "lane": {"type": "string", "enum": ["CORE", "ADJACENT", "BUSINESS", "DATA", "FRONTIER"]},
              "idea": {"type": "string", "minLength": 8},
              "mechanism": {"type": "string", "minLength": 8},
              "potential_value": {"type": "string", "minLength": 8},
              "experiment": {"type": "string", "minLength": 8},
              "requires_scope_change": {"type": "boolean"}
            }
          }
        }
      }
    },
    "internal_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["novelty_distance", "redundancy_check", "frontier_present", "scope_guard_passed"],
      "properties": {
        "novelty_distance": {"type": "string", "enum": ["CORE", "ADJACENT", "FRONTIER", "MIXED"]},
        "redundancy_check": {"type": "string", "enum": ["PASS", "FAIL"]},
        "frontier_present": {"type": "boolean"},
        "scope_guard_passed": {"type": "boolean"}
      }
    },
    "evidence_map": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_ref", "supports"],
        "properties": {
          "source_ref": {"type": "string", "minLength": 1},
          "supports": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 4}}
        }
      }
    }
  }
}