        "decision_lineage":{"type":"object","required":["objective","selected_decision","evidence_refs","preserved_constraints","acceptance_refs","handoff_effect"],"properties":{"objective":{"type":"string","minLength":1},"selected_decision":{"type":"string","minLength":1},"evidence_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},"preserved_constraints":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},"acceptance_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},"handoff_effect":{"type":"string","minLength":1}},"additionalProperties":false}
