    "score":{"type":"object","required":["product_decision_clarity","scope_control_mvp_separation","acceptance_criteria_quality","cross_profile_handoff_quality","evidence_risk_governance_traceability","total","evidence_by_criterion"],"properties":{"product_decision_clarity":{"type":"integer","minimum":0,"maximum":5},"scope_control_mvp_separation":{"type":"integer","minimum":0,"maximum":5},"acceptance_criteria_quality":{"type":"integer","minimum":0,"maximum":5},"cross_profile_handoff_quality":{"type":"integer","minimum":0,"maximum":5},"evidence_risk_governance_traceability":{"type":"integer","minimum":0,"maximum":5},"total":{"type":"integer","minimum":0,"maximum":25},"evidence_by_criterion":{"type":"object","required":["product_decision_clarity","scope_control_mvp_separation","acceptance_criteria_quality","cross_profile_handoff_quality","evidence_risk_governance_traceability"],"properties":{"product_decision_clarity":{"type":"array","minItems":1,"items":{"type":"string","minLength":6}},"scope_control_mvp_separation":{"type":"array","minItems":1,"items":{"type":"string","minLength":6}},"acceptance_criteria_quality":{"type":"array","minItems":1,"items":{"type":"string","minLength":6}},"cross_profile_handoff_quality":{"type":"array","minItems":1,"items":{"type":"string","minLength":6}},"evidence_risk_governance_traceability":{"type":"array","minItems":1,"items":{"type":"string","minLength":6}}},"additionalProperties":false}},"additionalProperties":false},
