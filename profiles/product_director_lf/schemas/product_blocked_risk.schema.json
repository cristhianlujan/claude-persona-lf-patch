  "required": [
    "worker",
    "output_type",
    "self_verdict",
    "deliverable_created"
  ],
  "properties": {
    "worker": {
      "const": "product_director_lf"
    },
    "output_type": {
      "const": "BLOCKED_PRODUCT_RISK"
    },
    "self_verdict": {
      "const": "BLOCKED_PRODUCT_RISK"
    },
