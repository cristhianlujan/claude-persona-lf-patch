{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "LF_STEP70_SAME_LLM_REVIEW_OUTPUT_V1",
  "title": "LF Step70 independent same-LLM second call — output only",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "execution_id",
    "candidate_sha256",
    "scope_packet_sha256",
    "verdict",
    "decision_body",
    "source_refs"
  ],
  "properties": {
    "schema_id": {
      "const": "LF_STEP70_SAME_LLM_REVIEW_OUTPUT_V1"
    },
    "execution_id": {
      "type": "string",
      "pattern": "^EXEC-PROFILE-GATE2-[A-Za-z0-9_-]{8,}$"
    },
    "candidate_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "scope_packet_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "verdict": {
      "enum": [
        "PASS_INDEPENDENT_SEMANTIC",
        "FAIL_SEMANTIC",
        "REVIEW_INCOMPLETE"
      ]
    },
    "decision_body": {
      "type": "object",
      "required": [
        "verdict",
        "decision_checks",
        "unsupported_claims",
        "blocking_codes",
        "reason"
      ],
      "properties": {
        "verdict": {
          "type": "string"
        },
        "decision_checks": {
          "type": "object",
          "minProperties": 12
        },
        "unsupported_claims": {
          "type": "array"
        },
        "blocking_codes": {
          "type": "array"
        },
        "reason": {
          "type": "string",
          "minLength": 10
        }
      },
      "additionalProperties": true
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 4
      }
    }
  }
}
