{
  "schema": "LF_PROFILE_RUNTIME_BINDING_V1",
  "profile_slug": "quality_pack",
  "profile_code": "PERFIL-QUALITY-PACK",
  "runtime_schema": {
    "default": "schemas/quality_review.schema.json",
    "output_modes": {}
  },
  "canonical_validator": {
    "path": "validators/runtime_validate.py",
    "callable": "validate",
    "transport": "STDIN_JSON"
  },
  "governance": {
    "source_first_required": true,
    "schema_invention_allowed": false,
    "fail_closed": true,
    "exact_head_evidence_required": true,
    "post_update_baseline_required": true,
    "automatic_promotion_allowed": false,
    "production_authorized": false
  },
  "model_context": {
    "full_source_to_model": false,
    "required_source_refs": [
      "profiles/quality_pack/SKILL.md"
    ],
    "allow_additional_sources": true,
    "source_projection": {
      "mode": "MARKDOWN_SECTIONS",
      "include_sections": [
        "Purpose",
        "Required inputs",
        "Resolver-backed evidence boundary — GOV-037",
        "Executor-first admission for Product Director reviews"
      ],
      "max_chars": 8000
    }
  },
  "execution_partition": {
    "schema": "LF_PROFILE_EXECUTION_PARTITION_V1",
    "field_classes": {
      "review_id": "HYBRID",
      "reviewed_artifact": "HYBRID",
      "verdict": "SEMANTIC",
      "score_breakdown": "HYBRID",
      "evidence_map": "HYBRID",
      "blocking_codes": "HYBRID",
      "repair_actions": "SEMANTIC",
      "remaining_risks": "SEMANTIC",
      "next_gate": "HYBRID",
      "routing": "HYBRID"
    },
    "deterministic_materialization": {},
    "generation_limits": {}
  },
  "execution_budget": {
    "resource_class": "STANDARD",
    "max_prompt_tokens": 8000,
    "max_output_tokens": 6000,
    "min_available_memory_mb": 1024,
    "max_swap_used_pct": 50
  },
  "semantic_utility": {
    "path": "validators/runtime_semantic_utility.py",
    "callable": "evaluate"
  }
}
