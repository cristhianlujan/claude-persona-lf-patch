{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Frontend Prototype Missing Input State",
  "type": "object",
  "required": [
    "worker",
    "output_type",
    "blocked",
    "missing_fields",
    "resolved_from_context",
    "conflicts_detected",
    "why_required",
    "risk_if_assumed",
    "pipeline_action",
    "resolution_target",
    "question_to_orchestrator"
  ],
  "properties": {
    "worker": {"const": "frontend_prototype_architect_lf"},
    "output_type": {"const": "FRONTEND_MISSING_INPUT_STATE"},
    "blocked": {"const": true},
    "missing_fields": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "resolved_from_context": {"type": "array", "items": {"type": "string"}},
    "conflicts_detected": {"type": "array", "items": {"type": "string"}},
    "why_required": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "risk_if_assumed": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "pipeline_action": {"const": "RETURN_TO_ORCHESTRATOR"},
    "resolution_target": {
      "type": "string",
      "enum": [
        "PRODUCT_DIRECTION",
        "UI_ARCHITECT",
        "LF_SHELL_GOVERNANCE",
        "ORCHESTRATOR_DECISION"
      ]
    },
    "question_to_orchestrator": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
