{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Customer Financial UX Decisioning Output",
  "type": "object",
  "additionalProperties": false,
  "required": ["output_type", "status", "evidence_map", "self_verdict"],
  "properties": {
    "output_type": {"enum": ["CUSTOMER_FINANCIAL_DECISION_SPEC", "MISSING_MATERIAL_FINANCIAL_INPUT", "BLOCKED_UNSUPPORTED_FINANCIAL_CLAIM"]},
    "status": {"enum": ["READY_FOR_REVIEW", "NEEDS_INPUT", "BLOCKED", "NEEDS_REPAIR"]},
    "evidence_map": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_ref", "supports"],
        "properties": {
          "source_ref": {"type": "string", "minLength": 1},
          "supports": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "decision_id": {"type": "string", "minLength": 1},
    "decision_question": {"type": "string", "minLength": 1},
    "comparison_basis": {"type": "string"},
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["option_id", "terms", "customer_consequence", "timing", "monetary_basis", "key_tradeoff", "authority_refs"],
        "properties": {
          "option_id": {"type": "string", "minLength": 1},
          "terms": {"type": "object"},
          "customer_consequence": {"type": "string"},
          "timing": {"type": "string"},
          "monetary_basis": {"type": "string"},
          "key_tradeoff": {"type": "string"},
          "authority_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1}
        },
        "additionalProperties": true
      }
    },
    "must_understand": {"type": "array", "items": {"type": "string"}},
    "uncertainties": {"type": "array", "items": {"type": "string"}},
    "claim_guardrails": {"type": "array", "items": {"type": "string"}},
    "recommended_presentation_priority": {"type": "array", "items": {"type": "string"}},
    "handoff_to_next": {"type": "object"},
    "blocked": {"type": "boolean"},
    "missing_inputs": {"type": "array", "items": {"type": "string"}},
    "blocking_reason": {"type": "string"},
    "self_verdict": {"enum": ["READY_FOR_REVIEW", "NEEDS_INPUT", "BLOCKED", "NEEDS_REPAIR"]}
  },
  "allOf": [
    {"if": {"properties": {"output_type": {"const": "CUSTOMER_FINANCIAL_DECISION_SPEC"}}}, "then": {"required": ["decision_id", "decision_question", "comparison_basis", "options", "must_understand", "uncertainties", "claim_guardrails", "handoff_to_next"]}},
    {"if": {"properties": {"output_type": {"const": "MISSING_MATERIAL_FINANCIAL_INPUT"}}}, "then": {"required": ["blocked", "missing_inputs"]}},
    {"if": {"properties": {"output_type": {"const": "BLOCKED_UNSUPPORTED_FINANCIAL_CLAIM"}}}, "then": {"required": ["blocked", "blocking_reason"]}}
  ]
}
