{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lf_adapter_invocation.schema.json",
  "title": "Marketplace LF UX Adapter Invocation Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["invocation_id", "adapter_code", "assurance_revision", "activation_source", "binding_ref", "profile_id", "target_ref", "capsule_ref", "capsule_char_count", "source_refs", "verdict"],
  "properties": {
    "invocation_id": {"type": "string", "minLength": 1},
    "adapter_code": {"const": "ADAPTER_MARKETPLACE_LF_UX"},
    "assurance_revision": {"const": "v2"},
    "activation_source": {"const": "ROUTER"},
    "binding_ref": {"type": "string", "minLength": 1},
    "profile_id": {"const": "PERFIL-UX-PRODUCT-EXPERIENCE-ARCHITECT-LF-20260531"},
    "target_ref": {"const": "PERFIL-UX-PRODUCT-EXPERIENCE-ARCHITECT-LF-20260531"},
    "capsule_ref": {"const": "adapters/marketplace_lf_ux/runtime/runtime_capsule.yaml"},
    "capsule_char_count": {"type": "integer", "minimum": 1, "maximum": 1600},
    "source_refs": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "verdict": {"enum": ["APPLIED", "BLOCKED"]}
  }
}
