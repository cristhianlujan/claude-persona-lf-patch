{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project_brand_mockup_binding.schema.json",
  "title": "Project Brand Mockup Binding",
  "type": "object",
  "additionalProperties": false,
  "required": ["binding_state", "project", "output_target", "source_refs", "token_refs", "screen_spec_refs", "mockup_policy", "fallback_mode", "qa_requirements", "blockers", "handoff"],
  "properties": {
    "binding_state": {"enum": ["BOUND", "BOUND_WITH_APPROVED_FALLBACK", "RETURN_TO_ORCHESTRATOR_MISSING_SOURCE", "BLOCKED_SOURCE_CONFLICT", "BLOCKED_PROJECT_UNRESOLVED"]},
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_code", "design_system_code"],
      "properties": {
        "project_code": {"type": "string", "minLength": 1},
        "design_system_code": {"type": "string", "minLength": 1},
        "product_code": {"type": ["string", "null"]},
        "flow_code": {"type": ["string", "null"]},
        "screen_id": {"type": ["string", "null"]}
      }
    },
    "output_target": {"enum": ["PDF", "PPTX", "HTML", "BRANDBOOK"]},
    "source_refs": {"type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "token_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "screen_spec_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "mockup_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frame_required", "frame_type", "screen_state_required"],
      "properties": {
        "frame_required": {"type": "boolean"},
        "frame_type": {"type": ["string", "null"]},
        "screen_state_required": {"type": "boolean"}
      }
    },
    "fallback_mode": {"enum": ["NONE", "APPROVED_FALLBACK", "PROPOSED_NOT_CANONICAL"]},
    "qa_requirements": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "blockers": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_worker", "allowed_scope"],
      "properties": {
        "target_worker": {"type": "string", "minLength": 1},
        "allowed_scope": {"type": "string", "minLength": 1}
      }
    }
  }
}
