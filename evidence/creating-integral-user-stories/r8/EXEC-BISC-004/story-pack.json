  "core": {
    "acceptance_criteria": [
      {
        "criterion_code": "AC-01",
        "given": "La persona completó datos válidos y existe una oferta elegible.",
        "source_ref": "event:807#SRC-R8-DEBT-NEGOTIATION-SIMULATOR-001",
        "then": "El sistema muestra resultado con oferta, monto aplicable y código de trazabilidad.",
        "when": "Solicita la simulación."
      },
      {
        "criterion_code": "AC-02",
        "given": "La persona completó datos válidos y no existe oferta elegible.",
        "source_ref": "event:807#SRC-R8-DEBT-NEGOTIATION-SIMULATOR-001",
        "then": "El sistema muestra resultado sin oferta y una orientación no engañosa.",
        "when": "Solicita la simulación."
      },
      {
        "criterion_code": "AC-03",
        "given": "Falta al menos un dato obligatorio o su formato es inválido.",
        "source_ref": "event:807#SRC-R8-DEBT-NEGOTIATION-SIMULATOR-001",
        "then": "El sistema bloquea el envío, identifica el campo y no consulta elegibilidad.",
        "when": "La persona solicita la simulación."
      },
      {
        "criterion_code": "AC-04",
        "given": "El servicio de evaluación presenta una falla transitoria.",
        "source_ref": "event:807#SRC-R8-DEBT-NEGOTIATION-SIMULATOR-001",
        "then": "El sistema muestra un error recuperable y conserva un código de correlación sin PII.",
        "when": "La persona solicita la simulación."
      },
      {
        "criterion_code": "AC-05",
        "given": "La pantalla contiene datos personales y financieros.",
        "source_ref": "event:807#SRC-R8-DEBT-NEGOTIATION-SIMULATOR-001",
        "then": "Ningún valor sensible aparece en analytics o logs no autorizados.",
        "when": "Se procesa o registra telemetría."
      },
      {
        "criterion_code": "AC-06",
        "given": "Una simulación fue aceptada.",
        "source_ref": "event:807#SRC-R8-DEBT-NEGOTIATION-SIMULATOR-001",
        "then": "Existe un identificador opaco que enlaza fuente, solicitud, resultado, prueba y juez.",
        "when": "La respuesta es emitida."
      },
      {
        "criterion_code": "AC-07",
        "given": "La misma solicitud idempotente es reenviada.",
        "source_ref": "event:807#SRC-R8-DEBT-NEGOTIATION-SIMULATOR-001",
        "then": "El sistema reutiliza el resultado o evita una simulación duplicada.",
        "when": "El servicio recibe el mismo identificador de idempotencia."
      },
      {
        "criterion_code": "AC-08",
        "given": "Un actor intenta acceder fuera de su tenant o sin permiso.",
        "source_ref": "event:807#SRC-R8-DEBT-NEGOTIATION-SIMULATOR-001",
        "then": "El servidor deniega la operación sin exponer datos.",
        "when": "Solicita leer o ejecutar la simulación."
      },
      {
        "criterion_code": "AC-09",
        "given": "La persona navega con teclado o lector de pantalla.",
        "source_ref": "event:807#SRC-R8-DEBT-NEGOTIATION-SIMULATOR-001",
        "then": "El orden, nombres accesibles, foco y anuncios permiten completar el flujo.",
        "when": "Interactúa con campos, errores y resultados."
      },
      {
        "criterion_code": "AC-10",
        "given": "La simulación cambia de estado.",
        "source_ref": "event:807#SRC-R8-DEBT-NEGOTIATION-SIMULATOR-001",
        "then": "La transición sigue el ciclo autorizado y deja evidencia técnica sin mezclarla con analytics.",
        "when": "Ocurre validación, evaluación o respuesta."
      }
    ],
    "actor": "Persona con una deuda registrada que busca conocer una alternativa de negociación.",
    "alternative_flows": [
      "Con información incompleta, el sistema bloquea la evaluación y señala campos corregibles.",
      "Ante una falla transitoria, el sistema aplica la política de reintento y muestra un error recuperable.",
      "Ante acceso no autorizado o cross-tenant, el servidor deniega sin revelar existencia de datos."
    ],
    "benefit": "Conocer si existe una oferta disponible sin exponer datos personales ni perder continuidad ante fallas recuperables.",
    "main_flow": [
      "El sistema presenta los ocho campos definidos por la fuente.",
      "La persona completa los campos obligatorios y puede agregar un comentario.",
      "El sistema valida formato, obligatoriedad, rangos y catálogo.",
      "El servidor verifica permiso, tenant e idempotencia.",
      "El servicio evalúa elegibilidad sin registrar PII en telemetría.",
      "El sistema muestra resultado con oferta o sin oferta.",
      "La respuesta incluye un identificador opaco de simulación y un código de trazabilidad."
    ],
    "need": "Registrar información mínima de la deuda y obtener una respuesta clara, segura y trazable.",
    "out_of_scope": [
      "Formalización contractual de una negociación.",
      "Pago, desembolso o conciliación financiera.",
      "Emisión de carta de no adeudo.",
      "Modificación del catálogo de entidades."
    ],
    "postconditions": [
      "La respuesta queda asociada a una simulación opaca y auditable.",
      "La telemetría conserva resultado técnico y latencia sin PII.",
      "No se crea una segunda simulación para una solicitud idempotente repetida."
    ],
    "preconditions": [
      "La pantalla y sus catálogos están disponibles.",
      "El actor pertenece al tenant autorizado.",
      "La política de privacidad y el consentimiento aplicable fueron presentados."
    ],
    "trigger": "La persona selecciona la acción para simular la negociación de su deuda."
  },
