          {
            "line": 141,
            "text": "SELECT pipeline_run_id, stage_current, stage_status, retry_count"
          },
          {
            "line": 148,
            "text": "- `stage_status = FAILED` y `retry_count < 3` → modo RETRY"
          },
          {
            "line": 177,
            "text": "OP-4.  Captura web real — seleccionar motor según agente ejecutor"
          },
          {
            "line": 198,
            "text": "       ## RESULTADO ESPERADO de OP-4"
          },
          {
            "line": 200,
            "text": "       · 403/timeout/error de red → UPDATE lf_url_queue SET estado='FALLIDO'"
          },
          {
            "line": 209,
            "text": "         run_type       = 'SCHEDULED'"
          },
          {
            "line": 355,
            "text": "- Saltar OP-4 a OP-7. Usar `run_id` y `record_id` existentes."
          },
          {
            "line": 359,
            "text": "### MODO RETRY — pipeline_run fallido, retry_count < 3"
          },
          {
            "line": 363,
            "text": "SET retry_count = retry_count + 1, stage_status = 'PENDING', updated_at = NOW()"
          },
          {
            "line": 368,
            "text": "- Si retry_count llega a 3 → marcar FAILED definitivo → siguiente iteración."
          },
