  "checks": [
    {
      "code": "NO_BYPASS_AUTHORITY",
      "statement": "ACT-0001 debe conservar routing/operation/effect authority; ningún PASS semántico puede sustituir la rederivación/autorización canónica."
    },
    {
      "code": "DOUBLE_OBJECT_SCOPE",
      "statement": "Un request con exactamente dos objetos autorizados puede validar sin widening; introducir un tercer objeto no declarado debe bloquear fail-closed."
    },
    {
      "code": "QUESTION_DISCIPLINE",
      "statement": "No debe existir pregunta de aclaración cuando material_ambiguities está vacío; el contrato limita la interacción a como máximo una pregunta material por ronda."
    },
    {
      "code": "TRAIN_LIFECYCLE",
      "statement": "Las mutaciones DB deben reservar/aplicar/cerrar por ACTUALIZACION_DB_LF / Migration Merge Train con write-ahead, parity y readback; no direct apply."
    },
    {
      "code": "READ_ONLY_PERMISSIONS",
      "statement": "READ_ONLY no concede escritura; GPT_NATIVE puede ejecutarse sin runtime remoto, REMOTE_API sigue bloqueado si runtime_estado=NO_HABILITADO y PROFILE_EXECUTION write_allowed permanece false."
    }
  ],
  "synthetic_prompts": [
    {
