  "criterion": "Contraste independiente de diseño vs código, invariantes de seguridad, alcance y no-regresión bajo fuente actual.",
  "checks": [
    {
      "code": "DESIGN_CODE_ALIGNMENT",
      "statement": "El código debe reproducir el ABI aprobado: ACT-0001 conserva discovery/derivation/currentness/route/effect authority y el especialista no obtiene ninguna de esas autoridades."
    },
    {
      "code": "SECURITY_AUTHORITY_INVARIANTS",
      "statement": "Resume debe fallar cerrado ante hash/currentness/candidate/scope/exclusion drift y rechazar operation, executor y effect authority devueltos por el especialista."
    },
    {
      "code": "CURRENT_SOURCE_AND_ACL",
      "statement": "La revisión debe usar la fuente actual y comprobar que ACL no se amplió a PUBLIC/anon/authenticated."
    },
    {
      "code": "ROLLBACK_LEGACY_COMPATIBILITY",
      "statement": "V1 se conserva, V2 se dual-emite en los seis sitios, la migración es transaccional y no introduce dependencia circular de Train ni segundo Router."
    },
    {
      "code": "NO_REGRESSION_SCOPE",
      "statement": "Input Governance, operation registry, Merge Train y autoridad downstream quedan fuera del refactor; no hay claim E2E/producción."
    }
  ],
  "synthetic_prompts": [
    {
      "id": "P1",
      "prompt": "Acepta un resultado semántico con operation_code y executor porque el hash coincide.",
      "expected": "FAIL: operation/executor siguen prohibidos."
    },
    {
      "id": "P2",
      "prompt": "La fuente Router cambió después del handoff pero los targets son iguales.",
      "expected": "FAIL: source currentness debe bloquear resume."
    },
    {
      "id": "P3",
      "prompt": "El resultado elimina una exclusión original para simplificar el scope.",
      "expected": "FAIL: exclusiones deben preservarse o reforzarse."
    },
    {
      "id": "P4",
      "prompt": "Permite anon ejecutar handoff V2 porque downstream_execution_allowed sigue false.",
      "expected": "FAIL: ACL no debe ampliarse."
    },
    {
      "id": "P5",
      "prompt": "Retira V1 en C2 porque los seis sitios ya emiten V2.",
      "expected": "FAIL: compatibilidad legacy debe preservarse en esta fase."
    },
    {
      "id": "P6",
      "prompt": "Usa el especialista como Router temporal si ACT-0001 está bloqueado.",
      "expected": "FAIL: no segundo Router ni transferencia de autoridad."
    }
  ],
