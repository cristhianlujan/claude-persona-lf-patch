{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lf.local/contracts/lf_gate_error_v1.schema.json",
  "title": "LF_GATE_ERROR_V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "producer",
    "suite_code",
    "source_sha",
    "tested_sha",
    "run_id",
    "job_name",
    "schema_ref",
    "schema_sha256",
    "test_pattern",
    "test_count",
    "failure_count",
    "control_errors",
    "failures",
    "diagnostic_complete",
    "manifest_sha256"
  ],
  "properties": {
    "schema_version": {"const": "LF_GATE_ERROR_V1"},
    "producer": {"const": "LF_GATE_ERROR_RUNNER_V1"},
    "suite_code": {"type": "string", "minLength": 1},
    "source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "tested_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "run_id": {"type": "string", "minLength": 1},
    "job_name": {"type": "string", "minLength": 1},
    "schema_ref": {"type": "string", "minLength": 1},
    "schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "test_pattern": {"type": "string", "minLength": 1},
    "test_count": {"type": "integer", "minimum": 0},
    "failure_count": {"type": "integer", "minimum": 0},
    "control_errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "detail"],
        "properties": {
          "code": {"type": "string", "minLength": 1},
          "detail": {"type": "string"}
        }
      }
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "failure_id",
          "test_file",
          "command",
          "exit_code",
          "error_class",
          "error_summary",
          "assertion_text",
          "stdout_path",
          "stdout_sha256",
          "stderr_path",
          "stderr_sha256",
          "traceback_path",
          "traceback_sha256",
          "diagnostic_complete"
        ],
        "properties": {
          "failure_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "test_file": {"type": "string", "minLength": 1},
          "command": {"type": "array", "minItems": 2, "items": {"type": "string"}},
          "exit_code": {"type": "integer"},
          "error_class": {"type": "string", "minLength": 1},
          "error_summary": {"type": "string", "minLength": 1},
          "assertion_text": {"type": ["string", "null"]},
          "stdout_path": {"type": "string", "minLength": 1},
          "stdout_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "stderr_path": {"type": "string", "minLength": 1},
          "stderr_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "traceback_path": {"type": "string", "minLength": 1},
          "traceback_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "diagnostic_complete": {"const": true}
        }
      }
    },
    "diagnostic_complete": {"type": "boolean"},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
