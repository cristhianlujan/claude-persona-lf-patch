  },
  "execution_identity": {
    "required": [
      "execution_id",
      "operation_code",
      "operation_spec_id",
      "operation_spec_digest",
      "profile_code",
      "profile_source_sha",
      "executor_binding_id",
      "executor_binding_digest"
    ],
    "freeze_at_start": [
