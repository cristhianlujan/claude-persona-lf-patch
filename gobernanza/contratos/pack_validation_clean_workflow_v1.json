{
  "schema_version": "lf-pack-validation-clean-workflow/v1",
  "durable_name": "PACK_VALIDATION_CLEAN_WORKFLOW",
  "owner": "PACK_VALIDATION",
  "depends_on": [
    "PACK_VALIDATION_DEFINE_CONTRACT",
    "PACK_DISCOVERY_RESOLVE_AFFECTED_PACKS",
    "PACK_VALIDATION_EXECUTE_PACK_CHECKS",
    "PROFILE_PACK_VALIDATION_CLEAN_VALIDATOR"
  ],
  "purpose": "Materialize a clean reusable Pack Validation workflow that consumes already-authorized exact-head change context, resolves affected packs once, executes only pack-local deterministic validators, and emits bounded evidence without owning unrelated CI controls.",
  "workflow": {
    "staged_definition_path": "sandbox/lf_contract_gate_test/pack_validation_contract/lf-pack-validation-core.staged.yml",
    "target_path": ".github/workflows/lf-pack-validation-core.yml",
    "activation": "REUSABLE_CORE_ADMITTED_UNWIRED",
    "allowed_triggers": [
      "workflow_call"
    ],
    "forbidden_triggers": [
      "pull_request",
      "push",
      "workflow_dispatch",
      "schedule"
    ],
    "consumer_wiring": "NOT_CHANGED_IN_THIS_SOLUTION"
  },
  "input_contract": {
    "required": [
      "base_sha",
      "head_sha",
      "changed_paths_json"
    ],
    "authority": "CI_FAST_DEEP_LANE_ROUTER_OR_EQUIVALENT_ALREADY_AUTHORIZED_PLAN",
    "must_not_redecide": [
      "RUN_SKIP_APPLICABILITY",
      "UNRELATED_CONTROL_APPLICABILITY"
    ]
  },
  "execution_sequence": [
    "CHECKOUT_EXACT_HEAD",
    "RESOLVE_AFFECTED_PACKS",
    "EXECUTE_PACK_CHECKS",
    "PERSIST_PACK_VALIDATION_EVIDENCE"
  ],
  "allowed_capabilities": [
    "read repository source at exact head",
    "install deterministic pack-validator dependencies",
    "resolve affected governed packs",
    "execute pack-local validators/validate_pack.py",
    "upload bounded Pack Validation evidence artifact"
  ],
  "forbidden_capabilities": [
    "profile runtime API tests",
    "runtime regression",
    "S30 broker or protected Git writes",
    "gate observability qualification",
    "Supabase control-plane readback",
    "EKB persistence",
    "database apply or rollback",
    "assurance judgment",
    "deployment",
    "production activation"
  ],
  "scope_invariants": {
    "parallel_active_pack_engine_forbidden": true,
    "core_has_no_autonomous_trigger": true,
    "core_must_match_qualified_staged_definition": true,
    "foreign_control_rebinding_forbidden_in_this_solution": true,
    "existing_foreign_carriers_unchanged_in_this_solution": true,
    "caller_binding_required_before_replacing_existing_pack_execution": true,
    "foreign_owner_work_forbidden": true,
    "external_blocker_must_be_reported_not_repaired_here": true
  },
  "output_contract": {
    "artifact_name_prefix": "lf-pack-validation-",
    "required_files": [
      ".lf_pack_validation/discovery.json",
      ".lf_pack_validation/result.json",
      ".lf_pack_validation/summary.json"
    ],
    "status_enum": [
      "PASS",
      "FAIL",
      "SKIP"
    ],
    "authorizations": {
      "runtime_authorized": false,
      "git_write_authorized": false,
      "db_write_authorized": false,
      "deployment_authorized": false,
      "production_authorized": false
    }
  },
  "operational_plan": {
    "progress_semantics": "Percentages measure only PACK_VALIDATION-owned work. External controls, blockers, fixes, migrations, or owner responsibilities never count as Pack Validation progress.",
    "global_progress_percent": 62.5,
    "next_step": "STEP_06_CALLER_WIRING",
    "steps": [
      {
        "id": "STEP_01_NATURE_AND_BOUNDARY",
        "description": "Define Pack Validation nature and responsibility boundary.",
        "progress_percent": 100,
        "status": "CLOSED"
      },
      {
        "id": "STEP_02_NATIVE_VS_FOREIGN_CLASSIFICATION",
        "description": "Identify Pack Validation-owned capabilities versus foreign responsibilities.",
        "progress_percent": 100,
        "status": "CLOSED"
      },
      {
        "id": "STEP_03_CLEAN_CORE",
        "description": "Build the clean PACK_VALIDATION reusable core without foreign controls.",
        "progress_percent": 100,
        "status": "CLOSED"
      },
      {
        "id": "STEP_04_CORE_TESTS",
        "description": "Validate discovery, pack-local validators, exact-head handling, and bounded evidence.",
        "progress_percent": 100,
        "status": "CLOSED"
      },
      {
        "id": "STEP_05_BOUNDARY_VERIFICATION",
        "description": "Verify the clean core contains no Runtime, Assurance, DB, Contract Check, S30, EKB, deploy, or production responsibilities.",
        "progress_percent": 100,
        "status": "CLOSED"
      },
      {
        "id": "STEP_06_CALLER_WIRING",
        "description": "Connect Pack Validation to the pass orchestrator through its own interface without assuming caller or foreign-control responsibilities.",
        "progress_percent": 0,
