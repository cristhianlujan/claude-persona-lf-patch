  },
  "external_dependencies": [
    {
      "control": "CONTRACT_CHECK",
      "relationship": "EXTERNAL_CI_CONTROL",
      "status": "BLOCKED_BY_EXTERNAL_OWNER",
      "counts_toward_pack_validation_progress": false,
      "rule": "Report the blocker and hand off to its owner; do not modify or repair Contract Check from Pack Validation."
    }
  ],
  "handoff_status": "BLOCKED_UNTIL_EXTERNAL_CALLER_WIRING_IS_PROVEN"
}
