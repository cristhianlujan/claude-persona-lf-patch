{
  "schema_version": "lf-pack-validation-verify-e2e-flow/v1",
  "durable_name": "PACK_VALIDATION_VERIFY_E2E_FLOW",
  "owner": "PACK_VALIDATION",
  "purpose": "Prove the PACK_VALIDATION-owned path from exact input through changed-path integrity, affected-pack discovery, pack-local deterministic validation, bounded evidence, and final verdict without invoking foreign controls.",
  "proof_model": {
    "live_wiring_probe": {
      "required": true,
      "source": "exact-head Validate LF Packs run on the consolidated candidate",
      "non_pack_diff_may_skip": true
    },
    "positive_pack_probe": {
      "required": true,
      "isolation": "TEMPORARY_GIT_REPOSITORY_ONLY",
      "repository_pack_mutation": false,
      "expected_status": "PASS",
      "expected_affected_pack_count": 1
    },
    "negative_pack_probe": {
      "required": true,
      "isolation": "TEMPORARY_GIT_REPOSITORY_ONLY",
      "repository_pack_mutation": false,
      "expected_status": "FAIL",
      "required_blocking_code": "PACK_LOCAL_VALIDATOR_FAILED"
    },
    "changed_paths_integrity_probe": {
      "required": true,
      "isolation": "TEMPORARY_GIT_REPOSITORY_ONLY",
      "repository_pack_mutation": false,
      "expected_status": "FAIL",
      "required_blocking_code": "CHANGED_PATHS_MISMATCH",
      "must_block_before_discovery": true
    }
  },
  "caller_binding": {
    "carrier": ".github/workflows/validate-lf-packs.yml",
    "core": ".github/workflows/lf-pack-validation-core.yml",
    "base_sha": "needs.pack-context.outputs.base_sha",
    "head_sha": "needs.pack-context.outputs.head_sha",
    "changed_paths": "needs.pack-context.outputs.changed_paths_json",
    "must_not_redecide_applicability": true,
    "canonical_runner": "sandbox/lf_contract_gate_test/pack_validation_contract/run_pack_validation_flow_v1.py"
  },
  "required_evidence_files": [
    ".lf_pack_validation/discovery.json",
    ".lf_pack_validation/result.json",
    ".lf_pack_validation/summary.json"
  ],
  "authorization_invariants": {
    "runtime_authorized": false,
    "git_write_authorized": false,
    "db_write_authorized": false,
    "deployment_authorized": false,
    "production_authorized": false,
    "semantic_quality_review_authorized": false
  },
  "foreign_work_forbidden": [
    "Contract Check repair or admission change",
    "Migration Parity repair",
    "PROFILE_RUNTIME execution or regression ownership",
    "S30 broker or protected Git write",
    "Assurance judgment",
    "DB regression or database mutation",
    "Supabase or EKB persistence",
    "gate observability ownership",
    "Transversal README ownership",
    "deployment or production activation"
  ],
  "completion_rule": "PASS only when positive, negative, changed-path tamper, clean carrier boundary and exact-head workflow evidence are all satisfied.",
  "next_handoff": "STEP_08_READBACK_TRACEABILITY_CLOSE"
}
