{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lf:unified-execution:result:v1",
  "title": "LF Unified Execution Result V1",
  "description": "Generic executor result envelope. It reports task outcome and evidence under a lease identity but never advances canonical execution state.",
  "type": "object",
  "required": [
    "schema",
    "execution_id",
    "task_id",
    "step_id",
    "attempt_no",
    "lease_owner",
    "lease_fence",
    "outcome",
    "result_digest",
    "evidence_refs"
  ],
  "properties": {
    "schema": {
      "const": "LF_UNIFIED_EXECUTION_RESULT_V1"
    },
    "execution_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "step_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt_no": {
      "type": "integer",
      "minimum": 1
    },
    "lease_owner": {
      "type": "string",
      "minLength": 1
    },
    "lease_fence": {
      "type": "integer",
      "minimum": 0
    },
    "outcome": {
      "enum": [
        "SUCCEEDED",
        "BLOCKED",
        "FAILED",
        "RETRYABLE_FAILURE"
      ]
    },
    "result_digest": {
      "type": "string",
      "minLength": 1
    },
    "evidence_refs": {
      "type": "array"
    }
  },
  "propertyNames": {
    "not": {
      "pattern": "^(next_|selected_next_|advance_|canonical_state$|execution_state$|execution_status$)"
    }
  },
  "additionalProperties": true,
  "x-lf-authority": {
    "spec_id": "PILOT-SRCR-UNIFIED-EXECUTION-V1",
    "gate": "G04_RESULT_ENVELOPE",
    "handoff_event_id": 15186,
    "strict_sequence_event_id": 15188,
    "scope_consolidation_event_id": 15197,
    "g01_contract_pr": 1019,
    "g01_contract_head": "ae1bcbb3c443396347805f38037556bce9e7f88b",
    "g02_candidate_pr": 1020,
    "g02_candidate_head": "6dea45eea313b46cfc3afed3cb369deab43dcab1",
    "g03_candidate_pr": 1021,
    "g03_candidate_head": "6e5166f16253a63a6b6341d1bd681ed876571903",
    "frozen_profile_source_sha": "cb455027df2d2e2795ab66d41a539e217a04966f",
    "current_lease_authority": "public.lf_operation_execution",
    "live_lease_fence_type": "bigint",
    "executor_can_advance_execution_state": false,
    "submission_persistence_owner": "future_G06_submit_result",
    "candidate_only": true
  }
}
