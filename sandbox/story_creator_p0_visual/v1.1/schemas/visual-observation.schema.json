{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "lf/p0/visual-observation.schema.json",
  "title": "P0 Visual Observation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["observation_id", "source_image_ref", "region", "element_type", "visible_text", "visual_state", "confidence", "abstained", "evidence_ref"],
  "properties": {
    "observation_id": {"type": "string", "pattern": "^OBS-[A-Z0-9-]+$"},
    "source_image_ref": {"type": "string", "minLength": 3},
    "region": {
      "type": "object", "additionalProperties": false, "required": ["x", "y", "width", "height"],
      "properties": {"x": {"type": "number", "minimum": 0}, "y": {"type": "number", "minimum": 0}, "width": {"type": "number", "exclusiveMinimum": 0}, "height": {"type": "number", "exclusiveMinimum": 0}}
    },
    "element_type": {"type": "string", "minLength": 2},
    "visible_text": {"type": ["string", "null"]},
    "visual_state": {"type": "string", "minLength": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "abstained": {"type": "boolean"},
    "evidence_ref": {"type": "string", "minLength": 3}
  }
}
