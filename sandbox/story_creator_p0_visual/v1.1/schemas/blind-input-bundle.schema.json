{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "lf/p0/blind-input-bundle.schema.json",
  "title": "P0 Blind Input Bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["tenant_id", "project_id", "screen_set_code", "target_screen_code", "source_images", "hashes", "dimensions", "format", "sequence_order", "state_code", "security_scope", "data_policy_version", "blind_input_manifest_sha256"],
  "properties": {
    "tenant_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "screen_set_code": {"type": "string", "minLength": 3},
    "target_screen_code": {"type": "string", "pattern": "^SCR-[A-Z0-9-]+$"},
    "source_images": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "additionalProperties": false, "required": ["ref", "sha256"], "properties": {"ref": {"type": "string", "minLength": 3}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}
    },
    "hashes": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "dimensions": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "additionalProperties": false, "required": ["width", "height"], "properties": {"width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}}}
    },
    "format": {"type": "string", "enum": ["PNG", "JPEG", "WEBP"]},
    "sequence_order": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "state_code": {"type": "string", "minLength": 1},
    "security_scope": {"type": "string", "minLength": 1},
    "data_policy_version": {"type": "string", "minLength": 1},
    "blind_input_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
