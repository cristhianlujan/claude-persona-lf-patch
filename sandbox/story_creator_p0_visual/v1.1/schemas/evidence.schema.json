{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "lf/p0/evidence.schema.json",
  "title": "P0 Evidence Reference v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidence_id", "evidence_ref", "source_ref", "sha256", "kind", "data_classification", "redacted"],
  "properties": {
    "evidence_id": {"type": "string", "pattern": "^EV-[A-Z0-9-]+$"},
    "evidence_ref": {"type": "string", "minLength": 3},
    "source_ref": {"type": "string", "minLength": 3},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "kind": {"type": "string", "enum": ["SOURCE_IMAGE", "CROP", "VISUAL_OUTPUT", "AUXILIARY_SOURCE", "ADJUDICATION"]},
    "data_classification": {"type": "string", "enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "SENSITIVE"]},
    "redacted": {"type": "boolean"},
    "retention_until": {"type": ["string", "null"], "format": "date-time"}
  }
}
