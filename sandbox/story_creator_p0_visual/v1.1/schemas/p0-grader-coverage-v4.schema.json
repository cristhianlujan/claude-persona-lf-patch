{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"p0-grader-coverage-v4.schema.json","title":"P0 Grader Coverage V4","type":"object","additionalProperties":false,
  "required":["schema_version","execution_id","cycle_id","pass_id","source_sha256","candidate_sha256","reader_execution_id","required_graders","grader_execution_ids","candidate_grader_coverage","independent_screen_coverage","element_matrix","region_sweeps","grader_errors","coverage_percent","coverage_pass"],
  "properties":{
    "schema_version":{"const":"p0-grader-coverage-v4/v1"},"execution_id":{"type":"string","minLength":1},"cycle_id":{"type":"string","pattern":"^C-[A-Za-z0-9._-]+$"},"pass_id":{"type":"string","pattern":"^P-[A-Za-z0-9._-]+$"},
    "source_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"candidate_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"reader_execution_id":{"type":"string","minLength":1},
    "required_graders":{"type":"array","minItems":9,"maxItems":9,"uniqueItems":true,"items":{"enum":["J-TEXT","J-OBJECT","J-COMPLETE","J-GEOMETRY","J-STRUCTURE","J-STYLE","J-SEMANTIC","J-UNCERTAINTY","J-SKEPTIC"]}},
    "grader_execution_ids":{"type":"object","minProperties":9,"maxProperties":9,"additionalProperties":{"type":"string","minLength":1}},
    "candidate_grader_coverage":{"type":"object","additionalProperties":false,"required":["element_count","fully_evaluated_count","coverage_percent","complete"],"properties":{"element_count":{"type":"integer","minimum":0},"fully_evaluated_count":{"type":"integer","minimum":0},"coverage_percent":{"type":"number","minimum":0,"maximum":100},"complete":{"type":"boolean"}}},
    "independent_screen_coverage":{"type":"object","additionalProperties":false,"required":["sweep_execution_id","observed_count","represented_count","evaluated_count","unrepresented_count","uncertain_count","coverage_percent","complete"],"properties":{"sweep_execution_id":{"anyOf":[{"type":"string","minLength":1},{"type":"null"}]},"observed_count":{"type":"integer","minimum":0},"represented_count":{"type":"integer","minimum":0},"evaluated_count":{"type":"integer","minimum":0},"unrepresented_count":{"type":"integer","minimum":0},"uncertain_count":{"type":"integer","minimum":0},"coverage_percent":{"type":"number","minimum":0,"maximum":100},"complete":{"type":"boolean"}}},
    "element_matrix":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["element_id","applicable_graders","evaluated_graders","evidence_refs","complete"],"properties":{"element_id":{"type":"string","minLength":1},"applicable_graders":{"type":"array","items":{"type":"string"},"uniqueItems":true},"evaluated_graders":{"type":"array","items":{"type":"string"},"uniqueItems":true},"evidence_refs":{"type":"array","items":{"type":"string"}},"complete":{"type":"boolean"}}}},
    "region_sweeps":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["region_id","omission_sweep_status","evidence_refs"],"properties":{"region_id":{"type":"string","minLength":1},"omission_sweep_status":{"enum":["COMPLETE","INCOMPLETE","ERROR"]},"evidence_refs":{"type":"array","items":{"type":"string"}}}}},
    "grader_errors":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["grader_id","error"],"properties":{"grader_id":{"type":"string"},"error":{"type":"string","minLength":1}}}},
    "coverage_percent":{"type":"number","minimum":0,"maximum":100},"coverage_pass":{"type":"boolean"}
  }
}
