{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"p0-convergence-receipt-v4.schema.json",
  "title":"P0 Convergence Receipt V4",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","source_sha256","code_head_sha","configuration_id","configuration_sha256","clean_passes","grader_coverage_percent","critical","high","unresolved_medium","suspicious_confirmed","contradictions","unsupported_claims","critical_omissions","gate_proofs","human_review_ready","result"],
  "$defs":{
    "gateProof":{
      "type":"object","additionalProperties":false,
      "required":["schema_version","gate","executed","result","exit_code","source_sha256","code_head_sha","configuration_sha256","details","evidence_sha256"],
      "properties":{
        "schema_version":{"const":"p0-v4-gate-proof/v1"},
        "gate":{"enum":["regression_suite","adversarial_suite","source_sha_binding","artifact_hash_chain"]},
        "executed":{"const":true},
        "result":{"const":"PASS_WITH_EVIDENCE"},
        "exit_code":{"const":0},
        "source_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "code_head_sha":{"type":"string","pattern":"^[0-9a-f]{40}$"},
        "configuration_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "details":{"type":"object"},
        "evidence_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}
      }
    }
  },
  "properties":{
    "schema_version":{"const":"p0-convergence-receipt-v4/v2"},
    "source_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "code_head_sha":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "configuration_id":{"type":"string","minLength":1},
    "configuration_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "clean_passes":{"type":"array","minItems":2,"items":{"type":"object","additionalProperties":false,"required":["pass_id","reader_execution_id","omission_sweep_execution_id","omission_sweep_sha256","candidate_sha256","coverage_receipt_sha256","grader_execution_ids"],"properties":{"pass_id":{"type":"string"},"reader_execution_id":{"type":"string"},"omission_sweep_execution_id":{"type":"string","minLength":1},"omission_sweep_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"candidate_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"coverage_receipt_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"grader_execution_ids":{"type":"array","minItems":9,"uniqueItems":true,"items":{"type":"string"}}}}},
    "grader_coverage_percent":{"type":"number","minimum":0,"maximum":100},
    "critical":{"type":"integer","minimum":0},"high":{"type":"integer","minimum":0},"unresolved_medium":{"type":"integer","minimum":0},"suspicious_confirmed":{"type":"integer","minimum":0},"contradictions":{"type":"integer","minimum":0},"unsupported_claims":{"type":"integer","minimum":0},"critical_omissions":{"type":"integer","minimum":0},
    "gate_proofs":{
      "type":"object","additionalProperties":false,
      "required":["regression_suite","adversarial_suite","source_sha_binding","artifact_hash_chain"],
      "properties":{
        "regression_suite":{"$ref":"#/$defs/gateProof"},
        "adversarial_suite":{"$ref":"#/$defs/gateProof"},
        "source_sha_binding":{"$ref":"#/$defs/gateProof"},
        "artifact_hash_chain":{"$ref":"#/$defs/gateProof"}
      }
    },
    "human_review_ready":{"type":"boolean"},
    "result":{"enum":["PASS_P0_V4_CLOSED_LOOP","BLOCKED_CONVERGENCE","BLOCKED_V4_DISCOVERY_RECALL","BLOCKED_DISCOVERY_COVERAGE","BLOCKED_GRADER_FAILURE","BLOCKED_REMEDIATION","BLOCKED_MAX_REMEDIATION_V4","BLOCKED_SECURITY","BLOCKED_PRIVACY","BLOCKED_DURABLE_PERSISTENCE"]}
  }
}
