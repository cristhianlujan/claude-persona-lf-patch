{
  "$schema":"http://json-schema.org/draft-07/schema#",
  "$id":"p0-handoff-compliance-report/v1",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","handoff_identifier","handoff_sha256","audited_sha","audit_execution_id","auditor_identity","total_sections","applicable_sections","sections_pass","sections_partial","sections_fail","sections_blocked","positive_coverage_rows_total","positive_coverage_rows_pass","negative_tests_required","negative_tests_executed","negative_tests_passed","definition_of_done_total","definition_of_done_passed","unresolved_gaps","remediation_cycles","regressions_added","forward_test","final_result","created_at"],
  "properties":{
    "schema_version":{"const":"p0-handoff-compliance-report/v1"},
    "handoff_identifier":{"type":"string","minLength":1},
    "handoff_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "audited_sha":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "audit_execution_id":{"type":"string","minLength":1},
    "auditor_identity":{"type":"string","minLength":1},
    "total_sections":{"type":"integer","minimum":53},
    "applicable_sections":{"type":"integer","minimum":1},
    "sections_pass":{"type":"integer","minimum":0},
    "sections_partial":{"type":"integer","minimum":0},
    "sections_fail":{"type":"integer","minimum":0},
    "sections_blocked":{"type":"integer","minimum":0},
    "positive_coverage_rows_total":{"const":60},
    "positive_coverage_rows_pass":{"type":"integer","minimum":0,"maximum":60},
    "negative_tests_required":{"const":28},
    "negative_tests_executed":{"type":"integer","minimum":0},
    "negative_tests_passed":{"type":"integer","minimum":0},
    "definition_of_done_total":{"type":"integer","minimum":1},
    "definition_of_done_passed":{"type":"integer","minimum":0},
    "unresolved_gaps":{"type":"array"},
    "remediation_cycles":{"type":"integer","minimum":0},
    "regressions_added":{"type":"array","items":{"type":"string"}},
    "forward_test":{"type":"object","required":["result","false_passes"],"properties":{"result":{"enum":["PASS","BLOCKED"]},"false_passes":{"type":"array"}},"additionalProperties":true},
    "final_result":{"enum":["PASS_HANDOFF_COMPLIANCE","BLOCKED_HANDOFF_COMPLIANCE"]},
    "created_at":{"type":"string","minLength":1}
  }
}
