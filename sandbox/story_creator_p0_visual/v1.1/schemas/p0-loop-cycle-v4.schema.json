{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"p0-loop-cycle-v4.schema.json","title":"P0 Loop Cycle V4","type":"object","additionalProperties":false,
  "required":["schema_version","cycle_id","pass_id","reader_execution_id","source_sha256","candidate_sha256","grader_execution_ids","coverage_receipt_sha256","finding_counts","material_findings","remediation_applied","targeted_reread_sha256","forced_full_reread_required","clean_pass_count_after","result"],
  "properties":{
    "schema_version":{"const":"p0-loop-cycle-v4/v1"},"cycle_id":{"type":"string","pattern":"^C-[A-Za-z0-9._-]+$"},"pass_id":{"type":"string","pattern":"^P-[A-Za-z0-9._-]+$"},"reader_execution_id":{"type":"string","minLength":1},
    "source_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"candidate_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "grader_execution_ids":{"type":"array","minItems":9,"uniqueItems":true,"items":{"type":"string","minLength":1}},"coverage_receipt_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
