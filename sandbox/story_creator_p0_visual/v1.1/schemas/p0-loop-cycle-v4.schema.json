    "material_findings":{"type":"integer","minimum":0},"remediation_applied":{"type":"boolean"},"targeted_reread_sha256":{"anyOf":[{"type":"string","pattern":"^[0-9a-f]{64}$"},{"type":"null"}]},"forced_full_reread_required":{"type":"boolean"},"clean_pass_count_after":{"type":"integer","minimum":0},
    "result":{"enum":["REMEDIATE_AND_RERUN","CLEAN_CONTINUE","CONVERGED","BLOCKED_MAX_REMEDIATION_V4","BLOCKED_CONVERGENCE","BLOCKED_GRADER_FAILURE","BLOCKED_DISCOVERY_COVERAGE"]}
  }
}
