{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "lf/p0/enriched-understanding.schema.json",
  "title": "P0 Enriched Understanding v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["visual_output_sha256", "visual_output_immutable", "auxiliary_claims", "confirmed_reading_order_claims", "pending_decisions"],
  "properties": {
    "visual_output_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "visual_output_immutable": {"const": true},
    "auxiliary_claims": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": false, "required": ["claim_id", "claim", "classification", "source_ref", "source_sha256"], "properties": {"claim_id": {"type": "string", "minLength": 3}, "claim": {"type": "string", "minLength": 3}, "classification": {"type": "string", "enum": ["CONFIRMED", "CONFLICT", "PENDING"]}, "source_ref": {"type": "string", "minLength": 3}, "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}
    },
    "confirmed_reading_order_claims": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": false, "required": ["basis", "element_ids", "auxiliary_source_ref"], "properties": {"basis": {"type": "string", "enum": ["CONFIRMED_BY_AXTREE", "CONFIRMED_BY_DOM"]}, "element_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "auxiliary_source_ref": {"type": "string", "minLength": 3}}}
    },
    "pending_decisions": {"type": "array", "items": {"type": "string", "minLength": 3}}
  }
}
