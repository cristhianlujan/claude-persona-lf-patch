{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Visual geometry profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "viewport_box_px",
    "viewport_box_normalized",
    "parent_box_relative",
    "center_px",
    "visible_fraction",
    "measurement_kind",
    "resolution_status",
    "confidence",
    "evidence_refs"
  ],
  "properties": {
    "viewport_box_px": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "viewport_box_normalized": {
      "type": "object",
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        }
      }
    },
    "parent_box_relative": {
      "type": "object",
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        }
      }
    },
    "center_px": {
      "type": "object",
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    },
    "aspect_ratio": {
      "type": [
        "number",
        "null"
      ]
    },
    "visible_fraction": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "clipping": {
      "enum": [
        "NOT_CLIPPED",
        "VISIBLE_CLIPPED"
      ]
    },
    "measurement_kind": {
      "const": "OBSERVED_PIXEL_GEOMETRY"
    },
    "resolution_status": {
      "enum": [
        "RESOLVED_OBSERVED",
        "REMEDIATION_REQUIRED"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
