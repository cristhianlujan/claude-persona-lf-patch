{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "p0-consolidated-visual-reading/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "execution_id", "source_image_refs", "source_sha256", "elements", "ui_structure", "created_at"],
  "properties": {
    "schema_version": {"const": "p0-consolidated-visual-reading/v1"},
    "execution_id": {"type": "string", "minLength": 1},
    "source_image_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "elements": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["element_id", "source_image_ref", "parent_id", "region", "element_type", "visible_text", "semantic_role", "visual_state", "classification", "confidence", "evidence_refs", "source_observation_refs", "uncertainty_codes", "machine_resolution_status"], "properties": {"element_id": {"type": "string", "minLength": 1}, "source_image_ref": {"type": "string", "minLength": 1}, "parent_id": {"type": ["string", "null"]}, "region": {"type": "object", "required": ["x", "y", "width", "height"], "properties": {"x": {"type": "number", "minimum": 0}, "y": {"type": "number", "minimum": 0}, "width": {"type": "number", "exclusiveMinimum": 0}, "height": {"type": "number", "exclusiveMinimum": 0}}, "additionalProperties": false}, "element_type": {"enum": ["SCREEN", "REGION", "CONTAINER", "BRAND_MARK", "TEXT", "HEADING", "PARAGRAPH", "LABEL", "INPUT", "SELECT", "CHECKBOX", "RADIO", "BUTTON", "LINK", "ICON", "PROGRESS_INDICATOR", "BADGE", "ILLUSTRATION", "DIVIDER", "SECURITY_INDICATOR", "LEGAL_DISCLOSURE", "UNKNOWN_VISUAL_ELEMENT"]}, "visible_text": {"type": ["string", "null"]}, "semantic_role": {"type": ["string", "null"]}, "visual_state": {"type": ["string", "null"]}, "classification": {"enum": ["CONFIRMED", "INFERRED", "NOT_OBSERVABLE"]}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "source_observation_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}, "uncertainty_codes": {"type": "array", "items": {"type": "string", "minLength": 1}}, "machine_resolution_status": {"enum": ["RESOLVED", "REMEDIATION_REQUIRED", "BLOCKED_SOURCE_QUALITY", "NOT_APPLICABLE"]}, "criticality_ref": {"type": ["string", "null"]}, "inference_basis": {"type": ["string", "null"]}}}},
    "ui_structure": {"type": "object", "required": ["visual_containment_tree", "visual_layer_graph", "candidate_reading_orders"], "properties": {"visual_containment_tree": {"type": "object"}, "visual_layer_graph": {"type": "array"}, "candidate_reading_orders": {"type": "array"}}, "additionalProperties": true},
    "created_at": {"type": "string", "minLength": 1}
  }
}
