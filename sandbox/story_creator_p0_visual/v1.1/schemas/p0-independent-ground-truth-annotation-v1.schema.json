{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"p0-independent-ground-truth-annotation-v1.schema.json",
  "title":"P0 Independent Human Ground Truth Annotation V1",
  "description":"Blind human ground-truth contract. annotation_sha256 is the SHA-256 of canonical JSON for the full annotation object excluding the entire review block; review then attests that immutable hash and provider readback separately. The reviewer reuses the already-governed P0_VISUAL_ADJUDICATOR role; no new reviewer-role taxonomy is introduced.",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","annotation_id","source","annotator","text_items","nontext_items","groups","review"],
  "properties":{
    "schema_version":{"const":"p0-independent-ground-truth-annotation/v1"},
    "annotation_id":{"type":"string","minLength":3},
    "source":{
      "type":"object","additionalProperties":false,
      "required":["source_id","drive_file_id","source_sha256","content_bytes","holdout","candidate_output_visible_to_annotator"],
      "properties":{
        "source_id":{"type":"string","minLength":3},
        "drive_file_id":{"type":"string","minLength":10},
        "source_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "content_bytes":{"type":"integer","minimum":1},
        "holdout":{"const":false},
        "candidate_output_visible_to_annotator":{"const":false}
      }
    },
    "annotator":{
      "type":"object","additionalProperties":false,
      "required":["identity","role","annotated_at"],
      "properties":{
        "identity":{"type":"string","minLength":3},
        "role":{"const":"INDEPENDENT_HUMAN_ANNOTATOR"},
        "annotated_at":{"type":"string","format":"date-time"}
      }
    },
    "text_items":{
      "type":"array",
      "items":{"type":"object","additionalProperties":false,"required":["truth_item_id","bbox_xywh","transcription_verbatim","material","surface_role","reading_order_index"],"properties":{
        "truth_item_id":{"type":"string","minLength":2},
        "bbox_xywh":{"$ref":"#/$defs/bbox"},
        "transcription_verbatim":{"type":"string"},
        "material":{"type":"boolean"},
        "surface_role":{"type":"string","minLength":1},
        "reading_order_index":{"type":"integer","minimum":0}
      }}
    },
    "nontext_items":{
      "type":"array",
      "items":{"type":"object","additionalProperties":false,"required":["truth_item_id","bbox_xywh","kind","material"],"properties":{
        "truth_item_id":{"type":"string","minLength":2},
        "bbox_xywh":{"$ref":"#/$defs/bbox"},
        "kind":{"type":"string","minLength":1},
        "material":{"type":"boolean"}
      }}
    },
    "groups":{
      "type":"array",
      "items":{"type":"object","additionalProperties":false,"required":["group_id","member_truth_item_ids"],"properties":{
        "group_id":{"type":"string","minLength":2},
        "member_truth_item_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":2}}
      }}
    },
    "review":{
      "type":"object","additionalProperties":false,
      "required":["reviewer_identity","reviewer_role","source_sha256","annotation_sha256","reviewed_at","provider_readback_ref"],
      "properties":{
        "reviewer_identity":{"type":"string","minLength":3},
        "reviewer_role":{"const":"P0_VISUAL_ADJUDICATOR"},
        "source_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "annotation_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$","description":"SHA-256 of canonical JSON for the annotation object with the entire review block excluded."},
        "reviewed_at":{"type":"string","format":"date-time"},
        "provider_readback_ref":{"type":"string","minLength":8}
      }
    }
  },
  "$defs":{"bbox":{"type":"array","prefixItems":[{"type":"integer","minimum":0},{"type":"integer","minimum":0},{"type":"integer","minimum":1},{"type":"integer","minimum":1}],"items":false,"minItems":4,"maxItems":4}}
}
