    "PROFILE_EXECUTION_RUNTIME",
    "EJECUCION_PERFIL_LF",
    "CAPABILITY_EXECUTION_CONTRACT_V1",
    "ORCHESTRATOR_EXECUTION_GUARD_V1"
  ],
  "steps": [
    {"order":0,"step_id":"init_execution","required_evidence":["execution_id","parent_execution_id"]},
    {"order":10,"step_id":"bind_parent_skill_execution","required_evidence":["parent_execution_id","parent_operation_code","skill_code","source_revision"]},
    {"order":20,"step_id":"load_next_step_contract","required_evidence":["step_id","worker_role","allowed_worker_kinds","step_contract_digest"]},
    {"order":30,"step_id":"resolve_worker","required_evidence":["worker_resolution_digest","worker_ref","worker_kind","binding_authority_ref","binding_revision"]},
    {"order":40,"step_id":"resolve_task_runtime_binding","required_evidence":["task_binding_applicability","task_runtime_binding_digest"]},
    {"order":50,"step_id":"build_task_packet_seed","required_evidence":["task_packet_work_digest","task_packet_seed_ref"]},
    {"order":60,"step_id":"reserve_child_execution","required_evidence":["child_execution_id","child_request_sha256","child_manifest_digest"]},
    {"order":70,"step_id":"issue_dispatch_receipt","required_evidence":["dispatch_receipt_ref","dispatch_receipt_sha256","plan_digest"]},
    {"order":80,"step_id":"entry_guard_readback","required_evidence":["entry_guard_decision","entry_guard_code","dispatch_receipt_ref"]},
    {"order":90,"step_id":"finalize_task_packet","required_evidence":["final_task_packet_digest","task_packet_work_digest","static_projection_match"]},
    {"order":100,"step_id":"dispatch_worker","required_evidence":["worker_dispatch_ref","child_execution_id","worker_kind"]},
    {"order":110,"step_id":"collect_worker_result","required_evidence":["worker_result_ref","child_execution_id","output_digest"]},
    {"order":120,"step_id":"step_judge_handoff","required_evidence":["step_judge_ref","judge_execution_ref","judge_independent"]},
    {"order":130,"step_id":"checkpoint_or_close","required_evidence":["checkpoint_digest","next_step_or_close","no_runtime_activation","no_production_activation"]}
  ],
  "fail_closed": {
