  "lifecycle_state_code": "OP_CANDIDATE",
  "purpose": "Coordinate delegated Skill steps using existing Router, currentness, worker resolution, child execution, dispatch receipt, Profile Runtime and independent step judges without becoming a second Skill or Profile runtime.",
  "parent_contract": {
    "required_parent_operation": "EJECUCION_SKILL_LF",
