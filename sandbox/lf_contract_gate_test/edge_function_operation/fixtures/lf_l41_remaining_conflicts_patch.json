    {
      "kind": "RULE",
      "code": "B2B-RULE-AUTH-044",
      "source_state": "CANDIDATO",
      "source_sha256": "5db7e9d1f25faab2aab97a67ab46e890e36f2f1479aad6e5c42e18064580f043",
      "reason": "Texto Brevo exclusivo omite contingencia Intico manual autorizada, susceptible de interpretarse como canal único.",
      "new_description": "El canal primario del OTP B2B es correo Brevo Transactional Email desde LF server-side; la aceptación del proveedor solo significa ACCEPTED_PENDING_DELIVERY, no DELIVERED ni OTP verificado. Si el usuario ya actualizó el correo y el OTP no llega, únicamente soporte tras llamada del usuario, con permiso can_enable_sms_contingency, puede habilitar y auditar manualmente SMS Intico como contingencia; nunca por fallo, webhook, temporizador, timeout o rebote automático, ni por selección del navegador. Un OTP entregado por SMS requiere verificación LF server-side antes de sesión u operación y no permite bypass. AUTH-045 autentica exclusivamente el webhook de entrega Brevo y sus eventos, sin autorizar eventos de Intico bajo ese contrato; la integración/confirmación de entrega Intico continúa pendiente de validación técnica. La entrega Brevo registra eventos API/webhook append-only en lf_ops.otp_entrega_eventos con correlation_id, operación OTP, provider_id, messageId técnico, tipo, estado y tiempos, sin código OTP, correo completo ni payload crudo. Los reintentos de webhook son idempotentes y nunca duplican efectos. Aplicable a las operaciones B2B canónicas existentes 4 y 5 según sus contextos; recuperación asistida y cambio de correo/teléfono requieren homologación de operación, no IDs nuevos inventados.",
      "config_patch": {
        "primary_delivery_channel": "EMAIL",
        "primary_delivery_provider": "BREVO",
        "sms_contingency_provider": "INTICO",
        "sms_contingency_activation": "SUPPORT_CALL_AFTER_EMAIL_UPDATED_AND_OTP_NOT_RECEIVED",
        "sms_contingency_support_permission": "can_enable_sms_contingency",
        "sms_contingency_manual_approval": "REQUIRED",
        "sms_contingency_audit": "REQUIRED",
