          "email_otp_policy_code": "OTP_POL_B2B_AUTH_EMAIL_BREVO",
          "mfa_required_error_id": 23,
          "production_authorized": false,
          "local_identity_decision": "PENDING_ADR_003_M1_SPIKE",
          "authorization_before_mfa": "DENY",
          "factor_security_policy_id": 19,
          "numeric_thresholds_in_rule": "DENY",
          "email_otp_challenge_rule_id": 453,
          "totp_enrollment_normal_flow": "DENY",
          "legacy_totp_enrollment_rule_id": 454,
          "architecture_alignment_decision": "DEC-B2B-AUTH-PLATFORM-ALIGNMENT-001",
          "authenticated_session_before_mfa": "DENY",
          "legacy_totp_enrollment_screen_id": 55,
          "client_can_promote_authentication": "DENY"
