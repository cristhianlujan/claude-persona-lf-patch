          "password_only_fallback": "DENY",
          "local_identity_decision": "PENDING_ADR_003_M1_SPIKE",
          "non_admin_recovery_mode": "PENDING_FUNCTIONAL_DEFINITION_EMAIL_ACCESS_RECOVERY",
          "future_profile_assignment": "ADD_PROFILE_PERMISSION_RELATION",
          "admin_recovery_profile_ids": [
            1,
            2
          ],
          "numeric_thresholds_in_rule": "DENY",
          "unapproved_factor_fallback": "DENY",
          "mfa_applicability_policy_id": 3,
          "email_access_recovery_status": "PENDING_FUNCTIONAL_DEFINITION",
          "assisted_recovery_profile_ids": [
            3,
            4,
            5,
            6
          ],
          "identity_verification_required": true,
          "architecture_alignment_decision": "DEC-B2B-AUTH-PLATFORM-ALIGNMENT-001",
          "mfa_recovery_security_policy_id": 20,
          "emergency_access_user_selectable": "DENY",
          "authorized_recovery_actor_binding": "PERMISSION_BASED_DEFINED",
