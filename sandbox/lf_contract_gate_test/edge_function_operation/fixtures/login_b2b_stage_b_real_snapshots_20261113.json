          "promotion_condition": "PASSWORD_ATTEMPT_POLICY_CANONICALIZED",
          "password_value_change": "DENY",
          "credential_value_telemetry": "DENY"
        },
        "es_transversal": false,
        "pendiente_detalle": "PENDING_DEPENDENCY_PASSWORD_ATTEMPT_POLICY: no existe aún una política canónica específica de intentos de contraseña a la cual vincular el aviso. No promover ni implementar como requisito aislado hasta resolver esa dependencia.",
        "pendiente_decision": true
