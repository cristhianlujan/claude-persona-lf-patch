          "admin_local_password_fallback": "DENY_IN_PRODUCTION",
          "non_admin_delivery_provider_status": "PENDING_CREDENTIALS_IMPLEMENTATION",
          "admin_phishing_resistant_requirement": "PASSKEY_OR_SECURITY_KEY",
          "supabase_native_aal2_claim_for_email_otp": "DENY"
        },
        "es_transversal": false,
        "pendiente_detalle": "PENDING_IMPLEMENTATION: Google Workspace fue seleccionado como IdP administrativo pero aún no está aprovisionado. Falta tenant/dominio, metadata SAML, configuración en Supabase Auth y prueba end-to-end antes de producción.",
        "pendiente_decision": false
