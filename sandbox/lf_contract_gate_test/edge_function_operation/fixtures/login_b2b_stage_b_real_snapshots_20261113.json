          "current_authorized_recovery_profile_ids": [
            1
          ],
          "factor_revocation_or_replacement_required": true
        },
        "es_transversal": false,
        "pendiente_detalle": "PENDING_FUNCTIONAL_DEFINITION + IMPLEMENTATION_QA: para perfiles no administradores falta definir la recuperación segura cuando el usuario pierde acceso al correo usado por OTP. No se habilita bypass por contraseña ni se reutiliza el flujo TOTP legado. La autorización privilegiada existente permanece separada.",
        "pendiente_decision": false
      },
      "sha256": "f17060b3b5c28a4c6b1736a5b78673c3951aebac6623b3dd1b7f16245f6cc18c"
    },
    {
      "snapshot": {
        "id": 577,
        "razon": "Mantener el aviso como mejora de prevención vinculada al control de intentos y no como detalle visual aislado.",
        "codigo": "B2B-RULE-AUTH-047",
        "estado": "CANDIDATO",
        "origen": "OWNER_RECONCILIATION_2026_08_20",
        "titulo": "Aviso de Bloq Mayús ligado a política de intentos de contraseña",
