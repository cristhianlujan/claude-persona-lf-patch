    {
      "snapshot": {
        "id": 439,
        "razon": "Evitar que la recuperación se convierta en la ruta más débil de autenticación y separar claramente la recuperación individual de la continuidad operativa de emergencia.",
        "codigo": "B2B-RULE-AUTH-020",
        "estado": "CANDIDATO",
        "origen": "LF_BACKOFFICE_AUTH_V1_LOTE_3C",
        "titulo": "Recuperación del segundo control sin bypass",
        "categoria": "SECURITY",
        "created_at": "2026-08-12T05:56:19.239592+00:00",
        "created_by": "ChatGPT",
        "updated_at": "2026-10-15T03:05:25.56612+00:00",
        "descripcion": "Si un usuario sujeto al segundo control por correo pierde acceso a su correo, el Login no puede degradar a contraseña sola ni habilitar un bypass. Para perfiles no administradores, la recuperación de acceso al correo queda PENDING_FUNCTIONAL_DEFINITION y debe resolverse en flujo separado con validación de identidad y auditoría antes de producción. Para administradores la recuperación continúa en Google Workspace. Si se perdio el control del correo o existe sospecha de compromiso, reenviar un OTP al mismo buzon no aporta verificacion independiente. Para los perfiles no administradores debe aplicarse un procedimiento de identidad separado, auditable y aun PENDING_FUNCTIONAL_DEFINITION, bajo la politica central de recuperacion ID 20, sin autorizar acceso operativo ni bypass.",
        "valor_config": {
          "recovery_flow": "SEPARATE",
          "audit_required": true,
          "backend_runtime": "SPRING_BOOT_CORE",
          "decision_status": "CLOSED_IMPLEMENTATION_PENDING",
          "frontend_runtime": "NEXTJS_STATIC_EXPORT",
          "provider_binding": "OIDC_PROVIDER_PENDING_M1_SPIKE",
          "identity_protocol": "OIDC_JWT",
          "admin_recovery_mode": "GOOGLE_WORKSPACE_IDP_MANAGED",
