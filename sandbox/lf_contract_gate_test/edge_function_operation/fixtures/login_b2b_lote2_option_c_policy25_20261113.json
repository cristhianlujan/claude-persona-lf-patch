        "ddl": "CREATE TRIGGER trg_politicas_seguridad_touch_updated_at BEFORE UPDATE ON lf_ops.politicas_seguridad FOR EACH ROW EXECUTE FUNCTION lf_ops.touch_updated_at()"
      }
    ]
  },
