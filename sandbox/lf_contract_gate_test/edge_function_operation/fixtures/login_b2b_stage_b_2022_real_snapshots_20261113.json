    {
      "snapshot": {
        "id": 440,
        "razon": "Reducir fuerza bruta, password spraying y credential stuffing sin convertir el mecanismo de defensa en una herramienta de denegación de servicio contra usuarios legítimos, y mantener todos los umbrales en fuentes reutilizables.",
        "codigo": "B2B-RULE-AUTH-021",
        "estado": "CANDIDATO",
        "origen": "LF_BACKOFFICE_AUTH_V1_LOTE_4",
        "titulo": "Protección adaptativa contra abuso de autenticación",
        "categoria": "SECURITY",
        "created_at": "2026-08-12T05:57:22.737964+00:00",
        "created_by": "ChatGPT",
        "updated_at": "2026-09-29T15:42:08.778738+00:00",
        "descripcion": "Cada intento de Login debe pasar por los controles centrales de rate limit, anti-bot y protección contra abuso antes de que una respuesta de autenticación pueda conceder acceso. La evaluación puede combinar señales de red/IP, cuenta resuelta cuando exista, patrón de solicitudes, riesgo de automatización y contexto técnico permitido. No se debe depender de un único contador ni bloquear definitivamente una cuenta solo por una señal que un atacante pueda provocar. Los límites numéricos se obtienen exclusivamente de las políticas centrales y no se almacenan en esta regla.",
        "valor_config": {
          "backend_runtime": "SPRING_BOOT_CORE",
          "strategy_status": "CLOSED_CALIBRATION_PENDING",
          "frontend_runtime": "NEXTJS_STATIC_EXPORT",
