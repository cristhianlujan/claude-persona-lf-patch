          "rate_limit_policy_id": 1,
          "production_authorized": false,
          "local_identity_decision": "PENDING_ADR_003_M1_SPIKE",
          "abuse_security_policy_id": 22,
          "numeric_thresholds_in_rule": "DENY",
          "anti_bot_security_policy_id": 17,
          "architecture_alignment_decision": "DEC-B2B-AUTH-PLATFORM-ALIGNMENT-001",
          "single_signal_permanent_lockout": "DENY",
          "provider_specific_error_passthrough": "DENY"
        },
        "es_transversal": false,
        "pendiente_detalle": "PENDING_PROVIDER_CALIBRATION: la estrategia de defensa está cerrada. Smart lockout/risk scoring y umbrales adicionales se calibran con señales reales del proveedor y métricas operativas; las cantidades permanecen en políticas centrales.",
        "pendiente_decision": false
      },
      "sha256": "1a5baffd46f829c33e4d7583370b89644ea6b76e79c66a35ff4f246cf278a615"
