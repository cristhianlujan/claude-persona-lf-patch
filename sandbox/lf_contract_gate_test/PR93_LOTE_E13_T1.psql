\set ON_ERROR_STOP on

\if :{?E13_HEAD_SHA}
\else
\echo 'E13_HEAD_SHA_REQUIRED'
do $e13_t1_head_guard$
begin
  raise exception 'E13_HEAD_SHA_REQUIRED';
end
$e13_t1_head_guard$;
\endif

\echo 'E13_T1_BEGIN'
\echo E13_T1_HEAD_SHA=:E13_HEAD_SHA
begin;
set transaction read only, isolation level repeatable read;
set local search_path = pg_catalog;

\echo 'E13_T1_CORRELATION_BEFORE_SNAPSHOT'
\ir PR93_LOTE_E10_CORRELATION_READBACK.sql

\echo 'E13_T1_OPTIONAL_SYSTEM_IDENTIFIER_CAPABILITY'
select case
  when pg_catalog.to_regprocedure('pg_catalog.pg_control_system()') is not null
   and pg_catalog.has_function_privilege(
     current_user,
     'pg_catalog.pg_control_system()',
     'EXECUTE'
   )
  then 'true'
  else 'false'
end as e13_system_identifier_available
\gset

\if :e13_system_identifier_available
\echo 'E13_T1_OPTIONAL_SYSTEM_IDENTIFIER_PROBE'
\ir PR93_LOTE_E11_SYSTEM_IDENTIFIER_PROBE.sql
\else
\echo 'E13_T1_OPTIONAL_SYSTEM_IDENTIFIER_SKIPPED_NO_PRIVILEGE'
\endif

\echo 'E13_T1_EXECUTION_CONTEXT_SNAPSHOT'
\ir PR93_LOTE_E8_EXECUTION_CONTEXT_READBACK.sql

\echo 'E13_T1_CORRELATION_BEFORE_PREFLIGHT'
\ir PR93_LOTE_E10_CORRELATION_READBACK.sql

\echo 'E13_T1_DEPENDENCY_PREFLIGHT'
\ir PR93_LOTE_E6_DEPENDENCY_PREFLIGHT.sql

\echo 'E13_T1_PRIMARY_25_VECTOR_READBACK'
\ir PR93_LOTE_C_EVIDENCE_READBACK.sql

\echo 'E13_T1_CORRELATION_BEFORE_ADDENDUM'
\ir PR93_LOTE_E10_CORRELATION_READBACK.sql

\echo 'E13_T1_FINAL_INTEGRITY_ADDENDUM'
\ir PR93_LOTE_E5_FINAL_INTEGRITY_READBACK.sql

rollback;
\echo 'E13_T1_ROLLBACK_COMPLETE'
