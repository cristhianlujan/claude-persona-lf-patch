    "efficiency": ["input_tokens", "output_tokens", "latency_ms", "tool_calls_or_queries", "duplicate_reads", "retries"],
    "model_telemetry_rule": "IF_MODEL_BASED_AND_INPUT_OUTPUT_TOKEN_TELEMETRY_IS_NOT_OBSERVABLE_THEN_PROMOTION_REMAINS_BLOCKED; DO_NOT_ESTIMATE_OR_INVENT TOKENS"
  },
  "acceptance_floor": {
    "hard_invariants": "ALL_APPLICABLE_HARD_INVARIANTS_PASS",
    "material_false_pass": "ZERO_ON_QUALIFICATION_AND_HOLDOUT_CASES",
    "material_omission": "ZERO_KNOWN_MATERIAL_OMISSIONS",
    "contradiction_behavior": "PRESERVE_AND_ESCALATE_OR_BLOCK; NEVER_FORCE_PASS",
    "unknown_behavior": "EXPLICIT_UNKNOWN_OR_TARGETED_EVIDENCE; NEVER_SILENT_DEFAULT_PASS",
    "traceability": "EVERY_MATERIAL_SELECTION_HAS_REASON_AND_EVIDENCE_REF",
    "efficiency": "MEASURED_AND_REPORTED; QUALITY_OR_HARD_INVARIANTS_MAY_NOT_BE_TRADED_AWAY FOR COST",
    "first_champion_rule": "A candidate satisfying every hard floor may become first Champion only after exact identity/currentness, adversarial and sealed-holdout evidence are complete."
  },
