    {
      "layer": "BOUNDARY",
      "visibility": "OPEN_BEFORE_FREEZE",
      "purpose": "Exercise near-boundary cases where multiple options remain plausible."
    },
    {
      "layer": "ADVERSARIAL",
      "visibility": "OPEN_BEFORE_FREEZE",
      "purpose": "Exercise stale, contradictory, misleading, sparse and false-green-prone inputs."
    },
    {
      "layer": "SEALED_HOLDOUT",
      "visibility": "MATERIALIZE_ONLY_AFTER_EXACT_CANDIDATE_FREEZE",
      "purpose": "Test generalization without tuning leakage."
    }
  ],
  "sealed_holdout": {
    "source_storage": "SUPABASE_APPEND_ONLY_EVENT_OR_BENCHMARK_AUTHORITY",
    "source_repo_must_not_contain_prompt_before_execution": true,
    "minimum_structural_coverage_per_family": ["CLEAR_OR_STANDARD", "AMBIGUOUS_OR_CONTRADICTORY", "NO_SIGNAL_OR_ADVERSARIAL"],
    "prompt_digest_required": true,
    "exact_candidate_binding_required": true,
    "oracle_open_after_raw_freeze": true,
    "no_training_or_tuning_after_open": true
  },
  "measurement": {
    "quality": ["ground_truth_match_when_defined", "false_pass", "false_block", "material_omission", "contradiction_detection", "traceability_completeness", "unknown_preservation"],
