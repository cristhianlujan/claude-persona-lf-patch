{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ASSET_COMPOSITION_V1",
  "title": "LF Asset Composition Projection Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "asset_ref", "authority", "scope", "components"],
  "properties": {
    "schema_version": {"const": "ASSET_COMPOSITION_V1"},
    "asset_ref": {"type": "string", "pattern": "^asset://[A-Za-z0-9._:-]+$"},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_ref", "source_sha256", "source_version", "authority_class"],
      "properties": {
        "source_ref": {"type": "string", "minLength": 5},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_version": {"type": "string", "minLength": 1},
        "authority_class": {"enum": ["CANONICAL_ARTIFACT", "CANONICAL_REGISTRY", "CANONICAL_METADATA"]}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "component_codes"],
      "properties": {
        "mode": {"enum": ["COMPLETE_ASSET", "COMPONENT_SET"]},
        "component_codes": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{1,127}$"},
          "uniqueItems": true
        }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component_code", "component_type", "order", "status", "members"],
        "properties": {
          "component_code": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{1,127}$"},
          "component_type": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{1,127}$"},
          "order": {"type": "integer", "minimum": 0},
          "status": {"type": "string", "minLength": 1},
          "members": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["member_ref", "role", "membership_class", "required"],
              "properties": {
                "member_ref": {"type": "string", "minLength": 5},
                "role": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{1,127}$"},
                "membership_class": {"enum": ["CANONICAL_ARTIFACT", "PHYSICAL_OBJECT", "CANDIDATE_OBJECT", "SUPPORTING_OBJECT"]},
                "required": {"type": "boolean"}
              }
            }
          }
        }
      }
    }
  }
}
