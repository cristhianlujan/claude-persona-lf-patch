{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "objective",
    "expected_change",
    "human_story",
    "functional_contract",
    "scope",
    "cases",
    "dependency_resolution",
    "dependency_task_ids",
    "required_tests",
    "required_evidence",
    "blocked_if",
    "base_head_sha",
    "source_snapshot_sha256",
    "context_path_patterns",
    "write_path_patterns",
    "protected_path_patterns",
    "files_expected",
    "platform_refs",
    "interface_refs",
    "acceptance_commands",
    "max_attempts",
    "max_patch_bytes",
    "max_changed_files",
    "max_context_bytes",
    "allow_deletions"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "task_id": {
      "type": "string"
    },
    "objective": {
      "type": "string"
    },
    "expected_change": {
      "type": "string"
    },
    "human_story": {
      "type": "string"
    },
    "functional_contract": {
      "type": "object"
    },
    "scope": {
      "type": "object"
    },
    "cases": {
      "type": "array"
    },
    "dependency_resolution": {
      "type": "object"
    },
    "dependency_task_ids": {
      "type": "array"
    },
    "required_tests": {
      "type": "array",
      "minItems": 1
    },
    "required_evidence": {
      "type": "array"
    },
    "blocked_if": {
      "type": "array"
    },
    "base_head_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "source_snapshot_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "context_path_patterns": {
      "type": "array"
    },
    "write_path_patterns": {
      "type": "array"
    },
    "protected_path_patterns": {
      "type": "array"
    },
    "files_expected": {
      "type": "array"
    },
    "platform_refs": {
      "type": "array"
    },
    "interface_refs": {
      "type": "array"
    },
    "acceptance_commands": {
      "type": "array",
      "minItems": 1
    },
    "max_attempts": {
      "type": "integer"
    },
    "max_patch_bytes": {
      "type": "integer"
    },
    "max_changed_files": {
      "type": "integer"
    },
    "max_context_bytes": {
      "type": "integer"
    },
    "allow_deletions": {
      "const": false
    }
  }
}
