{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Frontend Angular Worker visible specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_code",
    "profile_assignment_sha256",
    "task_id",
    "objective",
    "expected_change",
    "human_story",
    "functional_contract",
    "scope",
    "cases",
    "dependency_resolution",
    "dependency_task_ids",
    "required_tests",
    "required_evidence",
    "blocked_if",
    "base_head_sha",
    "source_snapshot_sha256",
    "context_path_patterns",
    "write_path_patterns",
    "protected_path_patterns",
    "files_expected",
    "platform_refs",
    "interface_refs",
    "acceptance_commands",
    "max_attempts",
    "max_patch_bytes",
    "max_changed_files",
    "max_context_bytes",
    "allow_deletions"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "profile_code": {
      "const": "PERFIL-PROG-FRONTEND-EXP"
    },
    "profile_assignment_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "expected_change": {
      "type": "string",
      "minLength": 1
    },
    "human_story": {
      "type": "string",
      "minLength": 1
    },
    "functional_contract": {
      "type": "object"
    },
    "scope": {
      "type": "object",
      "required": [
        "in_scope",
        "out_of_scope",
        "must_not_change"
      ],
      "properties": {
        "in_scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "out_of_scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "must_not_change": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "cases": {
      "type": "array"
    },
    "dependency_resolution": {
      "type": "object"
    },
    "dependency_task_ids": {
      "type": "array"
    },
    "required_tests": {
      "type": "array",
      "minItems": 1
    },
    "required_evidence": {
      "type": "array"
    },
    "blocked_if": {
      "type": "array"
    },
    "base_head_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "source_snapshot_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "context_path_patterns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "write_path_patterns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "protected_path_patterns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "files_expected": {
      "type": "array"
    },
    "platform_refs": {
      "type": "array"
    },
    "interface_refs": {
      "type": "array"
    },
    "acceptance_commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "max_attempts": {
      "type": "integer",
      "minimum": 1
    },
    "max_patch_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "max_changed_files": {
      "type": "integer",
      "minimum": 1
    },
    "max_context_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "allow_deletions": {
      "const": false
    }
  }
}
