      "as_is_implementation_refs[]",
      "as_is_consumers[]",
      "as_is_dependencies[]"
    ],
    "new_requires": [
      "negative_existing_asset_evidence[]",
      "canonical_search_scope[]",
      "new_target_reason"
    ],
    "unknown_behavior": "NEED_MORE_EVIDENCE_OR_REQUIRES_DECISION",
    "existing_greenfield_redefinition_forbidden": true,
    "existing_delta_required_downstream": true,
    "technical_solution_selection_deferred_to_programming": true,
    "no_parallel_asset_resolver": true
