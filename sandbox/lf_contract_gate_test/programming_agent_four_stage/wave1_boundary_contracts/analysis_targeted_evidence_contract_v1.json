      "NEW",
      "UNKNOWN"
    ],
    "resolver_order": [
      "EXACT_TARGET_IDENTITY",
      "CURRENT_CANONICAL_ASSET",
      "CURRENT_IMPLEMENTATION",
      "RELATED_AUTHORITIES",
      "CONSUMERS_AND_DEPENDENCIES"
    ],
    "existing_requires": [
      "exact_target_ref",
      "target_revision_or_currentness_ref",
