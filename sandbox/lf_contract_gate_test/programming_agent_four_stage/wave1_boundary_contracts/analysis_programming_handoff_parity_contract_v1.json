    "lossy_material_projection_forbidden": true
  },
  "projection_policy": {
    "worker_projection_after_parity_only": true,
    "minimum_relevant_subset_allowed": true,
    "projection_must_preserve_source_refs": true,
    "projection_must_preserve_material_semantics": true,
    "projection_digest_required": true,
    "upstream_snapshot_mutation_forbidden": true
  },
  "receipt": {
