  "required_sections": [
    "request_identity",
    "change_classification",
    "research_context",
    "impact_map",
    "decision_context",
    "requirements",
    "specialist_results",
    "invariants_risk_quality",
    "hard_boundaries",
    "implementation_preconditions",
