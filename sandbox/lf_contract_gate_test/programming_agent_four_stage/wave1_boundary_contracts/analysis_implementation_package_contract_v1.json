    "persist_append_only": true,
    "preserve_decision_context_losslessly": true,
    "preserve_human_decision_packets_losslessly": true,
    "preserve_material_front_coverage_losslessly": true,
    "preserve_implementability_losslessly": true,
    "preserve_scope_readiness_losslessly": true
