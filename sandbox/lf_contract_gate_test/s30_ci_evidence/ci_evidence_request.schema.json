{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lf.local/contracts/ci_evidence_request.schema.json",
  "title": "LF CI Evidence Request V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_version",
    "repository_full_name",
    "candidate_head_sha",
    "base_sha",
    "target_branch",
    "pr_number",
    "evidence_purpose",
    "requirement_profile",
    "provider_receipts"
  ],
  "properties": {
    "request_version": {"const": "LF_CI_EVIDENCE_REQUEST_V1"},
    "repository_full_name": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "candidate_head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "target_branch": {"type": "string", "minLength": 1},
    "pr_number": {"type": ["integer", "null"], "minimum": 1},
    "evidence_purpose": {"enum": ["PRE_MERGE_CANDIDATE_VALIDATION", "PRE_MERGE_WITH_CURRENTNESS", "POST_MERGE_ARTIFACT_RECONCILIATION"]},
    "requirement_profile": {"enum": ["PRE_MERGE_STANDARD", "PRE_MERGE_WITH_CURRENTNESS", "POST_MERGE_ARTIFACT_RECONCILIATION"]},
    "provider_receipts": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "object"}
    }
  }
}
