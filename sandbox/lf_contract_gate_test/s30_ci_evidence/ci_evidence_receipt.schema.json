{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lf.local/contracts/ci_evidence_receipt.schema.json",
  "title": "LF CI Evidence Aggregate Receipt V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_version",
    "result",
    "repository_full_name",
    "candidate_head_sha",
    "base_sha",
    "target_branch",
    "pr_number",
    "evidence_purpose",
    "requirement_profile",
    "required_provider_codes",
    "verified_provider_codes",
    "missing_provider_codes",
    "duplicate_provider_codes",
    "provider_receipt_sha256",
    "findings",
    "claim_ceiling",
    "ci_evidence_complete",
    "e2e_closed",
    "qualification_closed",
    "semantic_review_closed",
    "merge_authorized",
    "runtime_authorized",
    "production_authorized",
    "golden_authorized",
    "receipt_sha256"
  ],
  "properties": {
    "receipt_version": {"const": "LF_CI_EVIDENCE_RECEIPT_V1"},
    "result": {"enum": ["PASS_CI_EVIDENCE_AGGREGATED", "BLOCK_CI_PROVIDER_MISSING", "BLOCK_CI_PROVIDER_DUPLICATE", "BLOCK_CI_PROVIDER_UNKNOWN", "BLOCK_CI_SUBJECT_MISMATCH", "BLOCK_CI_PROVIDER_RESULT_INVALID", "BLOCK_CI_CONTRACT_DEEP_PROOF_INVALID", "BLOCK_CI_CURRENTNESS_RECEIPT_INVALID", "BLOCK_CI_POST_MERGE_PROVIDER_INVALID"]},
    "repository_full_name": {"type": "string"},
    "candidate_head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "target_branch": {"type": "string"},
    "pr_number": {"type": ["integer", "null"]},
    "evidence_purpose": {"type": "string"},
    "requirement_profile": {"type": "string"},
    "required_provider_codes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "verified_provider_codes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "missing_provider_codes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "duplicate_provider_codes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "provider_receipt_sha256": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "findings": {"type": "array", "items": {"type": "string"}},
    "claim_ceiling": {"const": "CI_EVIDENCE_ONLY_NOT_DOMAIN_CLOSURE"},
    "ci_evidence_complete": {"type": "boolean"},
    "e2e_closed": {"const": false},
    "qualification_closed": {"const": false},
    "semantic_review_closed": {"const": false},
    "merge_authorized": {"const": false},
    "runtime_authorized": {"const": false},
    "production_authorized": {"const": false},
    "golden_authorized": {"const": false},
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
