{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lf.local/contracts/lf_gate_error_v1.schema.json",
  "title": "LF_GATE_ERROR_V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "producer",
    "schema_ref",
    "schema_sha256",
    "run_id",
    "job_id",
    "step_id",
    "gate_id",
    "gate_mode",
    "gate_result",
    "diagnostic_complete",
    "source_commit",
    "tested_commit",
    "source_path",
    "trace_id",
    "timestamp",
    "owner",
    "next_action",
    "checks",
    "manifest_sha256"
  ],
  "properties": {
    "contract": {"const": "LF_GATE_ERROR_V1"},
    "producer": {"const": "LF_GATE_CHECK_OBSERVABILITY_V1"},
    "schema_ref": {"type": "string", "minLength": 1},
    "schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "run_id": {"type": "string", "minLength": 1},
    "job_id": {"type": "string", "minLength": 1},
    "step_id": {"type": "string", "minLength": 1},
    "gate_id": {"type": "string", "minLength": 1},
    "gate_mode": {"enum": ["COLLECT_ALL", "FAIL_FAST_CRITICAL"]},
    "gate_result": {"enum": ["PASS", "FAIL", "BLOCKED"]},
    "diagnostic_complete": {"type": "boolean"},
    "error_id": {"type": ["string", "null"]},
    "error_class": {"type": ["string", "null"]},
    "condition": {"type": "string"},
    "expected": {"type": "object"},
    "actual": {"type": "object"},
    "source_commit": {"type": "string"},
    "tested_commit": {"type": "string"},
    "source_path": {"type": "array", "items": {"type": "string"}},
    "trace_id": {"type": "string", "minLength": 1},
    "parent_trace_id": {"type": ["string", "null"]},
    "rc": {"type": "integer"},
    "timestamp": {"type": "string", "minLength": 1},
    "started_at": {"type": "string"},
    "expected_check_ids": {"type": "array", "items": {"type": "string"}},
    "executed_check_ids": {"type": "array", "items": {"type": "string"}},
    "expected_check_count": {"type": "integer", "minimum": 0},
    "executed_check_count": {"type": "integer", "minimum": 0},
    "pass_count": {"type": "integer", "minimum": 0},
    "fail_count": {"type": "integer", "minimum": 0},
    "blocked_count": {"type": "integer", "minimum": 0},
    "remaining_after_fail_fast": {"type": "array", "items": {"type": "string"}},
    "downstream_impact": {"type": "array", "items": {"type": "string"}},
    "owner": {"type": "string", "minLength": 1},
    "next_action": {"type": "string", "minLength": 1},
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check_id",
          "check_status",
          "critical",
          "failure_id",
          "error_id",
          "error_class",
          "error_summary",
          "assertion_text",
          "condition",
          "expected",
          "actual",
          "command",
          "exit_code",
          "input_ref",
          "evidence_ref",
          "producer",
          "source_commit",
          "tested_commit",
          "source_path",
          "trace_id",
          "parent_trace_id",
          "rc",
          "timestamp",
          "started_at",
          "stdout_ref",
          "stderr_ref",
          "stdout_sha256",
          "stderr_sha256",
          "traceback_ref",
          "traceback_sha256",
          "traceback_present",
          "diagnostic_complete",
          "downstream_impact",
          "owner",
          "next_action"
        ],
        "properties": {
          "check_id": {"type": "string", "minLength": 1},
          "check_status": {"enum": ["PASS", "FAIL"]},
          "critical": {"type": "boolean"},
          "failure_id": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "error_id": {"type": ["string", "null"]},
          "error_class": {"type": ["string", "null"]},
          "error_summary": {"type": ["string", "null"]},
          "assertion_text": {"type": ["string", "null"]},
          "condition": {"type": "string"},
          "expected": {"type": "object"},
          "actual": {"type": "object"},
          "command": {"type": "array", "minItems": 2, "items": {"type": "string"}},
          "exit_code": {"type": "integer"},
          "input_ref": {"type": "string", "minLength": 1},
          "evidence_ref": {"type": "string", "minLength": 1},
          "producer": {"type": "string", "minLength": 1},
          "source_commit": {"type": "string"},
          "tested_commit": {"type": "string"},
          "source_path": {"type": "string", "minLength": 1},
          "trace_id": {"type": "string", "minLength": 1},
          "parent_trace_id": {"type": "string", "minLength": 1},
          "rc": {"type": "integer"},
          "timestamp": {"type": "string", "minLength": 1},
          "started_at": {"type": "string", "minLength": 1},
          "stdout_ref": {"type": "string", "minLength": 1},
          "stderr_ref": {"type": "string", "minLength": 1},
          "stdout_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "stderr_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "traceback_ref": {"type": ["string", "null"]},
          "traceback_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "traceback_present": {"type": "boolean"},
          "diagnostic_complete": {"type": "boolean"},
          "downstream_impact": {"type": "array", "items": {"type": "string"}},
          "owner": {"type": "string", "minLength": 1},
          "next_action": {"type": "string", "minLength": 1}
        }
      }
    },
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
