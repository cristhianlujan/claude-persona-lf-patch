{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lf.local/contracts/ekb_control_coverage.schema.json",
  "title": "LF EKB Control Coverage V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["coverage_version", "bindings"],
  "properties": {
    "coverage_version": {"const": "LF_EKB_CONTROL_COVERAGE_V1"},
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error_code",
          "control_mode",
          "control_ref",
          "status",
          "evidence_ref",
          "executed"
        ],
        "properties": {
          "error_code": {"type": "string", "minLength": 1},
          "control_mode": {
            "enum": ["DETERMINISTIC_CHECK", "PROCESS_EVIDENCE", "HUMAN_REVIEW"]
          },
          "control_ref": {"type": "string", "minLength": 1},
          "status": {"enum": ["PASS", "REVIEW_REQUIRED", "BLOCKED", "PENDING"]},
          "evidence_ref": {"type": ["string", "null"]},
          "executed": {"type": "boolean"},
          "evidence_sha256": {
            "type": ["string", "null"],
            "pattern": "^[0-9a-f]{64}$"
          },
          "code_head_sha": {
            "type": ["string", "null"],
            "pattern": "^[0-9a-f]{40}$"
          },
          "notes": {"type": ["string", "null"]}
        }
      }
    }
  }
}
