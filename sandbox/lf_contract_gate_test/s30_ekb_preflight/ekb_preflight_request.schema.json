{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lf.local/contracts/ekb_preflight_request.schema.json",
  "title": "LF EKB Preflight Request V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_version",
    "operation_code",
    "execution_id",
    "lifecycle_phases",
    "consumer_roles",
    "required_codes"
  ],
  "properties": {
    "request_version": {"const": "LF_EKB_PREFLIGHT_REQUEST_V1"},
    "operation_code": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
    "execution_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "lifecycle_phases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 128}
    },
    "consumer_roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 128}
    },
    "required_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 256}
    }
  }
}
