{
  "schema_version": "SRCR_V07_DYNAMIC_METHOD_CATALOG_V1",
  "profile_pack_id": "SYSTEMIC_ROOT_CAUSE_REPAIR_LF_V0_7_CANDIDATE",
  "selection_principle": "typed_signals_not_domain_names",
  "mandatory_core": [
    "AUTHORITY_CURRENTNESS",
    "PHYSICAL_REACHABILITY_WIRING",
