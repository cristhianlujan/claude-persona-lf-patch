{
  "schema_version": "LF_MATERIAL_FRONT_COVERAGE_METHOD_CONTRACT_V5",
  "status": "CANDIDATE_READ_ONLY",
  "runtime_authorized": false,
  "production_authorized": false,
  "purpose": "Derive material-front coverage decisions from raw facts and provider receipts. Never treat inspect/investigate prose as a method.",
  "terminal_precedence": [
    "STRUCTURAL_INTEGRITY",
    "EVIDENCE_SUFFICIENCY",
    "KNOWN_COVERAGE_VIOLATION",
    "PASS"
  ],
  "terminal_states": [
    "MATERIAL_FRONT_COVERAGE_PASS",
    "MATERIAL_FRONT_COVERAGE_BLOCKED",
    "RETURN_TO_EVIDENCE_ACQUISITION"
  ],
  "selector": {
    "strong": "signal.current=true AND signal.subject_bound=true AND signal.directness=DIRECT AND evidence_ref resolves",
    "weak": "signal.current=true AND signal.subject_bound=true AND signal.directness=INDIRECT AND evidence_ref resolves",
    "unresolved": "current=false OR subject_bound=false OR unresolved evidence => RETURN_TO_EVIDENCE_ACQUISITION",
    "activation_threshold": 2,
    "weak_independence_rule": "Two WEAK signals count only when derived_evidence_group differs.",
    "derived_evidence_group": "sha256(provider|authority_ref|source_subject_digest); caller-supplied independence_group is ignored."
  },
  "convergence": {
    "count": "Every selector/reselector evaluation increments reselection_count.",
    "pass_at_limit": "Allowed when converged=true on the final allowed evaluation.",
    "block": "If another evaluation is required after max_reselection_rounds, block NON_CONVERGENT_COVERAGE_BUDGET_EXHAUSTED.",
    "reopen_count": "Tracked separately for diagnostics; it is not the sole convergence counter."
  },
  "low_risk_six_axes": [
    "root_cause",
    "repair_topology",
    "blast_radius",
    "acceptance_criteria",
    "rollback_recovery",
    "terminality_lifecycle"
  ],
  "low_risk_precedence": "CAN_CHANGE dominates UNRESOLVED. Any CAN_CHANGE => MATERIAL. Otherwise any UNRESOLVED => RETURN_TO_EVIDENCE_ACQUISITION. All NO_CHANGE_PROVEN => LOW_RISK_CLOSED.",
  "challenger": {
    "required_for_closure": true,
    "producer_execution_must_differ": true,
    "executor_identity_must_differ": true,
    "subject_revision_must_match": true,
    "provider_bound_independence_receipt_required": true,
    "self_attested_boolean_forbidden": true,
    "unsupported_independence_scope": "BLOCK"
  },
