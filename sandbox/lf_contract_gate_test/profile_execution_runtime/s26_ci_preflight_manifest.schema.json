{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lf.local/schemas/s26_ci_preflight_manifest.schema.json",
  "title": "S26 CI Cheap Preflight Manifest",
  "type": "object",
  "required": [
    "schema", "run_scope", "required_files", "required_scripts", "required_validators",
    "schemas", "authority_sources", "bindings", "inputs", "workflow_guards"
  ],
  "properties": {
    "schema": {"const": "S26_CI_PREFLIGHT_MANIFEST_V1"},
    "run_scope": {"const": "S26"},
    "required_files": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "required_scripts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "required_validators": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "schemas": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "authority_sources": {"type": "array", "minItems": 2, "items": {"type": "object"}},
    "bindings": {"type": "array", "minItems": 2, "items": {"type": "object"}},
    "inputs": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "workflow_guards": {"type": "array", "minItems": 1, "items": {"type": "object"}}
  },
  "additionalProperties": false
}
