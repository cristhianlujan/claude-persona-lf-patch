{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lf.local/schemas/s26_ci_preflight_manifest.schema.json",
  "title": "S26 CI Cheap Preflight Manifest",
  "type": "object",
  "required": [
    "schema", "run_scope", "execution_scope_id", "required_files", "required_scripts", "required_validators",
    "schemas", "authority_sources", "bindings", "inputs", "workflow_guards", "integrity_pins"
  ],
  "properties": {
    "schema": {"const": "S26_CI_PREFLIGHT_MANIFEST_V1"},
    "run_scope": {"const": "S26"},
    "execution_scope_id": {"const": "S26-CI-PREFLIGHT-V1"},
    "required_files": {
      "type": "array", "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "required_scripts": {
      "type": "array", "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "required_validators": {
      "type": "array", "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "schemas": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "schema_role", "run_id"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "schema_role": {"const": "PREFLIGHT_MANIFEST"},
          "run_id": {"const": "S26-CI-PREFLIGHT-V1"}
        },
        "additionalProperties": false
      }
    },
    "authority_sources": {
      "type": "array", "minItems": 2,
      "items": {
        "type": "object",
        "required": ["authority_type", "source_ref", "run_id"],
        "properties": {
          "authority_type": {"enum": ["CI_CONTRACT", "RUNTIME_CONTRACT"]},
          "source_ref": {"type": "string", "minLength": 1},
          "run_id": {"const": "S26-CI-PREFLIGHT-V1"}
        },
        "additionalProperties": false
      }
    },
    "bindings": {
      "type": "array", "minItems": 2,
      "items": {
        "type": "object",
        "required": ["binding_id", "target_ref", "callable", "probe_mode", "run_id"],
        "properties": {
          "binding_id": {"enum": ["PROFILE_EXECUTION_VALIDATOR", "SEMANTIC_MANIFEST_VALIDATOR"]},
          "target_ref": {"type": "string", "minLength": 1},
          "callable": {"type": "string", "minLength": 1},
          "probe_mode": {"enum": ["RETURNS_NONEMPTY_ERROR_LIST", "RAISES_EXPECTED_ERROR"]},
          "expected_error": {"type": "string", "minLength": 1},
          "run_id": {"const": "S26-CI-PREFLIGHT-V1"}
        },
        "additionalProperties": false
      }
    },
    "inputs": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["input_id", "path", "run_id"],
        "properties": {
          "input_id": {"const": "CANONICAL_PREFLIGHT_MANIFEST"},
          "path": {"type": "string", "minLength": 1},
          "run_id": {"const": "S26-CI-PREFLIGHT-V1"}
        },
        "additionalProperties": false
      }
    },
    "workflow_guards": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["workflow_path", "job", "preflight_marker", "heavy_markers", "run_id"],
        "properties": {
          "workflow_path": {"type": "string", "minLength": 1},
          "job": {"type": "string", "minLength": 1},
          "preflight_marker": {"const": "S26 cheap deterministic preflight"},
          "heavy_markers": {
            "type": "array", "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "run_id": {"const": "S26-CI-PREFLIGHT-V1"}
        },
        "additionalProperties": false
      }
    },
    "integrity_pins": {
      "type": "array", "minItems": 11,
      "items": {
        "type": "object",
        "required": ["path", "git_blob_sha1", "run_id"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "git_blob_sha1": {"type": "string", "minLength": 40},
          "run_id": {"const": "S26-CI-PREFLIGHT-V1"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
