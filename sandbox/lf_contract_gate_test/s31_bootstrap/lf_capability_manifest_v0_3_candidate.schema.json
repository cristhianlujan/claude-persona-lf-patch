{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lf.local/s31/capability-manifest/v0.3-candidate",
  "title": "LF Capability Manifest v0.3 Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["capability_id", "capability_version", "capability_class", "owner", "lifecycle", "authority_contract", "input_contract", "output_contract", "dependencies", "compatibility", "execution_port", "adapter_bindings", "evidence_contract", "currentness_binding", "source_refs", "source_digests", "claim_ceiling"],
  "properties": {
    "capability_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,127}$"},
    "capability_version": {"type": "string", "minLength": 1},
    "capability_class": {"enum": ["GOVERNANCE", "DATA_ACCESS", "RESOLUTION", "CONTEXT", "EXECUTION", "EVIDENCE", "LEARNING", "WORK_PACKAGE", "ADAPTER"]},
    "owner": {"type": "string", "minLength": 2},
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_maturity_label", "runtime_activation", "promotion_authority", "self_certification_allowed", "canonical_vocabulary_status"],
      "properties": {
        "artifact_maturity_label": {"type": "string", "minLength": 2},
        "runtime_activation": {"type": "boolean"},
        "promotion_authority": {"type": "string", "minLength": 2},
        "self_certification_allowed": {"const": false},
        "canonical_vocabulary_status": {"const": "UNRESOLVED"}
      }
    },
    "authority_contract": {"type": "string", "minLength": 2},
    "input_contract": {"type": "string", "minLength": 2},
    "output_contract": {"type": "string", "minLength": 2},
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability_id", "version_constraint", "critical"],
        "properties": {
          "capability_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,127}$"},
          "version_constraint": {"type": "string", "minLength": 1},
          "critical": {"type": "boolean"}
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consumer_contracts", "boundary_adapters"],
      "properties": {
        "consumer_contracts": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "boundary_adapters": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "execution_port": {"type": ["string", "null"]},
    "adapter_bindings": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "evidence_contract": {"type": "string", "minLength": 2},
    "currentness_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "stale_action", "evidence_ref", "evidence_sha256", "resolver_id"],
      "properties": {
        "policy": {"type": "string", "minLength": 2},
        "stale_action": {"const": "FAIL_CLOSED"},
        "evidence_ref": {"type": "string", "minLength": 2},
        "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "resolver_id": {"const": "QUALITY_PACK_TRUSTED_REF_RESOLVER_V1"}
      }
    },
    "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}, "uniqueItems": true},
    "source_digests": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "uniqueItems": true},
    "claim_ceiling": {"enum": ["STRUCTURAL", "PROVENANCE", "SEMANTIC", "BEHAVIORAL"]}
  },
  "x_lf_lifecycle_policy": {
    "source": "canonical_capability_model_v0_2_candidate.schema.json",
    "canonical_vocabulary_status": "UNRESOLVED",
    "self_certification_forbidden": true,
    "artifact_maturity_does_not_imply_runtime_activation": true
  },
  "x_lf_registry_policy": {
    "repo_manifest_is_source_of_truth": true,
    "database_projection_is_not_authority": true,
    "registry_does_not_grant_execution_authority": true,
    "currentness_must_be_resolver_derived": true
  }
}
