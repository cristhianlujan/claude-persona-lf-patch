{
  "$schema":"http://json-schema.org/draft-07/schema#",
  "$id":"lf/s31/common-evidence-envelope/v0.1-candidate",
  "title":"LF Common Evidence Envelope v0.1 Candidate",
  "type":"object","additionalProperties":true,
  "required":["receipt_version","run_id","capability_or_gate_id","input","validation_or_transformation","output","execution_identity","environment","authority","provenance","evidence_level","claim_ceiling","repair_disposition"],
  "properties":{
    "receipt_version":{"type":"string","minLength":2},
    "run_id":{"type":"string","minLength":2},
    "capability_or_gate_id":{"type":"string","minLength":2},
    "input":{"type":"object","required":["exact","digest","source_refs"],"properties":{"exact":{},"digest":{"type":"string","minLength":8},"source_refs":{"type":"array","minItems":1,"items":{"type":"string"}}}},
    "validation_or_transformation":{"type":"string","minLength":2},
    "output":{"type":"object","required":["exact","digest","ref"],"properties":{"exact":{},"digest":{"type":"string","minLength":8},"ref":{"type":"string","minLength":2}}},
    "execution_identity":{"type":"object","required":["executed","execution_ref_kind"],"properties":{"executed":{"type":"boolean"},"execution_ref_kind":{"type":"string"},"executed_sha":{"type":["string","null"]},"execution_id":{"type":["string","null"]}}},
    "environment":{"enum":["SANDBOX","NON_PRODUCTION","PRODUCTION"]},
    "authority":{"type":"object","required":["source","currentness"],"properties":{"source":{"type":"string"},"currentness":{"enum":["CURRENT","STALE","UNKNOWN"]}}},
    "provenance":{"type":"object","required":["reconstructible"],"properties":{"reconstructible":{"type":"boolean"},"refs":{"type":"array","items":{"type":"string"}}}},
    "evidence_level":{"enum":["STRUCTURAL","PROVENANCE_EXECUTION","SEMANTIC","BEHAVIORAL"]},
    "claim_ceiling":{"type":"string","minLength":2},
    "first_bad_hop":{"type":["string","null"]},
    "repair_disposition":{"enum":["NONE","BOUNDED_REPAIR_ALLOWED","RETURN_TO_OWNER","BLOCKED"]}
  },
  "x_lf_invariants":["STRUCTURAL_NEVER_IMPLIES_BEHAVIORAL","PROVENANCE_NEVER_IMPLIES_SEMANTIC_CORRECTNESS","STALE_CURRENTNESS_CANNOT_SUPPORT_CURRENT_CLAIM","SELF_CERTIFICATION_DOES_NOT_RAISE_EVIDENCE_LEVEL"]
}
