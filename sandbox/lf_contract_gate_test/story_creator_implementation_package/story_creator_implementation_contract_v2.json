{
  "schema_version": "STORY_CREATOR_IMPLEMENTATION_CONTRACT_V2",
  "contract_state": "CURRENT",
  "owner_scope": "SUPER_ADMIN",
  "supersedes": [
    "STORY_IMPLEMENTATION_PACKAGE_V1_1_PILOT_SEMANTICS"
  ],
  "carrier_compatibility": {
