\set ON_ERROR_STOP on

\echo 'E10_T1_BEGIN'
begin;
set transaction read only, isolation level repeatable read;
set local search_path = pg_catalog;

\echo 'E10_T1_CORRELATION_BEFORE_SNAPSHOT'
\ir PR93_LOTE_E10_CORRELATION_READBACK.sql

\echo 'E10_T1_EXECUTION_CONTEXT_SNAPSHOT'
\ir PR93_LOTE_E8_EXECUTION_CONTEXT_READBACK.sql

\echo 'E10_T1_CORRELATION_BEFORE_PREFLIGHT'
\ir PR93_LOTE_E10_CORRELATION_READBACK.sql

\echo 'E10_T1_DEPENDENCY_PREFLIGHT'
\ir PR93_LOTE_E6_DEPENDENCY_PREFLIGHT.sql

\echo 'E10_T1_PRIMARY_25_VECTOR_READBACK'
\ir PR93_LOTE_C_EVIDENCE_READBACK.sql

\echo 'E10_T1_CORRELATION_BEFORE_ADDENDUM'
\ir PR93_LOTE_E10_CORRELATION_READBACK.sql

\echo 'E10_T1_FINAL_INTEGRITY_ADDENDUM'
\ir PR93_LOTE_E5_FINAL_INTEGRITY_READBACK.sql

rollback;
\echo 'E10_T1_ROLLBACK_COMPLETE'

\echo 'E10_T2_ADVERSARIAL_BATTERY_BEGIN'
\ir PR93_WRITER_V7_ADVERSARIAL_TESTS.sql
\echo 'E10_T2_ADVERSARIAL_BATTERY_COMPLETE'
