  "findings": [
    {
      "finding_id": "LC-F01",
      "class": "CREATE_REGISTER_EDGE_OUT_OF_BAND",
      "status": "CONFIRMED",
      "evidence_ids": [
        "EV-LC-004",
        "EV-LC-010"
      ],
      "github_evidence": [
        "supabase/migrations/20260917025332_lf_systemic_root_cause_profile_asset_binding_v1.sql@blob:1b77652d1ff8e74d345e74a95cbeee80adfedd27",
        "supabase/migrations/20260917025714_lf_systemic_root_cause_profile_state_alignment_v1.sql@blob:af33c2ef7fd2ff23a4127b67f960ceac0b4b0a48"
      ],
      "observation": "CREACION_PERFIL_LF has no explicit register/wire step. The SRCR profile asset was inserted later by a profile-specific migration hard-coded to this profile while preserving the creation execution id as provenance.",
      "impact": "Creation can PASS while operational registration/wiring is performed by an out-of-band artifact not represented as a creation lifecycle edge.",
      "phase": 1
    },
    {
      "finding_id": "LC-F02",
      "class": "PUBLISH_PROMOTE_EDGE_IMPLICIT",
      "status": "CONFIRMED",
      "evidence_ids": [
        "EV-LC-004",
        "EV-LC-006",
        "EV-LC-012"
      ],
      "observation": "ACTUALIZACION_PERFIL_LF moves directly from regression_after to post_merge_reconcile. The observed post_merge step contains merge_sha, but there is no governed merge/publish/promote step or profile router action between them.",
      "impact": "Promotion/merge is an implicit external event rather than an explicit governed lifecycle transition.",
      "phase": 1
    },
    {
      "finding_id": "LC-F03",
      "class": "NEXT_GATE_WITHOUT_OPERATIONAL_CONSUMER",
      "status": "CONFIRMED",
      "evidence_ids": [
        "EV-LC-007",
        "EV-LC-011",
        "EV-LC-015"
      ],
      "observation": "REFRESCO_RUNTIME_PERFIL_LF closes with post_refresh_next_gate=PROFILE_RUNTIME_CANARY_REQUIRED, but router/operation authority contains no PROFILE_RUNTIME_CANARY or PROFILE_RUNTIME_ACTIVATION action/operation.",
      "impact": "The lifecycle emits a mandatory next gate that has no governed operational consumer.",
      "phase": 1
    },
    {
      "finding_id": "LC-F04",
      "class": "DEPRECATE_ROLLBACK_NOT_OPERATIONAL",
      "status": "CONFIRMED",
      "evidence_ids": [
        "EV-LC-005",
        "EV-LC-006",
        "EV-LC-007"
      ],
      "observation": "The only retirement path is RETIRO_ACTIVO_LF and its router action RETIRE, both CANDIDATO_READ_ONLY. No dedicated profile rollback operation/action exists.",
      "impact": "Deprecation/retirement and rollback are not available as an operational end-to-end profile lifecycle.",
      "phase": 1
    },
    {
      "finding_id": "LC-F05",
      "class": "VERIFY_RUNTIME_TERMINALITY_INCONSISTENT",
      "status": "CONFIRMED_OBSERVATION",
      "evidence_ids": [
        "EV-LC-013",
        "EV-LC-014"
      ],
      "observation": "Recent SRCR executions show mixed terminal behavior: one latest run remains IN_PROGRESS after context_admission, another remains IN_PROGRESS after semantic_judge blocked, while a prior run completed the full chain.",
      "impact": "Terminality/recovery behavior must be reconciled before claiming lifecycle closure; this finding does not yet assign a single root cause.",
      "phase": 1
    },
    {
      "finding_id": "LC-F01",
      "class": "CREATE_REGISTER_EDGE_OUT_OF_BAND",
      "status": "CONFIRMED_STRENGTHENED",
      "evidence_ids": [
        "EV-LC-016",
        "EV-LC-017",
        "EV-LC-022"
      ],
      "observation": "The current profile creation Edge Function initializes/records the governed execution but contains no generic lf_activos registration write. Current database routines contain no function that inserts lf_activos, and lifecycle triggers do not materialize a profile asset. SRCR registration therefore remains outside the CREACION_PERFIL_LF execution edge.",
      "impact": "A creation execution can close while canonical operational registration is still a separate out-of-band act.",
      "phase": 2
    },
    {
      "finding_id": "LC-F02",
      "class": "PUBLISH_PROMOTE_EDGE_IMPLICIT",
      "status": "CONFIRMED_STRENGTHENED",
      "evidence_ids": [
        "EV-LC-024"
      ],
      "observation": "The post-merge reconcile function accepts an already-merged SHA/PR and reconciles it, but the governed update operation does not own or model the merge/publish transition itself. Repository search found no Edge/workflow caller for post_merge_reconcile; the actual transition is external and only reconciled afterward.",
      "impact": "The lifecycle lacks an explicit handoff state/receipt between pre-merge validation and post-merge reconciliation.",
      "phase": 2
    },
    {
      "finding_id": "LC-F03",
      "class": "NEXT_GATE_WITHOUT_OPERATIONAL_CONSUMER",
      "status": "CONFIRMED_STRENGTHENED",
      "evidence_ids": [
        "EV-LC-018",
        "EV-LC-025"
      ],
      "observation": "Database-wide function inspection found only producers/validators of PROFILE_RUNTIME_CANARY_REQUIRED and PROFILE_RUNTIME_ACTIVATION_REQUIRED. No operational consumer was found; router/operation registries also have no matching action/operation.",
      "impact": "The canonical chain can emit a mandatory next gate that cannot be entered through the governed lifecycle.",
      "phase": 2
    },
    {
      "finding_id": "LC-F04",
      "class": "DEPRECATE_ROLLBACK_NOT_OPERATIONAL",
      "status": "CONFIRMED_STRENGTHENED",
      "evidence_ids": [
        "EV-LC-021"
      ],
      "observation": "The only lifecycle removal entry is RETIRE -> RETIRO_ACTIVO_LF and it remains CANDIDATO_READ_ONLY / OP_CANDIDATE. No rollback, restore, recovery, reactivate or unretire operation/action exists.",
      "impact": "A full operational profile lifecycle cannot currently execute deprecate/rollback end to end.",
      "phase": 2
    },
    {
      "finding_id": "LC-F05",
      "class": "QUEUE_FAILURE_NOT_PROPAGATED_TO_CANONICAL_EXECUTION",
      "status": "ROOT_CAUSE_CONFIRMED",
      "evidence_ids": [
        "EV-LC-019",
        "EV-LC-020",
        "EV-LC-023"
      ],
      "observation": "Request 23839099 is terminal FAILED in private.lf_profile_runtime_queue_v1 with HETZNER_BASELINE_API_FAILED, while its canonical EJECUCION_PERFIL_LF execution remains IN_PROGRESS. Worker _persist_failure updates only the queue row. No database function bridges terminal queue failure to lf_operation_execution.",
      "impact": "Failed runtime attempts leak canonical executions in IN_PROGRESS, so lifecycle terminality and recovery/readback become inconsistent.",
      "phase": 2
    },
    {
      "finding_id": "LC-F06",
      "class": "EVIDENCE_MANIFEST_TRANSPORT_GAP",
      "status": "ROOT_CAUSE_CONFIRMED",
      "evidence_ids": [
        "EV-LC-026",
        "EV-LC-028",
        "EV-LC-031",
        "EV-LC-032"
      ],
      "observation": "SRCR validators explicitly accept evidence_manifest, but ProfileTask has no evidence_manifest field and the runtime gate calls validator(payload) and evaluator(payload, contract_gate) only.",
      "impact": "Externally resolved evidence is lost at the runtime boundary, causing false unresolved-evidence failures before semantic evaluation.",
      "phase": 3
    },
    {
      "finding_id": "LC-F07",
      "class": "CANONICAL_QUALITY_DECLARED_NOT_CONSUMED",
      "status": "ROOT_CAUSE_CONFIRMED",
      "evidence_ids": [
        "EV-LC-027",
        "EV-LC-030",
        "EV-LC-033"
      ],
      "observation": "The raw SRCR binding requires canonical quality for V0.5 and names judge/result/receipt validators. RuntimeProfileBinding does not parse canonical_quality and service runtime contains no quality receipt consumer.",
      "impact": "The authoritative quality contract is dead configuration in the operational service path.",
      "phase": 3
    },
    {
      "finding_id": "LC-F08",
      "class": "SEMANTIC_JUDGE_BOUND_WITHOUT_AUTOMATIC_EXECUTOR",
      "status": "ROOT_CAUSE_CONFIRMED",
      "evidence_ids": [
        "EV-LC-028",
        "EV-LC-034",
        "EV-LC-036"
      ],
      "observation": "Supabase has an ACTIVE_ENFORCEMENT semantic_judge step requiring semantic_judge_result and unsupported_claims, while the worker returns READY_FOR_SEMANTIC_JUDGE with semantic_judge_auto_recorded=false and the runtime service reports independent_semantic_judge=NOT_EXECUTED.",
      "impact": "The governed execution can reach the independent-quality boundary but cannot cross it automatically.",
      "phase": 3
    },
    {
      "finding_id": "LC-F09",
      "class": "CANONICAL_QUALITY_RECEIPT_UNMATERIALIZED",
      "status": "CONFIRMED_CONSEQUENCE",
      "evidence_ids": [
        "EV-LC-033",
        "EV-LC-035"
      ],
      "observation": "A canonical quality receipt validator exists, but zero SRCR rows were found under the exact semantic/quality receipt types queried.",
      "impact": "No durable canonical-quality readback currently closes the V0.5 path.",
      "phase": 3
    },
    {
      "finding_id": "LC-F10",
      "class": "DOWNSTREAM_AUTHORIZATION_HAS_NO_TRUE_PATH",
      "status": "CONFIRMED_CONSEQUENCE",
      "evidence_ids": [
        "EV-LC-028",
        "EV-LC-029",
        "EV-LC-030"
      ],
      "observation": "The runtime service returns downstream_authorized=false throughout and never consumes canonical_quality to derive a true state.",
      "impact": "Even a hypothetical clean producer output cannot become downstream-authorized through the current service path.",
      "phase": 3
    },
    {
      "finding_id": "LC-F11",
      "class": "PACK_SELF_VALIDATOR_SCHEMA_CONDITIONALITY_DRIFT",
      "status": "ROOT_CAUSE_CONFIRMED",
      "evidence_ids": [
        "EV-LC-037",
        "EV-LC-038",
        "EV-LC-039"
      ],
      "observation": "output.schema.json explicitly exempts V0.5 ARCHITECTURE_AUDIT from the incident-oriented repair package via a nested if.allOf/not condition. validate_pack.py only recognizes flat if.properties.status.enum branches when deriving conditionally required repair fields, then fails with SCHEMA_REQUIRED_KEY_MISSING:alternatives.",
      "impact": "The pack's own validator rejects a schema contract that the same V0.5 source intentionally defines, blocking full-deep validation independently of candidate quality.",
      "phase": 4
    },
    {
      "finding_id": "LC-F12",
      "class": "NEW_BRANCH_PUSH_ZERO_BASE_SHA_NOT_NORMALIZED",
      "status": "ROOT_CAUSE_CONFIRMED",
      "evidence_ids": [
        "EV-LC-040",
        "EV-LC-041",
        "EV-LC-042",
        "EV-LC-043"
      ],
      "observation": "On the first push that creates a branch, github.event.before is 40 zeroes. Validate LF Packs fetches any non-empty base and lf-contract-check requires/fetches any non-empty exact_base, so both attempt git fetch of 000...000 and fail before material validation. A separate bootstrap workflow already guards this zero sentinel, proving a repository-local handling pattern exists.",
      "impact": "Initial branch pushes can report red checks for CI transport/currentness mechanics before the candidate is evaluated; this can mask the first substantive failure.",
      "phase": 4
    }
  ]
