{
  "$id": "https://lf.local/s38/runtime-execution-output/v0.2-candidate",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "failure_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "raw_output": {},
    "resource_usage": {
      "type": "object"
    },
    "runtime_receipt": {
      "additionalProperties": false,
      "properties": {
        "authority_effects": {
          "maxItems": 0,
          "type": "array"
        },
        "authority_grants_allowed": {
          "const": false
        },
        "downstream_authorized": {
          "const": false
        },
        "executor_id": {
          "minLength": 2,
          "type": "string"
        },
        "golden_authorized": {
          "const": false
        },
        "production_authorized": {
          "const": false
        },
        "receipt_ref": {
          "minLength": 2,
          "type": "string"
        },
        "receipt_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "run_id": {
          "minLength": 2,
          "type": "string"
        },
        "status": {
          "enum": [
            "PASS",
            "FAILED",
            "BLOCKED"
          ]
        }
      },
      "required": [
        "run_id",
        "executor_id",
        "status",
        "receipt_ref",
        "receipt_sha256",
        "authority_grants_allowed",
        "downstream_authorized",
        "golden_authorized",
        "production_authorized",
        "authority_effects"
      ],
      "type": "object"
    },
    "transport_diagnostics": {
      "type": "object"
    }
  },
  "required": [
    "raw_output",
    "runtime_receipt",
    "transport_diagnostics",
    "resource_usage",
    "failure_code"
  ],
  "title": "LF Runtime Execution Output v0.2 Candidate",
  "type": "object",
  "x_lf_authority_boundary": {
    "nested_runtime_receipt_authority_grants_forbidden": true,
    "raw_output_is_not_interpreted_as_control_plane_authority": true,
    "runtime_output_grants_authority": false
  }
}
