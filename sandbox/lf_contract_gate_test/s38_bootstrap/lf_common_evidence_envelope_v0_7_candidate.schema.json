{
  "$defs": {
    "evidence_binding": {
      "additionalProperties": false,
      "properties": {
        "ref": {
          "minLength": 2,
          "type": "string"
        },
        "resolver_id": {
          "enum": [
            "QUALITY_PACK_TRUSTED_REF_RESOLVER_V1",
            "S38_GOVERNED_REF_RESOLVER_V2",
            "S38_GOVERNED_REF_RESOLVER_V4"
          ]
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "ref",
        "sha256",
        "resolver_id"
      ],
      "type": "object"
    },
    "owner_receipt_binding": {
      "additionalProperties": false,
      "properties": {
        "owner_capability_id": {
          "minLength": 2,
          "type": "string"
        },
        "preserved_without_rewrite": {
          "const": true
        },
        "ref": {
          "minLength": 2,
          "type": "string"
        },
        "resolver_id": {
          "enum": [
            "QUALITY_PACK_TRUSTED_REF_RESOLVER_V1",
            "S38_GOVERNED_REF_RESOLVER_V2",
            "S38_GOVERNED_REF_RESOLVER_V4"
          ]
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "ref",
        "sha256",
        "resolver_id",
        "owner_capability_id",
        "preserved_without_rewrite"
      ],
      "type": "object"
    }
  },
  "$id": "https://lf.local/s38/common-evidence-envelope/v0.7-candidate",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "evidence_level": {
            "const": "STRUCTURAL"
          }
        },
        "required": [
          "evidence_level"
        ]
      },
      "then": {
        "properties": {
          "claim_ceiling": {
            "const": "STRUCTURAL"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidence_level": {
            "enum": [
              "PROVENANCE_EXECUTION",
              "SEMANTIC",
              "BEHAVIORAL"
            ]
          }
        },
        "required": [
          "evidence_level"
        ]
      },
      "then": {
        "properties": {
          "authority": {
            "properties": {
              "currentness": {
                "const": "CURRENT"
              }
            }
          },
          "execution_identity": {
            "properties": {
              "executed": {
                "const": true
              }
            },
            "required": [
              "executed_sha",
              "execution_id"
            ]
          },
          "provenance": {
            "properties": {
              "reconstructible": {
                "const": true
              }
            }
          },
          "resolved_evidence": {
            "required": [
              "execution_receipt",
              "authority_currentness_receipt",
              "provenance_receipt"
            ]
          }
        },
        "required": [
          "resolved_evidence"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "evidence_level": {
            "const": "PROVENANCE_EXECUTION"
          }
        },
        "required": [
          "evidence_level"
        ]
      },
      "then": {
        "properties": {
          "claim_ceiling": {
            "enum": [
              "STRUCTURAL",
              "PROVENANCE_EXECUTION"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidence_level": {
            "const": "SEMANTIC"
          }
        },
        "required": [
          "evidence_level"
        ]
      },
      "then": {
        "properties": {
          "claim_ceiling": {
            "enum": [
              "STRUCTURAL",
              "PROVENANCE_EXECUTION",
              "SEMANTIC"
            ]
          }
        }
      }
    }
  ],
  "properties": {
    "authority": {
      "additionalProperties": false,
      "properties": {
        "currentness": {
          "enum": [
            "CURRENT",
            "STALE",
            "UNKNOWN"
          ]
        },
        "source": {
          "minLength": 2,
          "type": "string"
        },
        "source_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "source_ref": {
          "minLength": 2,
          "type": "string"
        },
        "source_revision": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        }
      },
      "required": [
        "source",
        "source_ref",
        "source_digest",
        "source_revision",
        "currentness"
      ],
      "type": "object"
    },
    "capability_or_gate_id": {
      "minLength": 2,
      "type": "string"
    },
    "claim_ceiling": {
      "enum": [
        "STRUCTURAL",
        "PROVENANCE_EXECUTION",
        "SEMANTIC",
        "BEHAVIORAL"
      ]
    },
    "environment": {
      "enum": [
        "SANDBOX",
        "NON_PRODUCTION",
        "PRODUCTION"
      ]
    },
    "evidence_level": {
      "enum": [
        "STRUCTURAL",
        "PROVENANCE_EXECUTION",
        "SEMANTIC",
        "BEHAVIORAL"
      ]
    },
    "execution_identity": {
      "additionalProperties": false,
      "properties": {
        "executed": {
          "type": "boolean"
        },
        "executed_sha": {
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
          "type": [
            "string",
            "null"
          ]
        },
        "execution_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "execution_ref_kind": {
          "minLength": 2,
          "type": "string"
        }
      },
      "required": [
        "executed",
        "execution_ref_kind"
      ],
      "type": "object"
    },
    "extensions": {
      "additionalProperties": true,
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_.:-]+$"
      },
      "type": "object"
    },
    "first_bad_hop": {
      "type": [
        "string",
        "null"
      ]
    },
    "input": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "exact": {},
        "source_digests": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "source_refs": {
          "items": {
            "minLength": 2,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "exact",
        "digest",
        "source_refs",
        "source_digests"
      ],
      "type": "object"
    },
    "output": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "exact": {},
        "ref": {
          "minLength": 2,
          "type": "string"
        }
      },
      "required": [
        "exact",
        "digest",
        "ref"
      ],
      "type": "object"
    },
    "owner_receipt": {
      "$ref": "#/$defs/owner_receipt_binding"
    },
    "producer_id": {
      "minLength": 2,
      "type": "string"
    },
    "provenance": {
      "additionalProperties": false,
      "properties": {
        "digests": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "reconstructible": {
          "type": "boolean"
        },
        "refs": {
          "items": {
            "minLength": 2,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "reconstructible",
        "refs",
        "digests"
      ],
      "type": "object"
    },
    "receipt_version": {
      "minLength": 2,
      "type": "string"
    },
    "repair_disposition": {
      "enum": [
        "NONE",
        "BOUNDED_REPAIR_ALLOWED",
        "RETURN_TO_OWNER",
        "BLOCKED"
      ]
    },
    "resolved_evidence": {
      "additionalProperties": false,
      "properties": {
        "authority_currentness_receipt": {
          "$ref": "#/$defs/evidence_binding"
        },
        "execution_receipt": {
          "$ref": "#/$defs/evidence_binding"
        },
        "provenance_receipt": {
          "$ref": "#/$defs/evidence_binding"
        }
      },
      "type": "object"
    },
    "run_id": {
      "minLength": 2,
      "type": "string"
    },
    "validation_or_transformation": {
      "minLength": 2,
      "type": "string"
    }
  },
  "required": [
    "receipt_version",
    "run_id",
    "producer_id",
    "capability_or_gate_id",
    "input",
    "validation_or_transformation",
    "output",
    "execution_identity",
    "environment",
    "authority",
    "provenance",
    "owner_receipt",
    "extensions",
    "evidence_level",
    "claim_ceiling",
    "repair_disposition"
  ],
  "title": "LF Common Evidence Envelope v0.7 Candidate",
  "type": "object",
  "x_lf_invariants": [
    "CLAIM_CEILING_MUST_NOT_EXCEED_EVIDENCE_LEVEL",
    "NON_STRUCTURAL_EVIDENCE_REQUIRES_INDEPENDENTLY_RESOLVED_EXECUTION_CURRENTNESS_AND_PROVENANCE",
    "ALL_DIGEST_BINDINGS_ARE_SHA256",
    "OWNER_RECEIPT_PRESERVED_WITHOUT_REWRITE",
    "CAPABILITY_SPECIFIC_EXTENSIONS_HAVE_EXPLICIT_CARRIER",
    "STRUCTURAL_NEVER_IMPLIES_BEHAVIORAL",
    "PROVENANCE_NEVER_IMPLIES_SEMANTIC_CORRECTNESS",
    "SELF_CERTIFICATION_DOES_NOT_RAISE_EVIDENCE_LEVEL",
    "ALL_NONSTRUCTURAL_RECEIPTS_SHARE_RUN_CAPABILITY_EXECUTION_INPUT_OUTPUT_AND_AUTHORITY_IDENTITY",
    "AUTHORITY_AND_PROVENANCE_SOURCE_BYTES_ARE_RESOLVER_DERIVED",
    "REPLAYED_RECEIPTS_FROM_OTHER_RUNS_OR_PAYLOADS_FAIL_CLOSED",
    "CLAIM_TIER_IS_RESOLVER_BOUND_AND_INCLUDED_IN_COMMON_SEMANTIC_IDENTITY",
    "TRUSTED_RESOLUTION_BYTES_COME_FROM_CANONICAL_REMOTE_NOT_CALLER_ROOT",
    "CLAIM_TIER_MUST_NOT_EXCEED_POLICY_DERIVED_EARNED_TIER",
    "SEMANTIC_AND_BEHAVIORAL_TIERS_REQUIRE_ALLOWLISTED_INDEPENDENT_WITNESS",
    "ARCHIVAL_CURRENTNESS_IS_LOGICAL_ASSET_BASED_AND_PATH_MOVEMENT_TOLERANT",
    "THIS_SCHEMA_IS_EXECUTED_BY_VALIDATE_S38_DG_CONTRACTS_V0_5"
  ]
}
